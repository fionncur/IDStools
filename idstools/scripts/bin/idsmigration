from typing import Any
import ast
import re
import logging
import imas
import pandas as pd
import numpy as np
import os

EXPERIMENT_FOLDER = "2008"
DATASET_NAME = "2008_data.csv"
MAPPING_NAME = "2008_crosswalk.xlsx"

logging.getLogger("imas").setLevel(logging.WARNING) # Avoid IMAS errors for type mismatches.

HERE = os.path.dirname(os.path.abspath(__file__))           # .../idstools/scripts/bin
ROOT = os.path.dirname(os.path.dirname(os.path.dirname(HERE)))  # .../IDStools
mappings_dir = os.path.join(ROOT, "resources", "mappings")
input_dir = os.path.join(ROOT, "resources", "input")
output_dir = os.path.join(ROOT, "resources", "results", EXPERIMENT_FOLDER)

# Parses node segments, for fixed AoS indexing or placeholder (wildcard) indexes.
def parse_seg(seg: str) -> tuple[str, int]:
    m = re.fullmatch(r"(\w+)\((\d+)\)", seg) # Explicit index, like divertors.divertor(3)
    if m:
        return m.group(1), int(m.group(2)) 
    m = re.fullmatch(r"(\w+)\(:\)", seg) # Variable/wildcard index, like divertors.divertor(:).
    if m:
        return m.group(1), 0
    return seg, 0

# Replaces wildcard index segments in a branch with a concrete index idx.
def replace_wildcard_index(branch: list[str], idx: int) -> list[str]:
    return [f"{seg[:-3]}({idx})" if seg.endswith("(:)") else seg for seg in branch]

# Take IDS object and list of node segments (as strings), return parent IDS object and the final branch node.
def resolve_parent(ids, branch: list[str]) -> tuple[Any, str]:
    node = ids
    for seg in branch[:-1]:
        attr, idx = parse_seg(seg)
        node = getattr(node, attr)
        if isinstance(node, imas.ids_struct_array.IDSStructArray):
            if len(node) <= idx:
                node.resize(idx + 1, keep=True)
            node = node[idx]
    return node, branch[-1]

def set_leaf(ids, branch: list[str], value: Any) -> None:
    parent, leaf_seg = resolve_parent(ids, branch)
    leaf, _ = parse_seg(leaf_seg)
    target = getattr(parent, leaf)

    if isinstance(target, imas.ids_struct_array.IDSStructArray):
        if len(target) == 0:
            target.resize(1)
        target[0] = value
    elif isinstance(target, imas.ids_primitive.IDSNumericArray):
        setattr(parent, leaf, np.atleast_1d(value))
    else:
        setattr(parent, leaf, value)

def apply_transform(ids, ids_branch: list[str], value: Any, row_i) -> None:
    if row_i["transform"] == "identity":
        set_leaf(ids, ids_branch, value)
        if row_i["needs_source"] == True:
            set_leaf(ids, ids_branch[:-1] + ["source"], row_i["source"])
        if ids_branch[-1] == "index" and isinstance(row_i["source"], str):
            set_leaf(ids, ids_branch[:-1] + ["description"], row_i["source"])
    elif row_i["transform"] == "dictionary":
        if not isinstance(row_i["transform_args"], str):
            raise ValueError(f"Row {row_i.name}: transform='dictionary' but transform_args is missing")
        dictionary = ast.literal_eval(row_i["transform_args"])
        if value not in dictionary:
            print(f"WARNING: Row {row_i.name}: value {value!r} from column '{row_i['csv_column']}' not in dictionary — skipping")
            return
        value = dictionary[value]
        if isinstance(value, list): # Dictionary of lists feature, resize AoS to fit len(value).
            for i, v in enumerate(value):
                resolved = replace_wildcard_index(ids_branch, i)
                set_leaf(ids, resolved, v)
                if resolved[-1] == "index" and isinstance(row_i["source"], str):
                    set_leaf(ids, resolved[:-1] + ["description"], row_i["source"])
        else:
            resolved = replace_wildcard_index(ids_branch, 0)
            set_leaf(ids, resolved, value)
            if resolved[-1] == "index" and isinstance(row_i["source"], str):
                set_leaf(ids, resolved[:-1] + ["description"], row_i["source"])
    elif row_i["transform"] == "formula":
        if not isinstance(row_i["transform_args"], str):
            raise ValueError(f"Row {row_i.name}: transform='formula' but transform_args is missing")
        value = eval(row_i["transform_args"], {"x": value})
        set_leaf(ids, ids_branch, value)
        if ids_branch[-1] == "index" and isinstance(row_i["source"], str):
            set_leaf(ids, ids_branch[:-1] + ["description"], row_i["source"])
    else:
        raise ValueError(f"Row {row_i.name}: unhandled transform '{row_i['transform']}'")


# Define paths for data and mapping files.
data_path = os.path.join(input_dir, DATASET_NAME)
mapping_path = os.path.join(mappings_dir, MAPPING_NAME)

# Take crosswalk xlsx into dataframe.
df = pd.read_excel(mapping_path)   

# Convert needs_source to boolean.
df['needs_source'] = df['needs_source'].fillna(False).astype(bool)

# For testing, include only implemented transforms.
sentence = ((df["transform"] == "identity") | (df["transform"] == "dictionary"))  &\
              ((df["status"] == "mapped") | (df["status"] == "temporary") \
               | (df["status"] == "mapped_caveat")) 
df = df[sentence]

# Import experimental data from csv. Data cleaning
data = pd.read_csv(data_path, na_values=["-"])
data = data.map(lambda x: x.strip() if isinstance(x, str) else x) # Strip whitespace. Important for CMOD, but very data/machine specific. Remove in later version.

# Upfront validation: all csv_columns must exist in data.
missing_cols = set(df["csv_column"]) - set(data.columns)
if missing_cols:
    raise ValueError(f"csv_column(s) not found in data CSV: {missing_cols}")

# Upfront validation: needs_source rows must have a source string.
bad_source = df["needs_source"] & ~df["source"].apply(lambda x: isinstance(x, str))
if bad_source.any():
    print(f"WARNING: needs_source=True but source is missing for rows: {list(df.index[bad_source])} — falling back to csv_description")
    df["source"] = df["source"].astype(object)
    df.loc[bad_source, "source"] = df.loc[bad_source, "csv_description"].where(
        df.loc[bad_source, "csv_description"].apply(lambda x: isinstance(x, str)), other=""
    )

# Create factory object, set DD version.
factory = imas.IDSFactory(version = "4.1.1")

IDS_dict = {}

# Loop over data rows.
for index_d, row_d in data.iterrows():

    if row_d.isna().all():
        continue

    pulse_ids = {}
    temp_counters = {}  # {bucket_base_name: next_index} for wildcard (:) resolution

    for index_i, row_i in df.iterrows():
        
        if row_i["status"] == "temporary":
            value = row_d[row_i["csv_column"]] # Data associated with variable name
            if pd.isna(value):
                continue
            bucket_raw = row_i["csv_dtype"]
            # For variable indexing of the AoS for each temporary/datatype(:)
            bucket_base, _ = parse_seg(bucket_raw)
            if "(:)" in bucket_raw:
                idx = temp_counters.get(bucket_base, 0)
                temp_counters[bucket_base] = idx + 1
                resolved = f"{bucket_base}({idx})"
            else:
                resolved = bucket_raw
            if "temporary" not in pulse_ids:
                tmp = factory.new("temporary")
                tmp.ids_properties.homogeneous_time = imas.ids_defs.IDS_TIME_MODE_HOMOGENEOUS
                pulse_ids["temporary"] = tmp
            ids = pulse_ids["temporary"]
            if "(" not in bucket_raw and len(getattr(ids, bucket_base)) > 0:
                print(f"WARNING: Row {row_i.name} ('{row_i['csv_column']}'): overwriting slot 0 of '{bucket_base}' in temporary IDS — use (:) in csv_dtype for append behaviour")
            apply_transform(ids, [resolved, "value"], value, row_i)
            set_leaf(ids, [resolved, "identifier", "name"], row_i["csv_column"])
            if isinstance(row_i["csv_description"], str):
                set_leaf(ids, [resolved, "identifier", "description"], row_i["csv_description"])
            continue

        imas_path = row_i["imas_path"]
        if not isinstance(imas_path, str):
            raise ValueError(f"Row {index_i}: imas_path is missing")
        imas_paths = [imas_path]  # Start with the original path

        if "&" in imas_path:
            imas_paths = imas_path.split("&")  # Take the first path if multiple are concatenated with "&"

        for imas_path in imas_paths:
 
            ids_root = imas_path.split("/")[0]
            if row_i["needs_source"] == True:
                imas_path += "/value"  # Append "/value" to the IDS name if needs_source is True
            ids_branch = imas_path.split("/")[1:]
 
            # Generate the top-level IDS if it doesn't exist *for this pulse*.
            if ids_root not in pulse_ids:
                ids_new = factory.new(ids_root)
                ids_new.ids_properties.homogeneous_time = imas.ids_defs.IDS_TIME_MODE_HOMOGENEOUS
                pulse_ids[ids_root] = ids_new
            
            ids = pulse_ids[ids_root]
 
            # row_i["csv_column"] names the column in `data`; row_d reads it.
            value = row_d[row_i["csv_column"]]
            if pd.isna(value):
                continue
            apply_transform(ids, ids_branch, value, row_i)

    IDS_dict[index_d] = pulse_ids

# Write IDSs to disk.
print("Writing...")
os.makedirs(output_dir, exist_ok=True)
written = 0
for pulse, pulse_ids in IDS_dict.items():
    summary = pulse_ids.get("summary")
    try:
        tag_name = summary.tag.name.strip()
    except AttributeError:
        tag_name = None
    if tag_name != "SELEC2007=True":
        continue

    pulse_dir = os.path.join(output_dir, f"pulse_{pulse:04d}")
    os.makedirs(pulse_dir, exist_ok=True)
    uri = f"imas:hdf5?path={pulse_dir};pulse=0"
    if pulse % 100 == 0:
        print("Progress: "+str(pulse)+"/"+str(len(IDS_dict)))
    with imas.DBEntry(uri, "a") as entry:
        for ids in pulse_ids.values():
            entry.put(ids)
    written += 1

print(f"Wrote {written}/{len(IDS_dict)} pulses to {output_dir}")


