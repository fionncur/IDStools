#!/usr/bin/env python3
# -*- coding: utf-8 -*-

from typing import Any
import argparse
import ast
import re
import logging
import time
from datetime import timedelta
import imas
import pandas as pd
import numpy as np
import os

from rich_argparse import RichHelpFormatter

logging.getLogger("imas").setLevel(logging.WARNING) # Avoid IMAS errors for type mismatches.

HERE = os.path.dirname(os.path.abspath(__file__))           # .../idstools/scripts/bin
ROOT = os.path.dirname(os.path.dirname(os.path.dirname(HERE)))  # .../IDStools
mappings_dir = os.path.join(ROOT, "resources", "mappings")
input_dir = os.path.join(ROOT, "resources", "input")

# Parses node segments, for fixed AoS indexing or placeholder (wildcard) indexes.
def parse_seg(seg: str) -> tuple[str, int]:
    m = re.fullmatch(r"(\w+)\((\d+)\)", seg) # Explicit index, like divertors.divertor(3)
    if m:
        return m.group(1), int(m.group(2)) 
    m = re.fullmatch(r"(\w+)\(:\)", seg) # Variable/wildcard index, like divertors.divertor(:).
    if m:
        return m.group(1), 0
    return seg, 0

# Replaces wildcard index segments in a branch with a concrete index idx.
def replace_wildcard_index(branch: list[str], idx: int) -> list[str]:
    return [f"{seg[:-3]}({idx})" if seg.endswith("(:)") else seg for seg in branch]

# Parse a source_fields cell into a (value_leaf, source_leaf) pair.
# Blank / NaN -> ("value", "source"), the historical default.
def parse_source_pair(source_fields_val: Any, csv_column: str) -> tuple[str, str]:
    if not isinstance(source_fields_val, str) or source_fields_val.strip() == "":
        return ("value", "source")
    try:
        parsed = ast.literal_eval(source_fields_val.strip())
    except (ValueError, SyntaxError) as e:
        raise ValueError(
            f"source_fields {source_fields_val!r} for csv_column "
            f"'{csv_column}' is not a valid Python literal: {e}"
        )
    if (not isinstance(parsed, tuple) or len(parsed) != 2
            or not all(isinstance(p, str) for p in parsed)):
        raise ValueError(
            f"source_fields for csv_column '{csv_column}' must be a 2-tuple of "
            f"strings, e.g. ('name', 'description'); got {parsed!r}"
        )
    return parsed

# Take IDS object and list of node segments (as strings), return parent IDS object and the final branch node.
def resolve_parent(ids, branch: list[str]) -> tuple[Any, str]:
    node = ids
    for seg in branch[:-1]:
        attr, idx = parse_seg(seg)
        node = getattr(node, attr)
        if isinstance(node, imas.ids_struct_array.IDSStructArray):
            if len(node) <= idx:
                node.resize(idx + 1, keep=True)
            node = node[idx]
    return node, branch[-1]

def set_leaf(ids, branch: list[str], value: Any) -> None:
    parent, leaf_seg = resolve_parent(ids, branch)
    leaf, _ = parse_seg(leaf_seg)
    target = getattr(parent, leaf)

    if isinstance(target, imas.ids_struct_array.IDSStructArray):
        if len(target) == 0:
            target.resize(1)
        target[0] = value
    elif isinstance(target, imas.ids_primitive.IDSNumericArray):
        setattr(parent, leaf, np.atleast_1d(value))
    else:
        setattr(parent, leaf, value)

# Compute the (branch, value) writes a transform produces. Returns [] to skip the row (e.g. dictionary miss).
def resolve_writes(ids_branch: list[str], value: Any, row_i) -> list[tuple[list[str], Any]]:
    t = row_i["transform"]
    if t == "identity":
        return [(ids_branch, value)]
    if t == "dictionary":
        if not isinstance(row_i["transform_args"], str):
            raise ValueError(f"Row {row_i.name}: transform='dictionary' but transform_args is missing")
        dictionary = ast.literal_eval(row_i["transform_args"])
        if value not in dictionary:
            print(f"WARNING: Row {row_i.name}: value {value!r} from column '{row_i['csv_column']}' not in dictionary — skipping")
            return []
        mapped = dictionary[value]
        if isinstance(mapped, list):  # Dictionary of lists feature, expand AoS to fit len(mapped).
            return [(replace_wildcard_index(ids_branch, i), v) for i, v in enumerate(mapped)]
        return [(replace_wildcard_index(ids_branch, 0), mapped)]
    if t == "formula":
        if not isinstance(row_i["transform_args"], str):
            raise ValueError(f"Row {row_i.name}: transform='formula' but transform_args is missing")
        return [(ids_branch, eval(row_i["transform_args"], {"x": value}))]
    raise ValueError(f"Row {row_i.name}: unhandled transform '{row_i['transform']}'")

# Write resolved (branch, value) pairs to their leaves in the pulse `ids`.
def write_values(ids, writes) -> None:
    for branch, value in writes:
        set_leaf(ids, branch, value)


# Write each descriptor (leaf_segments, string) — e.g. the source sibling, or a
# temporary row's identifier name/description — into the shared reference IDS, at
# the sibling of every value's parent node (branch[:-1]), so it lands at the
# correct path for each expanded AoS slot. The constant string is re-written on
# every pulse (idempotent), so no dedup state is needed.
def write_descriptors(reference, writes, descriptors) -> None:
    for branch, _ in writes:
        for desc_leaf, desc_str in descriptors:
            set_leaf(reference, branch[:-1] + list(desc_leaf), desc_str)


# Create a fresh top-level IDS with homogeneous time mode set.
def new_ids(factory, name: str):
    ids = factory.new(name)
    ids.ids_properties.homogeneous_time = imas.ids_defs.IDS_TIME_MODE_HOMOGENEOUS
    return ids


# Backfill an empty root `time` (NaN time column) so dynamic nodes fit in arrays.
def backfill_time(ids) -> None:
    if (ids.ids_properties.homogeneous_time == imas.ids_defs.IDS_TIME_MODE_HOMOGENEOUS
            and len(ids.time) == 0):
        ids.time = np.array([0.0])


# Timed, counted progress for the long pulse loops (build-in-memory and write-to-disk).
def report_progress(count: int, total: int, label: Any, start: float,
                    last_report: float, interval: float = 5.0) -> float:
    now = time.monotonic()
    if now - last_report < interval:
        return last_report
    elapsed = now - start
    rate = count / elapsed if elapsed > 0 else 0
    eta = (total - count) / rate if rate > 0 else 0
    pct = 100 * count / total
    print(
        f"Progress: {count:{len(str(total))}d}/{total} ({pct:3.1f}%)  pulse {label}  "
        f"elapsed {timedelta(seconds=int(elapsed))}  "
        f"ETA {timedelta(seconds=int(eta))}  "
        f"({rate:.1f} pulses/s)"
    )
    return now

# Closing one-line summary for a pulse loop.
def report_summary(verb: str, count: int, total: int, start: float, suffix: str = "") -> None:
    print(
        f"{verb} {count}/{total} pulses{suffix} "
        f"in {timedelta(seconds=int(time.monotonic() - start))}"
    )


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Convert tabular experimental data (CSV) into IMAS IDS objects via a crosswalk spreadsheet",
        formatter_class=RichHelpFormatter,
    )
    parser.add_argument(
        "-e",
        "--experiment",
        type=str,
        default="2008",
        help="Sub-folder under resources/results/ for output \t(default=%(default)s)",
    )
    parser.add_argument(
        "-d",
        "--dataset",
        type=str,
        default="2008_data.csv",
        help="Input CSV filename under resources/input/ \t(default=%(default)s)",
    )
    parser.add_argument(
        "-m",
        "--mapping",
        type=str,
        default="2008_crosswalk.xlsx",
        help="Crosswalk spreadsheet filename under resources/mappings/ \t(default=%(default)s)",
    )
    parser.add_argument(
        "--dd-version",
        type=str,
        default="4.1.1",
        help="Data Dictionary version used to build the IDS factory \t(default=%(default)s)",
    )
    args = parser.parse_args()

    output_dir = os.path.join(ROOT, "resources", "results", args.experiment)

    # Define paths for data and mapping files.
    data_path = os.path.join(input_dir, args.dataset)
    mapping_path = os.path.join(mappings_dir, args.mapping)

    # Take crosswalk xlsx into dataframe.
    df = pd.read_excel(mapping_path)

    # Convert needs_source to boolean.
    df['needs_source'] = df['needs_source'].fillna(False).astype(bool)

    # Include only implemented transforms (identity/dictionary) with an accepted status.
    sentence = (
        df["transform"].isin(["identity", "dictionary"])
        & df["status"].isin(["mapped", "temporary", "mapped_caveat"])
    )
    df = df[sentence]

    # Parse the optional source_fields column into (value_leaf, source_leaf) pairs.
    # Blank/NaN or non-needs_source rows -> ("value", "source").
    if "source_fields" in df.columns:
        pairs = [
            parse_source_pair(sf, col) if ns else ("value", "source")
            for sf, col, ns in zip(df["source_fields"], df["csv_column"], df["needs_source"])
        ]
    else:
        pairs = [("value", "source")] * len(df)
    df["_source_pair"] = pd.Series(pairs, index=df.index, dtype=object)

    # Import experimental data from csv. Data cleaning
    data = pd.read_csv(data_path, na_values=["-", "????????", "??????????", "********"])
    data = data.map(lambda x: (x.strip() or np.nan) if isinstance(x, str) else x) # Important for CMOD, but very data/machine specific. Remove in later version.

    # Upfront validation: all csv_columns must exist in data.
    missing_cols = set(df["csv_column"]) - set(data.columns)
    if missing_cols:
        raise ValueError(f"csv_column(s) not found in data CSV: {missing_cols}")

    # Upfront validation: needs_source rows must have a source string.
    bad_source = df["needs_source"] & ~df["source"].apply(lambda x: isinstance(x, str))
    if bad_source.any():
        print(f"WARNING: needs_source=True but source is missing for rows: {list(df.index[bad_source])} — falling back to csv_description")
        df["source"] = df["source"].astype(object)
        df.loc[bad_source, "source"] = df.loc[bad_source, "csv_description"].where(
            df.loc[bad_source, "csv_description"].apply(lambda x: isinstance(x, str)), other=""
        )

    # Upfront validation: temporary rows must have a csv_dtype string.
    is_temp = df["status"] == "temporary"
    bad_dtype = is_temp & ~df["csv_dtype"].apply(lambda x: isinstance(x, str) and x.strip() != "")
    if bad_dtype.any():
        print(f"WARNING: status 'temporary' but csv_dtype is missing for rows: {list(df.index[bad_dtype])} — skipping")

    # Create factory object, set DD version.
    factory = imas.IDSFactory(version=args.dd_version)

    # Build a per-row write spec used by the main loop:
    #   _paths       : imas_path(s) to write to ("&"-split for multi-target rows)
    #   _value_leaf  : leaf appended to each path for the value ("" = bare node)
    #   _descriptors : list of (leaf_segments, string) written once to the reference
    # Temporary rows are folded into the same structure with a "persistent" AoS index,
    # assigned here in crosswalk order so a variable keeps the same slot in every
    # pulse, which is required for temporary indices to match the reference IDS.
    temp_idx: dict[str, int] = {}   # bucket_base -> next stable index for "(:)" buckets
    temp_seen: dict[str, Any] = {}  # resolved "temporary/..." path -> first row (clash warning)
    paths_list, value_leaf_list, descriptors_list = [], [], []
    for _, row_i in df.iterrows():
        if row_i["status"] == "temporary":
            bucket_raw = row_i["csv_dtype"]
            if not isinstance(bucket_raw, str) or bucket_raw.strip() == "":
                paths_list.append([])           # missing csv_dtype, already warned upfront
                value_leaf_list.append("value")
                descriptors_list.append([])
                continue
            bucket_base, _ = parse_seg(bucket_raw)
            if "(:)" in bucket_raw:
                idx = temp_idx.get(bucket_base, 0)
                temp_idx[bucket_base] = idx + 1
                resolved = f"{bucket_base}({idx})"
            else:
                resolved = bucket_raw           # explicit (N) or bare slot 0
            path = f"temporary/{resolved}"
            if path in temp_seen:
                print(f"WARNING: temporary path '{path}' used by rows {temp_seen[path]} "
                      f"and {row_i.name} — values will overwrite; use (:) in csv_dtype "
                      f"for append behaviour")
            else:
                temp_seen[path] = row_i.name
            descriptors = [(["identifier", "name"], row_i["csv_column"])]
            if isinstance(row_i["csv_description"], str):
                descriptors.append((["identifier", "description"], row_i["csv_description"]))
            paths_list.append([path])
            value_leaf_list.append("value")
            descriptors_list.append(descriptors)
        else:
            imas_path = row_i["imas_path"]
            if not isinstance(imas_path, str):
                raise ValueError(f"Row {row_i.name}: imas_path is missing")
            paths_list.append(imas_path.split("&") if "&" in imas_path else [imas_path])
            if row_i["needs_source"]:
                value_leaf_list.append(row_i["_source_pair"][0])
                descriptors_list.append([([row_i["_source_pair"][1]], row_i["source"])])
            else:
                value_leaf_list.append("")
                descriptors_list.append([])
    df["_paths"] = pd.Series(paths_list, index=df.index, dtype=object)
    df["_value_leaf"] = pd.Series(value_leaf_list, index=df.index, dtype=object)
    df["_descriptors"] = pd.Series(descriptors_list, index=df.index, dtype=object)

    IDS_dict = {}
    reference_ids: dict[str, Any] = {}   # ids_root -> reference IDS (descriptor strings, shared)

    # Loop over data rows.
    print("Loading...")
    total_rows = len(data)
    loaded = 0
    load_start = time.monotonic()
    load_last_report = load_start

    for index_d, row_d in data.iterrows():

        if row_d.isna().all():
            continue

        pulse_ids = {}

        for index_i, row_i in df.iterrows():

            # row_i["csv_column"] names the column in `data`; row_d reads it.
            value = row_d[row_i["csv_column"]]
            if pd.isna(value):
                continue

            for imas_path in row_i["_paths"]:
                ids_root = imas_path.split("/")[0]
                value_leaf = row_i["_value_leaf"]
                full_path = imas_path + ("/" + value_leaf if value_leaf else "")
                ids_branch = full_path.split("/")[1:]

                # Expand the row's transform into concrete (branch, value) writes.
                writes = resolve_writes(ids_branch, value, row_i)

                # Write values to value path in the *pulse* IDS
                if ids_root not in pulse_ids:
                    pulse_ids[ids_root] = new_ids(factory, ids_root)
                write_values(pulse_ids[ids_root], writes)

                # Write descriptors to sibling descriptor path in the *reference* IDS
                if row_i["_descriptors"] and writes:
                    if ids_root not in reference_ids:
                        reference_ids[ids_root] = new_ids(factory, ids_root)
                    write_descriptors(reference_ids[ids_root], writes, row_i["_descriptors"])

        # Backfill an empty root `time` (NaN time column) so dynamic nodes can fit in arrays.
        for ids in pulse_ids.values():
            backfill_time(ids)

        IDS_dict[index_d] = pulse_ids
        loaded += 1
        load_last_report = report_progress(loaded, total_rows, index_d, load_start, load_last_report)

    report_summary("Loaded", loaded, total_rows, load_start, " into memory")

    # Write IDSs to disk.
    print("Writing...")
    os.makedirs(output_dir, exist_ok=True)
    total = len(IDS_dict)
    written = 0
    write_start = time.monotonic()
    write_last_report = write_start

    for pulse, pulse_ids in IDS_dict.items():
        summary = pulse_ids.get("summary")
        try:
            tag_name = summary.tag.name.strip()
        except AttributeError:
            tag_name = None
   #     if (tag_name != "SELEC2007=True") & (pulse != 0):
   #         continue

        pulse_dir = os.path.join(output_dir, f"pulse_{pulse:04d}")
        os.makedirs(pulse_dir, exist_ok=True)
        uri = f"imas:hdf5?path={pulse_dir};pulse=0"
        with imas.DBEntry(uri, "a") as entry:
            for ids in pulse_ids.values():
                entry.put(ids)
        written += 1
        write_last_report = report_progress(written, total, pulse, write_start, write_last_report)

    report_summary("Wrote", written, total, write_start, f" to {output_dir}")

    # Write the shared reference entry: one IDS per root holding the descriptor
    # strings (source/identifier) once, at the same paths as the pulse values.
    if reference_ids:
        for ids in reference_ids.values():
            backfill_time(ids)
        ref_dir = os.path.join(output_dir, "reference")
        os.makedirs(ref_dir, exist_ok=True)
        ref_uri = f"imas:hdf5?path={ref_dir};pulse=0"
        with imas.DBEntry(ref_uri, "a") as entry:
            for ids in reference_ids.values():
                entry.put(ids)
        print(f"Wrote reference ({len(reference_ids)} IDSs: "
              f"{', '.join(reference_ids)}) to {ref_dir}")


