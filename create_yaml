#!/usr/bin/env python

import argparse, pyual
import init_mendeleiev as mend
from os import system
from sys import exit

# ----------------------------------------------------------------------

# Management of input arguments
parser = argparse.ArgumentParser(description=\
	 '---- Auto-generated yaml scenario file (!!! STILL TO BE COMPLETED BY HAND !!!)')
parser.add_argument('-u','--user',help='username of the DB where the datafile is located', required=True)
parser.add_argument('-t','--tokamakname',help='tokamak name of the DB where the datafile is located', required=True)
parser.add_argument('-s','--shot',help='shot number', required=True,type=int)
parser.add_argument('-r','--run',help='run number',required=True,type=int)
args = vars(parser.parse_args())
shot = args["shot"]
run  = args["run"]
user = args["user"]
tokamakname = args["tokamakname"]

# Open the database and read the necessary IDSs
try:
    cli = pyual.Client(shot,run,user=user)
except:
    print "Shot " + str(shot) + ", run " + str(run) + " does not exist"
    print "----> Aborted."
    exit()
    

# Read necessary IDSs from database
try:
    equilibrium = cli.get('equilibrium')
except:
    print "The equilibrium IDS is absent from the input datafile"
    print "----> Aborted."
    exit()
try:
    core_profiles = cli.get('core_profiles')
except:
    print "The core_profiles IDS is absent from the input datafile"
    print "----> Aborted."
    exit()
try:
    summary = cli.get('summary')
except:
    print "The summary IDS is absent from the input datafile"
    print "----> H&CD waveforms not filled (to be completed by hand)"

# Mendeleiev table
table_mendeleiev = mend.create_table_mendeleiev()

# Fill the variables necessary to complete the yaml description file
try:
    islice = len(equilibrium.time)/2
    magnetic_field = max(equilibrium.vacuum_toroidal_field.b0)
except:
    print "equilibrium.time_slice[:].global_quantities.magnetic_axis.b_tor could not be read"
    print "----> Aborted."
    exit()

try:
    plasma_current = 0
    for islice in range(len(equilibrium.time)):
        if abs(equilibrium.time_slice[islice].global_quantities.ip)*1.e-6 > plasma_current:
            plasma_current = abs(equilibrium.time_slice[islice].global_quantities.ip)*1.e-6
except:
    print "equilibrium.time_slice[:].global_quantities.ip could not be read"
    print "----> Aborted."
    exit()

try:
    nspecies = len(core_profiles.profiles_1d[0].ion)
    a = [0] * nspecies
    for ispecies in range(nspecies):
        a[ispecies] = int(core_profiles.profiles_1d[0].ion[ispecies].element[0].a)
except:
    print "core_profiles.profiles_1d[:].ion[0].element[0].a could not be read"
    nspecies = 0
    a = [0]

try:
    nspecies = len(core_profiles.profiles_1d[0].ion)
    z = [0] * nspecies
    for ispecies in range(nspecies):
        z[ispecies] = int(core_profiles.profiles_1d[0].ion[ispecies].element[0].z_n)
except:
    print "core_profiles.profiles_1d[:].ion[0].element[0].z_n could not be read"
    nspecies = 0
    z = [0]

try:
    central_electron_density = 0
    for islice in range(len(core_profiles.profiles_1d)):
        if core_profiles.profiles_1d[islice].electrons.density[0] > central_electron_density:
            central_electron_density = core_profiles.profiles_1d[islice].electrons.density[0]
except:
    print "core_profiles.profiles_1d[:].electrons.density[0] could not be read"
    print "----> Aborted."
    exit()

try:
    central_zeff = 0
    for islice in range(len(core_profiles.profiles_1d)):
        if core_profiles.profiles_1d[islice].zeff[0] > central_zeff:
            central_zeff = core_profiles.profiles_1d[islice].zeff[0]
except:
    print "core_profiles.profiles_1d[:].zeff[0] could not be read"
    print "----> Aborted."
    exit()

# H&CD quantities from summary IDS
if len(summary.time)==0:
    print "--------------------------------------------------------"
    print "The summary IDS is absent from the input datafile"
    print "----> H&CD waveforms not filled: to be completed by hand"
    print "--------------------------------------------------------"
    p_ec   = "tbd"
    p_ic   = "tbd"
    p_nbi  = "tbd"
    p_lh   = "tbd"
    p_hcd  = "tbd"
else:
    p_ec  = 0
    p_ic  = 0
    p_nbi = 0
    p_lh  = 0
    n_ec  = len(summary.heating_current_drive.ec)
    n_ic  = len(summary.heating_current_drive.ic)
    n_nbi = len(summary.heating_current_drive.nbi)
    n_lh  = len(summary.heating_current_drive.lh)
    if n_ec > 0:
        for isource in range(n_ec):
            if len(summary.heating_current_drive.ec[isource].power.value) > 0:
                p_ec = p_ec + max(summary.heating_current_drive.ec[isource].power.value)*1.e-6
    if n_ic > 0:
        for isource in range(n_ic):
            if len(summary.heating_current_drive.ic[isource].power.value) > 0:
                p_ic = p_ic + max(summary.heating_current_drive.ic[isource].power.value)*1.e-6
    if n_nbi > 0:
        for isource in range(n_nbi):
            if len(summary.heating_current_drive.nbi[isource].power.value) > 0:
                p_nbi = p_nbi + max(summary.heating_current_drive.nbi[isource].power.value)*1.e-6
    if n_lh > 0:
        for isource in range(n_lh):
            if len(summary.heating_current_drive.lh[isource].power.value) > 0:
                p_lh = p_lh + max(summary.heating_current_drive.lh[isource].power.value)*1.e-6
    p_hcd = p_ec + p_ic + p_nbi + p_lh

if nspecies > 0:

    # Plasma composition
    species = []
    for ispecies in range(nspecies):
        species.append(table_mendeleiev[z[ispecies]][a[ispecies]].element)

    # Species concentrations
    nrho   = max(len(core_profiles.profiles_1d[0].grid.rho_tor_norm),len(core_profiles.profiles_1d[0].grid.rho_tor))
    volume = core_profiles.profiles_1d[0].grid.volume

    ntot = 0
    species_density = [0] * nspecies
    for ispecies in range(nspecies):
        species_density[ispecies] = sum(volume*core_profiles.profiles_1d[0].ion[ispecies].density)
        ntot = ntot + species_density[ispecies]
    ne = sum(volume*core_profiles.profiles_1d[0].electrons.density)

    nspec_over_ntot = species_density/ntot
    nspec_over_ne   = species_density/ne
    nspec_over_nmaj = species_density/species_density[0]

    # Nice display of plasma composition with species concentrations
    disp_species         = '   species:      '
    disp_a               = '   a:            '
    disp_z               = '   z:            '
    disp_nspec_over_ntot = '   n_over_ntot:  '
    disp_nspec_over_ne   = '   n_over_ne:    '
    disp_nspec_over_nmaj = '   n_over_n_maj: '
    main_species = ''
    for ispecies in range(nspecies):
        if nspec_over_ntot[ispecies] > 0.45:
            if len(main_species) == 0:
                main_species = main_species + species[ispecies]
            else:
                main_species = main_species + "-" + species[ispecies]
        if nspec_over_ne[ispecies] > 0.001:
            tabsize = 8
            disp_species = disp_species + species[ispecies] + " " * (tabsize-len(species[ispecies]))
            disp_a = disp_a + format("%.1f" % a[ispecies]) + " " * (tabsize-len(format("%.1f" % a[ispecies])))
            disp_z = disp_z + format("%.1f" % z[ispecies]) + " " * (tabsize-len(format("%.1f" % z[ispecies])))
            disp_nspec_over_ntot = disp_nspec_over_ntot + format("%.2f" % nspec_over_ntot[ispecies]) + " " * (tabsize-len(format("%.2f" % nspec_over_ntot[ispecies])))
            disp_nspec_over_ne   = disp_nspec_over_ne   + format("%.2f" % nspec_over_ne[ispecies])   + " " * (tabsize-len(format("%.2f" % nspec_over_ne[ispecies])))
            disp_nspec_over_nmaj = disp_nspec_over_nmaj + format("%.2f" % nspec_over_nmaj[ispecies]) + " " * (tabsize-len(format("%.2f" % nspec_over_nmaj[ispecies])))
    print "   ---------------------------------------------------------------------"
    print disp_species
    print disp_a
    print disp_z
    print disp_nspec_over_ntot
    print disp_nspec_over_ne
    print disp_nspec_over_nmaj
    print "   ---------------------------------------------------------------------"

else:
    main_species = "tbd"

# Misc
workflow = "tbd"
type     = "tbd"

# Set up the name of the yaml file
strsize = len(str(shot))+len(str(run))
if strsize < 8:
    add0 = ""
    for i in range(8-strsize):
        if len(add0) < 3:
            add0 = add0+"0"
filename = "ids_"+str(shot)+add0+str(run)+".yaml"

# Go for it: fill the yaml file
f = open(filename, 'w')
f.write("""# ------------------------------------------------------------------\n""")
f.write("""# Status is "draft" when auto-generated by the create_yam function,\n""")
f.write("""# to be changed to "active" once simulation and yaml files are ready\n""")
f.write("""# to be changed to "obsolete" if the simulation becomes obsolete\n""")
f.write("""# ------------------------------------------------------------------\n""")
f.write("""status: \n""")
f.write("""    draft\n""")
f.write("""\n""")
f.write("""# ------------------------------------------------------------------\n""")
f.write("""# Shot number, run numbers, type, code, machine attributes\n""")
f.write("""# Type: interpretative, predictive, experiment\n""")
f.write("""# Code: code name in case of simulation, 0 in case of experiment\n""")
f.write("""# Machine: tokamak name\n""")
f.write("""# ------------------------------------------------------------------\n""")
f.write("""characteristics:\n""")
f.write("""    shot: %i\n""" % shot)
f.write("""    run: %i\n""" % run)
f.write("""    type: %s\n""" % type)
f.write("""    workflow: %s\n""" % workflow)
f.write("""    machine: %s\n""" % tokamakname)
f.write("""\n""")
f.write("""# --------------------------------------------------\n""")
f.write("""# Machine description or specific configuration\n""")
f.write("""# (scenario keys can be completed here if relevant)\n""")
f.write("""# Units are [T], [-], [MA], [m-3] respectively\n""")
f.write("""# --------------------------------------------------\n""")
f.write("""scenario_key_parameters:\n""")
f.write("""    magnetic_field: %.2f\n""" % magnetic_field)
f.write("""    main_species: %s\n""" % main_species)
f.write("""    plasma_current: %.2f \n""" % plasma_current)
f.write("""    central_electron_density: %.2e\n""" % central_electron_density)
f.write("""    central_zeff: %.2f\n""" % central_zeff)
f.write("""\n""")
f.write("""# ---------------------------------------------------\n""")
f.write("""# Nominal power of H&CD systems (MW)\n""")
f.write("""# (initial guess to be adjusted by hand if necessary)\n""")
f.write("""# ---------------------------------------------------\n""")
f.write("""hcd:\n""")
if len(summary.time)==0:
    f.write("""    p_hcd: tbd\n""")
    f.write("""    p_ec:  tbd\n""")
    f.write("""    p_ic:  tbd\n""")
    f.write("""    p_nbi: tbd\n""")
    f.write("""    p_lh:  tbd\n""")
else:
    f.write("""    p_hcd: %.2f\n""" % p_hcd)
    f.write("""    p_ec:  %.2f\n""" % p_ec)
    f.write("""    p_ic:  %.2f\n""" % p_ic)
    f.write("""    p_nbi: %.2f\n""" % p_nbi)
    f.write("""    p_lh:  %.2f\n""" % p_lh)
f.write("""\n""")
if nspecies > 0:
    f.write("""# ---------------------------------------------------------\n""")
    f.write("""# Plasma composition as deduced from the core_profiles IDS\n""")
    f.write("""# ---------------------------------------------------------\n""")
    f.write("""plasma_composition:\n""")
    f.write(disp_species+"\n")
    f.write(disp_a+"\n")
    f.write(disp_z+"\n")
    f.write(disp_nspec_over_ntot+"\n")
    f.write(disp_nspec_over_ne+"\n")
    f.write(disp_nspec_over_nmaj+"\n")
    f.write("""\n""")
f.write("""# --------------------\n""")
f.write("""# Content description\n""")
f.write("""# --------------------\n""")
f.write("""free_description: |\n""")
f.write("""    - H-mode or L-mode or whatever\n""")
f.write("""    - Density:           ne = ??% nGW, peaking assumptions...\n""")
f.write("""    - Confinement:       transport model or scaling law that have been used...\n""")
f.write("""    - Pedestal:          pedestal assumptions....\n""")
f.write("""    - L-H transition:    scaling laws that have been used\n""")
f.write("""\n""")
f.write("""# ------------------------------------------------------------------------------\n""")
f.write("""# List of filled IDSs with time quantities in seconds (start, end, step)\n""")
f.write("""# It should be the ouptut of the "ids_content" script, adapted from\n""")
f.write("""# listidss, see IMAS-1010 (note: the datafile has to be copied to a personal\n""")
f.write("""# database for the script to work, see the example below):\n""")
f.write("""#  ids_content -u schneim -t test -v 3 4321,1\n""")
f.write("""# ------------------------------------------------------------------------------\n""")
f.write("""idslist:\n""")
f.close()

# Complete the yaml file with the output of ids_content
system('ids_content -u ' + str(user) + ' -t ' + str(tokamakname) \
          + ' -s ' + str(shot) + ' -r ' + str(run) + ' >> ' + filename)

print "----> " + filename + " created."

