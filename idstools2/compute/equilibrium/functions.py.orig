    # TODO Give meaningful names for the functions so others can understand
    def get_b_tot(self, time_index):
        """[summary]

        Args:
            index (int, optional): [description]. Defaults to 0.

        Returns:
            [type]: [description]
        """
        ieq_rect = self.get_rectangular_rz_grid_index_of_bfield(time_index)
        # TODO Meaningful names for return variables
        b_tot = None
        if ieq_rect is not None:
            b_tot = np.sqrt(
                self.ids_object.time_slice[time_index].profiles_2d[ieq_rect].b_field_r
                ** 2
                + self.ids_object.time_slice[time_index].profiles_2d[ieq_rect].b_field_z
                ** 2
                + self.ids_object.time_slice[time_index]
                .profiles_2d[ieq_rect]
                .b_field_tor
                ** 2
            )
        return ieq_rect, b_tot

    # TODO Give meaningful names for the functions so others can understand
    def get_rectangular_rz_grid_index_of_bfield(self, time_index):
        """
        Find index of (R,Z) rectangular grid of B-field

        Args:
            index (int, optional): [description]. Defaults to 0.

        Returns:
            [type]: [description]
        """
        ieq_rect = -99
        for ieq in range(len(self.ids_object.time_slice[time_index].profiles_2d)):
            if (
                self.ids_object.time_slice[time_index].profiles_2d[ieq].grid_type.index
                == 1
            ):
                ieq_rect = ieq
        if ieq_rect < 0:
            ieq_rect = None
            print("No rectangular R,Z grid found in equilibrium IDS")
        return ieq_rect

    def get_flux_surfaces(self, time_index):

        ieq_rect = self.get_rectangular_rz_grid_index_of_bfield(time_index)
        # Reading in 2d structures
        r2d = np.array(self.ids_object.time_slice[time_index].profiles_2d[ieq_rect].r)
        z2d = np.array(self.ids_object.time_slice[time_index].profiles_2d[ieq_rect].z)
        psi2d = np.array(
            self.ids_object.time_slice[time_index].profiles_2d[ieq_rect].psi
        )
        if len(self.ids_object.time_slice[time_index].profiles_2d[ieq_rect].phi) > 0:
            rho2d = np.sqrt(
                self.ids_object.time_slice[time_index].profiles_2d[ieq_rect].phi
                / np.amax(
                    self.ids_object.time_slice[time_index].profiles_2d[ieq_rect].phi
                )
            )
        else:
            rho2d = []

        return r2d, z2d, rho2d, psi2d

    def get_waveform_ip(self):
        ntime = len(self.ids_object.time_slice)
        time_array = []
        ip = []
        for itime in range(ntime):
            time_array.append(self.ids_object.time[itime])
            ip.append(-self.ids_object.time_slice[itime].global_quantities.ip * 1.0e-6)

        return ip, time_array

    def get_ip(self):
        ip = []
        ntime = len(self.ids_object.time_slice)
        for itime in range(ntime):
            ip.append(-self.ids_object.time_slice[itime].global_quantities.ip * 1.0e-6)
        return ip

    def get_top_view(self, time_index):
        data = {}
        data["r0"] = r0 = self.ids_object.time_slice[
            time_index
        ].boundary.geometric_axis.r
        data["amin"] = amin = self.ids_object.time_slice[
            time_index
        ].boundary.minor_radius
        data["phit"] = phit = np.linspace(0, 2 * np.pi, 100)
        data["xpla"] = (r0 - amin) * np.cos(phit)
        data["ypla"] = (r0 - amin) * np.sin(phit)
        data["xplap"] = (r0 + amin) * np.cos(phit)
        data["yplap"] = (r0 + amin) * np.sin(phit)
        return data
