#!/usr/bin/env python
# A script which copies every IDS in a pulsefile to a different version
# Tomasz Zok, PSNC (tzok [at] man.poznan.pl)
# ISIP Core Programming Team

import os
import os.path
import sys
import imas
import xml.sax
import xml.sax.handler

class Parser(xml.sax.handler.ContentHandler):
    def __init__(self):
        xml.sax.handler.ContentHandler.__init__(self)
        self.idss = []

    def startElement(self, name, attrs):
        if name == 'IDS':
            ids = dict()
            for i in attrs.getNames():
                ids[i] = attrs.getValue(i)
            self.idss.append(ids)

if __name__ == '__main__':
    if len(sys.argv) != 8 and len(sys.argv) != 9:
        print('This script copies a list of IDS from a data entry specified by (username, databasename IMASMajorVersion, pulse and run) to a new destination data entry created in your database via a series of GET/PUT operations')
	print('If the destination data entry was pre-existing, its previous content is erased in the operation.')
	print('Usage:')
        print('    idscopy username databasename IMASMajorVersion pulse run destination_pulse destination_run '
              '[IDS-list-as-Python-list]')
        print('Example, copy all IDSs:')
        print('    idscopy coster jet 3 71827 21 71827 30')
        print('Example, copy just core_profiles and equilibrium:')
        print('    idscopy coster jet 3 71827 21 71827 30 '
              '"[\'core_profiles\', \'equilibrium\']"')
        print()
        print('NOTE : The destination MACHINE name is set by the imasdb script, the destination IMAS_MAJOR_VERSION by the loaded IMAS module')
        exit()
    # parse XML with IDS information
    path = os.getenv('IMAS_PREFIX')
    path = os.path.join(path, 'include/dd_data_dictionary.xml')
    #path = os.path.join(path, 'dd_data_dictionary.xml')
    parser = Parser()
    xml.sax.parse(path, parser)
    
    # open input pulsefile and create output one
    user, machine, versioni = sys.argv[1], sys.argv[2], sys.argv[3]
    shot, run = int(sys.argv[4]), int(sys.argv[5])
    print('Opening  /%s/%s/%s/%d/%d' % (user, machine, versioni, shot, run))
    idss_in = imas.ids(shot, run)
    idss_in.open_env(user, machine, versioni)

    user, machine, versiono = os.getenv('USER'), os.getenv("MDSPLUS_TREE_BASE_0").split("/")[-3],\
            os.getenv("IMAS_VERSION").split(".")[0]
    shot, run = int(sys.argv[6]), int(sys.argv[7])
    print('Creating /%s/%s/%s/%d/%d' % (user, machine, versiono, shot, run))
    idss_out = imas.ids(shot, run)
    idss_out.create()
    idx = idss_out.expIdx
    ids_list = None
    if len(sys.argv) == 9:
        ids_list = eval(sys.argv[8]) 
    # read/write every IDS
    for ids_info in parser.idss:
        name = ids_info['name']
        #timed = ids_info['timed'] CPO feature, obsolete for IDSs. 
        maxoccur = int(ids_info['maxoccur'])
        if ids_list and name not in ids_list:
            continue
        if name not in idss_in.__dict__:
            continue
        #if ids_info['timed'] == 'no':
        for i in range(maxoccur + 1):
            if i:
                print('Processing %s/%d' % (ids_info['name'], i))
            else:
                print('Processing %s' % ids_info['name'])
            ids = idss_in.__dict__[name]
            stdout = sys.stdout
            sys.stdout = open('/dev/null', 'w') # suppress warnings
            ids.get(i)
            sys.stdout = stdout
	    if (ids.ids_properties.homogeneous_time == 0 or ids.ids_properties.homogeneous_time == 1):
               ids.setExpIdx(idx)
               ids.put(i)
	    else:
	       print('This IDS is empty and skipped')
    idss_in.close()
    idss_out.close()
    #        else: setExpIds on each slice, CPO feature obsolete for IDSs
    #            for i in range(maxoccur + 1):
    #                if i:
    #                    print('Processing %s/%d' % (ids_info['type'], i))
    #                else:
    #                    print('Processing %s' % ids_info['type'])
    #                ids = idss_in.__dict__[type + 'Array']
    #                stdout = sys.stdout 
    #                sys.stdout = open('/dev/null', 'w') # suppress warnings
    #                ids.get(i)
    #                sys.stdout = stdout
    #                if not ids.array: 
    #                    print()
    #                    continue
    #                print('(found', len(ids.array), 'slices)')
    #                for slice in ids.array:
    #                    slice.setExpIdx(idx)
    #                ids.put(i)
