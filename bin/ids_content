#!/usr/bin/env python

import argparse, os, sys
import imas
from idstools.cli import *
from idstools import idslist

# ----------------------------------------------------------------------

# Management of input arguments
parser = argparse.ArgumentParser(
    description="---- List ids content for yaml files aimed at describing a scenario ----",
    parents=[imas_parser],
)
parser.add_argument("-s", "--shot", help="shot number", required=True, type=int)
parser.add_argument("-r", "--run", help="run number", required=True, type=int)
args = parser.parse_args()

# Open the database and read the necessary IDSs
db = imas.DBEntry(
    get_backend_id(args.backend), args.database, args.shot, args.run, args.user
)
status, _ = db.open()
if status != 0:
    print("Shot " + str(args.shot) + ", run " + str(args.run)
        + " for user_or_path = " + args.user + " and database = " + args.database
        + " does not exist", file=sys.stderr,)
    print("----> Aborted.", file=sys.stderr)
    exit()

# Print IDS contents
for idsname, oc in idslist.available_in_dbentry(db):
    homogeneous_time = db.partial_get(
        idsname, "ids_properties/homogeneous_time", occurrence=oc
    )
    times = db.partial_get(idsname, "time", occurrence=oc)

    # Format idsname
    if oc > 0:
        idsnameoc = idsname + "/" + str(oc)
    else:
        idsnameoc = idsname

    # For every homogeneous_time [0,1,2]
    if homogeneous_time == 0:
        print("  " + idsnameoc + ":")
        print("     time_step_number: " + str(len(times)))
        print("     time:             [unhomogeneous]")
    elif homogeneous_time == 1:
        if len(times) > 1:
            time_step = (times[len(times) - 1] - times[0]) / (len(times) - 1)
            start_time = times[0]
            end_time = times[len(times) - 1]
            print("  " + idsnameoc + ":")
            print("     time_step_number: " + str(len(times)))
            print("     start_end_step:   ["
                + str(start_time) + "  " + str(end_time) + "  " + str(time_step) + "]")
        elif len(times) == 1:
            print("  " + idsnameoc + ":")
            print("     time_step_number: " + str(len(times)))
            print("     time:             [" + str(times[0]) + "]")
    elif homogeneous_time == 2:
        print("  " + idsnameoc + ":")
        print("     time_step_number: " + str(len(times)))
        print("     time:             [static]")
