#! /usr/bin/env python
### David.Coster@ipp.mpg.de
import numpy as np
import imas
import argparse
import os
IMAS_BACKEND = imas.imasdef.MDSPLUS_BACKEND

parser = argparse.ArgumentParser(description="View information about fluxes", epilog
="""
""", formatter_class=argparse.RawTextHelpFormatter)
parser.add_argument("--user", "-u", type=str, help="user",default=os.getenv("USER"))
parser.add_argument("--tokamak", "-t", "-m", "-d", type=str, help="tokamak",default=os.getenv("TOKAMAKNAME"))
parser.add_argument("--version", "-v", type=str, help="version",default='3')
parser.add_argument("--occurrence", "-o", type=int, help="version",default='0')
parser.add_argument("shot", type=int, help="Shot number")
parser.add_argument("run", type=int, help="Run number")
parser.add_argument("time", type=float, help="Time")
args=parser.parse_args()

IDS = imas.DBEntry(IMAS_BACKEND, args.tokamak, args.shot, args.run, user_name=args.user)
IDS.open()
T = IDS.get_slice('core_transport', args.time, imas.imasdef.CLOSEST_SAMPLE, occurrence=args.occurrence)
print('\nTime = %0.3f for %s/%s/%s/%s/%s\n' % (T.time, args.user, args.tokamak, args.version, args.shot, args.run))
for t in T.model:
    print("%s (%s)" % (t.identifier.name, t.flux_multiplier))
    print("       electrons", end='')
    # electrons
    i= t.profiles_1d[0].electrons
    if len(i.particles.flux) == 0:
        print('     particles     --       ', end='')
    else:
        print('     particles %13.6e' % ((i.particles.flux * t.profiles_1d[0].grid_flux.surface)[-1]), end='')
    if len(i.energy.flux) == 0:
        print('     energy     --       ')
    else:
        print('     energy %13.6e' % ((i.energy.flux * t.profiles_1d[0].grid_flux.surface)[-1]))
    # ions
    for i in t.profiles_1d[0].ion:
        print("    ", i.element[0].a, i.element[0].z_n, i.z_ion, end='')
        if len(i.particles.flux) == 0:
           print('     particles     --       ', end='')
        else:
           print('     particles %13.6e' % ((i.particles.flux * t.profiles_1d[0].grid_flux.surface)[-1]), end='')
        if len(i.energy.flux) == 0:
           print('     energy     --     ')
        else:
           print('     energy %13.6e' % ((i.energy.flux * t.profiles_1d[0].grid_flux.surface)[-1]))
