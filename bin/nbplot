#!/usr/bin/env python
from __future__ import print_function

# MODULES
# --------
import numpy as np
import imas,argparse,sys,os
import matplotlib
matplotlib.use('TKagg')
import matplotlib.pyplot as plt

# MANAGEMENT OF INPUT ARGUMENTS
# ------------------------------
parser = argparse.ArgumentParser(description= \
                                     '---- Display NBI results')
parser.add_argument('-s','--shot',help='Shot number', required=True,type=int)
parser.add_argument('-r','--run',help='Run number',required=True,type=int)
parser.add_argument('-u','--user_or_path',help='User or absolute path name where the data-entry is located', required=False)
parser.add_argument('-d','--database',help='Database name where the data-entry is located', required=False)
parser.add_argument('-t','--time',help='time', required=False,type=float)

args         = vars(parser.parse_args())
shot         = args["shot"]
run          = args["run"]
time         = args["time"]

# User or absolute path name
if args['user_or_path'] != None:
    user_or_path = args['user_or_path']
else:
    user_or_path = 'public'

# Database name
if args['database'] != None:
    database = args['database']
else:
    database = 'iter'

# DISPLAY PARAMETERS
# -------------------
fontsize = 12
figure_width  = 5
figure_height = 4

plt.rcParams['font.size'] = fontsize
plt.rcParams['axes.linewidth'] = 1.5
plt.rcParams['grid.alpha'] = 1.0

font = {'family': 'serif',
        'color':  'darkred',
        'weight': 'normal',
        'size': fontsize,
        }


# ----------------------------------------------------------------------

def find_nearest(a, a0):
    'Element in nd array `a` closest to the scalar value `a0`'
    idx = np.abs(a - a0).argmin()
    return a.flat[idx],idx

# ----------------------------------------------------------------------

# Legend customization
def CustomLegend(legend):
    frame = legend.get_frame()
    frame.set_facecolor('0.95')
    for label in legend.get_texts():
        label.set_fontsize(fontsize)
    for label in legend.get_lines():
        label.set_linewidth(1.5)  # the legend line width
    return

# ----------------------------------------------------------------------

# READ IDS'S FROM LOCAL DATABASE
# -------------------------------
version = os.getenv('IMAS_VERSION')[0]
input=imas.ids(shot,run)
[err,n]=input.open_env(user_or_path,database,version,silent=True)
if err != 0:
    print('Shot ' + str(shot) + ', run ' + str(run) +' for user_or_path = '+user_or_path+' and database = '+database+' does not exist', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

#input.distribution_sources.get()
input.distributions.get()
input.close()

# TIME VECTOR AND TIME INDEX
# ---------------------------

timevec = input.distributions.time
ntime = len(timevec)
if ntime==1:
    if len(timevec) > 0:
        tc = timevec[0]
    else:
        tc = 0
    it = 0
else:
    if time:
        [tc,it] = find_nearest(timevec,time)
    else:
        it = int(ntime/2)
        tc = timevec[it]
    print('--------------------------------------------------------------------------', file=sys.stderr)
    print(' Time  = '+'%.2f' % tc+' s in range ['+'%.2f' % timevec[0]+','+'%.2f' % timevec[ntime-1]+'] s', file=sys.stderr)
    print(' Index = ',str(it), file=sys.stderr)
    print(' Averaged resolution = ', (timevec[ntime-1]-timevec[0])/(ntime-1),' s', file=sys.stderr)
    print('--------------------------------------------------------------------------', file=sys.stderr)

time = tc

ndistributions = len(input.distributions.distribution)
is_active = [0]*ndistributions
for idistrib in range(ndistributions):
    if len(input.distributions.distribution[idistrib].global_quantities[0].collisions.ion)>0:
        is_active[idistrib] = 1
        try:
            rho_tor_norm = 0
            if len(input.distributions.distribution[idistrib].profiles_1d[it].grid.rho_tor_norm) > 0:
                nrho = len(input.distributions.distribution[idistrib].profiles_1d[it].grid.rho_tor_norm)
                rho_tor_norm = input.distributions.distribution[idistrib].profiles_1d[it].grid.rho_tor_norm
            elif len(input.distributions.distribution[idistrib].profiles_1d[it].grid.rho_tor) > 0:
                nrho = len(input.distributions.distribution[idistrib].profiles_1d[it].grid.rho_tor)
                rho_tor_norm = input.distributions.distribution[idistrib].profiles_1d[it].grid.rho_tor/input.distributions.distribution[idistrib].profiles_1d[it].grid.rho_tor[nrho-1]
        except:
            print('distributions.distribution[idistrib].profiles_1d[it].grid.rho_tor_norm and rho_tor could not be read', file=sys.stderr)
            print('----> Aborted.', file=sys.stderr)
            exit()
        if nrho==0:
            print('distributions.distribution[idistrib].profiles_1d[it].grid.rho_tor_norm and rho_tor are empty', file=sys.stderr)
            print('----> Aborted.', file=sys.stderr)
            exit()

if sum(is_active)==0:
    print('The distributions IDS appears empty ----> Abort.', file=sys.stderr)
    exit()

# --------------------------------------------------------------

# INJECTOR NAME
single_nb_source_name = dict()

# WAVEFORMS
all_injectors_current_waveform               = [0]*ntime
all_injectors_electron_power_waveform        = [0]*ntime
all_injectors_ion_power_waveform             = [0]*ntime
all_injectors_total_power_waveform           = [0]*ntime
single_current_waveform                      = dict()
single_electron_power_waveform               = dict()
single_ion_power_waveform                    = dict()
single_total_power_waveform                  = dict()

# PROFILES
all_injectors_current_density_profile        = [0]*nrho
all_injectors_electron_power_density_profile = [0]*nrho
all_injectors_ion_power_density_profile      = [0]*nrho
all_injectors_total_power_density_profile    = [0]*nrho
single_current_density_profile               = dict()
single_electron_power_density_profile        = dict()
single_ion_power_density_profile             = dict()
single_total_power_density_profile           = dict()

# LOOP OVER ALL NBI INJECTORS
for idistrib in range(ndistributions):
    # INJECTOR NAME
    if len(input.distributions.distribution[idistrib].process)>0:
        if len(input.distributions.distribution[idistrib].process[0].type.description)>0:
            single_nb_source_name[idistrib] = input.distributions.distribution[idistrib].process[0].type.description+str(idistrib)
        else:
            single_nb_source_name[idistrib] = 'Beam_'+str(idistrib)
    else:
        single_nb_source_name[idistrib] = 'Beam_'+str(idistrib)
    if is_active[idistrib]:
        # WAVEFORMS
        single_current_waveform[idistrib]        = [0]*ntime
        single_electron_power_waveform[idistrib] = [0]*ntime
        single_ion_power_waveform[idistrib]      = [0]*ntime
        single_total_power_waveform[idistrib]    = [0]*ntime
        nions = len(input.distributions.distribution[idistrib].global_quantities[0].collisions.ion)
        for itime in range(ntime):
            single_current_waveform[idistrib][itime]        = input.distributions.distribution[idistrib].global_quantities[itime].current_tor
            single_electron_power_waveform[idistrib][itime] = input.distributions.distribution[idistrib].global_quantities[itime].collisions.electrons.power_thermal
            for iion in range(nions):
                single_ion_power_waveform[idistrib][itime]  = single_ion_power_waveform[idistrib][itime] + input.distributions.distribution[idistrib].global_quantities[itime].collisions.ion[iion].power_thermal
            single_total_power_waveform[idistrib][itime]    = single_electron_power_waveform[idistrib][itime] + single_ion_power_waveform[idistrib][itime]
            all_injectors_current_waveform[itime]           = all_injectors_current_waveform[itime]        + single_current_waveform[idistrib][itime]
            all_injectors_electron_power_waveform[itime]    = all_injectors_electron_power_waveform[itime] + single_electron_power_waveform[idistrib][itime]
            all_injectors_ion_power_waveform[itime]         = all_injectors_ion_power_waveform[itime]      + single_ion_power_waveform[idistrib][itime]
            all_injectors_total_power_waveform[itime]       = all_injectors_total_power_waveform[itime]    + single_electron_power_waveform[idistrib][itime] + single_ion_power_waveform[idistrib][itime]
        # PROFILES
        single_current_density_profile[idistrib]        = [0]*nrho
        single_electron_power_density_profile[idistrib] = [0]*nrho
        single_ion_power_density_profile[idistrib]      = [0]*nrho
        single_total_power_density_profile[idistrib]    = [0]*nrho
        single_current_density_profile[idistrib]         = input.distributions.distribution[idistrib].profiles_1d[it].current_tor
        single_electron_power_density_profile[idistrib]  = input.distributions.distribution[idistrib].profiles_1d[it].collisions.electrons.power_thermal
        for iion in range(nions):
            single_ion_power_density_profile[idistrib]   = single_ion_power_density_profile[idistrib] + input.distributions.distribution[idistrib].profiles_1d[it].collisions.ion[iion].power_thermal
        single_total_power_density_profile[idistrib]     = single_electron_power_density_profile[idistrib] + single_ion_power_density_profile[idistrib]
        all_injectors_current_density_profile            = all_injectors_current_density_profile           + single_current_density_profile[idistrib]
        all_injectors_electron_power_density_profile     = all_injectors_electron_power_density_profile    + single_electron_power_density_profile[idistrib]
        all_injectors_ion_power_density_profile          = all_injectors_ion_power_density_profile         + single_ion_power_density_profile[idistrib]
        all_injectors_total_power_density_profile        = all_injectors_total_power_density_profile       + single_electron_power_density_profile[idistrib] + single_ion_power_density_profile[idistrib]

# PROFILE OF ABSORBED POWER DENSITY ON ELECTRONS+IONS FOR ALL INJECTORS AND EACH OF THEM INDIVIDUALLY [MW/M3]
fig,ax =plt.subplots(1,1)
if sum(is_active)>1:
    ax.plot(rho_tor_norm, all_injectors_total_power_density_profile*1.e-6,label=r'All injectors')
for idistrib in range(ndistributions):
    if is_active[idistrib]:
        ax.plot(rho_tor_norm, single_total_power_density_profile[idistrib]*1.e-6,label=single_nb_source_name[idistrib])
ax.set_ylabel('Absorbed power $\mathrm{[MW/m^{3}]}$')
ax.set_xlabel('Normalized toroidal flux coordinate')
plt.grid()
#legend = plt.legend()
#CustomLegend(legend)
fig.set_size_inches(figure_width,figure_height)
fig.tight_layout()
fig.savefig('NBI_power_individuals_injectors_profile_shot_{0}_run_{1}.png'.format(shot,run),bbox_inches="tight")
#plt.title('Whatever')
plt.show(block=False)

# PROFILE OF ABSORBED POWER DENSITY ON ELECTRONS+IONS, ELECTRONS, IONS FOR ALL INJECTORS [MW/M3]
fig,ax =plt.subplots(1,1)
if sum(is_active)>1:
    ax.plot(rho_tor_norm, all_injectors_total_power_density_profile*1.e-6,label=r'Electrons+Ions')
    ax.plot(rho_tor_norm, all_injectors_electron_power_density_profile*1.e-6,label=r'Electrons')
    ax.plot(rho_tor_norm, all_injectors_ion_power_density_profile*1.e-6,label=r'Ions')
ax.set_ylabel('Absorbed power $\mathrm{[MW/m^{3}]}$')
ax.set_xlabel('Normalized toroidal flux coordinate')
plt.grid()
legend = plt.legend()
CustomLegend(legend)
fig.set_size_inches(figure_width,figure_height)
fig.tight_layout()
fig.savefig('NBI_power_all_injectors_el_ion_profile_shot_{0}_run_{1}.png'.format(shot,run),bbox_inches="tight")
#plt.title('Whatever')
plt.show(block=False)

# NBCD PROFILE [MA/M2]
fig,ax =plt.subplots(1,1)
if sum(is_active)>1:
    ax.plot(rho_tor_norm, all_injectors_current_density_profile*1.e-6)
for idistrib in range(ndistributions):
    if is_active[idistrib]:
        ax.plot(rho_tor_norm, single_current_density_profile[idistrib]*1.e-6,label=single_nb_source_name[idistrib])
ax.set_ylabel('$\mathrm{NBCD} [MA/m^{2}]}$')
ax.set_xlabel('Normalized toroidal flux coordinate')
plt.grid()
#legend = plt.legend()
#CustomLegend(legend)
fig.set_size_inches(figure_width,figure_height)
fig.tight_layout()
fig.savefig('NBI_power_profile_shot_{0}_run_{1}.png'.format(shot,run),bbox_inches="tight")
#plt.title('Whatever')

# NBI POWER AND NBCD WAVEFORMS
if ntime==1:
    print('Only one time slice --> Power and NBCD waveforms not displayed', file=sys.stderr)
    plt.show(block=True)
else:
    plt.show(block=False)
    # NBI POWER WAVEFORM
    fig,ax =plt.subplots(1,1)
    if sum(is_active)>1:
        ax.plot(timevec, np.array(all_injectors_total_power_waveform)*1.e-6,label=r'Total')
        ax.plot(timevec, np.array(all_injectors_electron_power_waveform)*1.e-6,label=r'To electrons')
        ax.plot(timevec, np.array(all_injectors_ion_power_waveform) * 1.e-6, label=r'To ions')
for idistrib in range(ndistributions):
    if is_active[idistrib]:
        ax.plot(timevec, np.array(single_total_power_waveform[idistrib])*1.e-6,label=single_nb_source_name[idistrib])
ax.set_ylabel('Power to the bulk $\mathrm{[MW]}$')
ax.set_xlabel('Time (s)')
plt.grid()
#legend = plt.legend()
#CustomLegend(legend)
fig.set_size_inches(figure_width,figure_height)
fig.tight_layout()
fig.savefig('NBI_power_waveform_shot_{0}_run_{1}.png'.format(shot,run),bbox_inches="tight")
#plt.title('Whatever')
plt.gca().set_ylim(0,max(all_injectors_total_power_waveform)*1.2e-6)
plt.show(block=False)

# NBCD WAVEFORM
fig,ax =plt.subplots(1,1)
if sum(is_active)>1:
    ax.plot(timevec, np.array(all_injectors_current_waveform)*1.e-6,label=r'Total')
for idistrib in range(ndistributions):
    if is_active[idistrib]:
        ax.plot(timevec, np.array(single_current_waveform[idistrib])*1.e-6,label=single_nb_source_name[idistrib])
ax.set_ylabel('NBCD $\mathrm{[MA]}$')
ax.set_xlabel('Time (s)')
plt.grid()
#legend = plt.legend()
#CustomLegend(legend)
fig.set_size_inches(figure_width,figure_height)
fig.tight_layout()
fig.savefig('NBCD_waveform_shot_{0}_run_{1}.png'.format(shot,run),bbox_inches="tight")
#plt.title('Whatever')
#plt.gca().set_ylim(0,max(np.array(all_injectors_current_waveform))*1.2e-3)
plt.show(block=True)
