#!/usr/bin/env python
import xml.etree.ElementTree as ET


def getField(struct,field):
    if len(field)>1:
        f = getField(struct.find('./field[@name="'+field[0]+'"]'),field[1:])
    else:
        # specific generic node for which the useful doc is from the parent
        if field[0]!='value':
            f = struct.find('./field[@name="'+field[0]+'"]')
        else:
            f = struct
    return f


if __name__ == "__main__":
    import argparse
    import os
    import sys
    
    parser = argparse.ArgumentParser(description='Query the IDS XML Definition for documentation')
    parser.add_argument('ids',type=str,help='IDS name')
    parser.add_argument('path',type=str,help='Path for field of interest within the IDS')
    opt = parser.add_mutually_exclusive_group()
    opt.add_argument('-a','--all',action='store_true',help='Print all attributes')
    opt.add_argument('-s','--select',type=str,default='documentation',
                        help='Select attribute to be printed \t(default=%(default)s)')
    args = parser.parse_args()

    # parse the XML def
    try:
        imaspref = os.environ['IMAS_PREFIX']
        tree = ET.parse(imaspref+'/include/IDSDef.xml')
        root = tree.getroot()
    except:
        print("Error while trying to access IDSDef.xml, make sure you've loaded IMAS module first",file=sys.stderr)

    
    ids = root.find('./IDS[@name="'+args.ids+'"]')
    if ids==None:
        print("Error getting the IDS, please check that "+args.ids+" corresponds to a valid IDS name",file=sys.stderr)
        sys.exit()
        
    fields = args.path.split('/')

    f = getField(ids,fields)

    if args.all:
        for a in f.attrib:
            print(a+': '+f.attrib[a])
    else:
        print(f.attrib[args.select])
