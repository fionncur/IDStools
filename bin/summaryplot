    print('summary.global_quantities.current_bootstrap.value could not be read', file=sys.stderr)
    summary.global_quantities.current_bootstrap.value = asarray([nan]*ntime)

# V_loop waveform
if len(summary.global_quantities.v_loop.value) < 1:
    print('summary.global_quantities.v_loop.value could not be read', file=sys.stderr)
    summary.global_quantities.v_loop.value = asarray([nan]*ntime)

# Beta_tor_norm waveform
if len(summary.global_quantities.beta_tor_norm.value) < 1:
    print('summary.global_quantities.beta_tor_norm.value could not be read', file=sys.stderr)
    summary.global_quantities.beta_tor_norm.value = asarray([nan]*ntime)

