# to be completed when data model extended (summary IDS)
p_neut = asarray([0]*ntime)


# H-mode flag
def indices(a, func):
    return [i for (i, val) in enumerate(a) if func(val)]

# Create the dictionary defining the list of waveforms (central values) that can be displayed
waveform = {}
waveform['time'] = timevec
waveform['ip'] = summary.global_quantities.ip.value
waveform['current_non_inductive'] = summary.global_quantities.current_non_inductive.value
waveform['current_bootstrap'] = summary.global_quantities.current_bootstrap.value
waveform['v_loop'] = summary.global_quantities.v_loop.value
waveform['beta_tor_norm'] = summary.global_quantities.beta_tor_norm.value
waveform['beta_pol'] = summary.global_quantities.beta_pol.value
waveform['energy_diamagnetic'] = summary.global_quantities.energy_diamagnetic.value
waveform['energy_mhd'] = summary.global_quantities.energy_mhd.value
waveform['current_ohm'] = summary.global_quantities.current_ohm.value
waveform['energy_total'] = summary.global_quantities.energy_total.value
waveform['energy_thermal'] = summary.global_quantities.energy_thermal.value
waveform['b0'] = summary.global_quantities.b0.value
waveform['h_98'] = summary.global_quantities.h_98.value
waveform['tau_energy'] = summary.global_quantities.tau_energy.value
waveform['h_mode'] = summary.global_quantities.h_mode.value
waveform['p_hcd'] = p_hcd
waveform['p_ec'] = p_ec
waveform['p_ic'] = p_ic
waveform['p_nbi'] = p_nbi
waveform['p_lh'] = p_lh
waveform['p_fusion'] = p_fus
waveform['p_neutron'] = p_neut
waveform['p_ohmic'] = p_ohmic
waveform['p_steady'] = p_steady

h_mode_indices  = indices(waveform['h_mode'], lambda h_mode_flag: h_mode_flag>0)
if len(h_mode_indices) > 0:
    hmode = 1
    th_min = timevec[h_mode_indices[0]]
    th_max = timevec[h_mode_indices[len(h_mode_indices)-1]]
else:
    hmode = 0

# ----------------------------------------------------------------------

# Tick size and X and Y axes
ticksize = 12
fontsize = 12

# Font definition
font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}

# Frame configuration
nline = 4
ncol  = 1
legx_pos = 1.20
legy_pos = 1.05

# Plot signature
def Signature(hostdir,shot,run,plt):
    ax = plt.gca()
    xmin, xmax = ax.get_xlim()
    ymin, ymax = ax.get_ylim()
    #plt.text(xmax+0.01*abs(xmax),ymax,hostdir[:-2]+' - Shot '+str(shot)+' / '+' Run '+str(run),fontsize=6,rotation=90)
    plt.text(xmax+0.01*abs(xmax-xmin)+0.01, ymin+0.03*abs(ymax-ymin), '%s/%s/%s' % (hostdir,shot,run), fontsize=5, rotation=90)
    return

# Legend customization
def CustomLegend_wf(legend,fontsize):
    frame = legend.get_frame()
    frame.set_facecolor('0.95')
    for label in legend.get_texts():
        label.set_fontsize(fontsize)
    for label in legend.get_lines():
        label.set_linewidth(1.5)  # the legend line width
    return

def CustomLegend_pr(legend):
    frame = legend.get_frame()
    frame.set_facecolor('0.95')
    for label in legend.get_texts():
        label.set_fontsize(7)
    for label in legend.get_lines():
        label.set_linewidth(1.5)  # the legend line width
    return

# Plot customization
def nice(plt,x_label_string,y_label_string,fontsize):
    font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}
    plt.xticks(fontsize = ticksize)
    plt.yticks(fontsize = ticksize)
    plt.xlabel(x_label_string, fontdict=font, labelpad = 5)
    plt.ylabel(y_label_string, fontdict=font, labelpad = 0)
    plt.grid()
    if len(x_label_string) < 1:
        plt.tick_params(axis='x',which='both',bottom='off',top='off',labelbottom='off')

def hmode_display(plot,thmin,thmax):
    ymin = plot.gca().get_ylim()[0]
    ymax = plot.gca().get_ylim()[1]
    fill([th_min,th_max,th_max,th_min],[ymin,ymin,ymax,ymax],\
         'lightyellow',  edgecolor='k',linewidth=0.08,label=r'$H_{mode}$')
    plt.gca().set_ylim(ymin,ymax)
    return

# ----------------------------------------------------------------------
#print(waveform)

# Display the figure
plt.figure()

single_style='o'
multi_style='-'
plotstyle = multi_style if len(waveform['time']) > 1 else single_style
# H&CD waveforms
ax1 = plt.subplot2grid((nline,ncol), (0,0))
nleg = 0
if max(waveform['p_hcd']) > 0:
    plt.plot(waveform['time'],waveform['p_hcd'],plotstyle,label=r'$P_{HCD}$')
