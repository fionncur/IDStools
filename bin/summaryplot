if summary.tag.name != '':
    additional_data = json.loads(summary.tag.name)
    plt.suptitle('%s / %s / %s / %s / %s\nprovider=%s, shot_date=%s, shot_time=%s\ndata_dictionary=%s, access_layer=%s' % (user_or_path, database, version, shot, run, summary.ids_properties.provider, additional_data['date'], additional_data['time'], summary.ids_properties.version_put.data_dictionary, summary.ids_properties.version_put.access_layer))
else:
    plt.suptitle('%s / %s / %s / %s / %s\nprovider=%s, creation_date=%s\ndata_dictionary=%s, access_layer=%s' % (user_or_path, database, version, shot, run, summary.ids_properties.provider, summary.ids_properties.creation_date, summary.ids_properties.version_put.data_dictionary, summary.ids_properties.version_put.access_layer))

fig = plt.gcf()
fig.set_size_inches(10,8)
fig.subplots_adjust(left=None, bottom=None, right=0.8, top=None, wspace=0., hspace=0.1)
for ax in [ax1, ax2, ax3]:
    plt.setp(ax.get_xticklabels(), visible=False)
    # The y-ticks will overlap with "hspace=0", so we'll hide the bottom tick
    ax.set_yticks(ax.get_yticks()[1:])  

try:
    fig.savefig('summary_%s_%s_%s_%s_%s.png' % (user_or_path, database, version, shot, run), dpi=100)
    print('----> Figure saved to summary_%s_%s_%s_%s_%s.png' % (user_or_path, database, version, shot, run), file=sys.stderr)
except:
    print('The figure could not be saved (check local permissions).', file=sys.stderr)

plt.show()
