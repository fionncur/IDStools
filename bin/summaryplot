# ----------------------------------------------------------------------

def find_nearest(a, a0):
    'Element in nd array `a` closest to the scalar value `a0`'
    idx = abs(a - a0).argmin()
    return a.flat[idx],idx

# ----------------------------------------------------------------------

# Management of input arguments
parser = argparse.ArgumentParser(description=\
    '---- Display data from the summary IDS')
parser.add_argument('-u','--user_or_path',help='User or absolute path name of the DB where the data-entry is located', required=False)
parser.add_argument('-d','--database',"-m", help='Database name of the targeted data-entry', required=False)
parser.add_argument('-s','--shot',help='Shot number', required=True,type=int)
parser.add_argument('-r','--run',help='Run number',required=True,type=int)
parser.add_argument('-t','--time',help='Time', required=False,type=float)
parser.add_argument('-a','--ascii',help='ASCII backend', required=False, action='store_const', const=imas.imasdef.ASCII_BACKEND, default=imas.imasdef.MDSPLUS_BACKEND)
args = vars(parser.parse_args())

IMAS_BACKEND = args['ascii']
print(IMAS_BACKEND)

# For execution from python shell
#args = {'run': 6, 'database': None, 'user_or_path': None, 'time': None, 'shot': 4321}

shot = args['shot']
run  = args['run']

# User or absolute path name
if args['user_or_path'] != None:
    user_or_path = args['user_or_path']
else:
    user_or_path = 'public'

# Database name
if args['database'] != None:
    database = args['database']
else:
    database = 'iterdb'

# Time
if args['time'] != None:
    time = args['time']
else:
    time = -99.

# Open the database and read the necessary IDSs

version = os.getenv('IMAS_VERSION')[0]
IDS = imas.DBEntry(IMAS_BACKEND, database, shot, run, user_name=user_or_path, data_version=version)
[err,n] = IDS.open()

#input=imas.ids(shot,run)
#[err,n]=input.open_env(user_or_path,database,version,silent=True)
if err != 0:
    print('Shot ' + str(shot) + ', run ' + str(run) +' for user_or_path = '+user_or_path+' and database = '+database+' does not exist', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

if user_or_path == 'public':
    DB_ABS_PATH = '/work/imas/shared/'+str(database)+'/3/0'
else:
    DB_ABS_PATH = os.path.expanduser("~{}".format(user_or_path))+"/public/imasdb/"+str(database)+"/3/0"

try:
    summary = IDS.get('summary')
except:
    print('The summary IDS is absent from the input data-entry', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
