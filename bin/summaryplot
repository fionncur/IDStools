# H&CD power
p_ec  = asarray([0]*ntime)
p_ic  = asarray([0]*ntime)
p_nbi = asarray([0]*ntime)
p_lh  = asarray([0]*ntime)
n_ec  = len(summary.heating_current_drive.ec)
n_ic  = len(summary.heating_current_drive.ic)
n_nbi = len(summary.heating_current_drive.nbi)
n_lh  = len(summary.heating_current_drive.lh)
if n_ec > 0:
    for isource in range(n_ec):
        if len(summary.heating_current_drive.ec[isource].power.value) > 0:
            p_ec = p_ec + summary.heating_current_drive.ec[isource].power.value*1.e-6
else:
    if len(summary.heating_current_drive.power_ec.value) > 0:
        p_ec = summary.heating_current_drive.power_ec.value*1.e-6

if n_ic > 0:
    for isource in range(n_ic):
        if len(summary.heating_current_drive.ic[isource].power.value) > 0:
            p_ic = p_ic + summary.heating_current_drive.ic[isource].power.value*1.e-6
else:
    if len(summary.heating_current_drive.power_ic.value) > 0:
        p_ic = summary.heating_current_drive.power_ic.value*1.e-6

if n_nbi > 0:
    for isource in range(n_nbi):
        if len(summary.heating_current_drive.nbi[isource].power.value) > 0:
            p_nbi = p_nbi + summary.heating_current_drive.nbi[isource].power.value*1.e-6
else:
    if len(summary.heating_current_drive.power_nbi.value) > 0:
        p_nbi = summary.heating_current_drive.power_nbi.value*1.e-6

if n_lh > 0:
    for isource in range(n_lh):
        if len(summary.heating_current_drive.lh[isource].power.value) > 0:
            p_lh = p_lh + summary.heating_current_drive.lh[isource].power.value*1.e-6
else:
    if len(summary.heating_current_drive.power_lh.value) > 0:
        p_nbi = summary.heating_current_drive.power_lh.value*1.e-6

p_hcd = p_ec + p_ic + p_nbi + p_lh

# Fusion power
p_fus = asarray([0]*ntime)
if len(summary.fusion.power.value) > 0:
    p_fus = summary.fusion.power.value*1.e-6

# Ohmic power
p_ohmic = asarray([0]*ntime)
if len(summary.global_quantities.power_ohm.value) > 0:
    p_ohmic = summary.global_quantities.power_ohm.value*1.e-6

# Steady power
p_steady = asarray([0]*ntime)
if len(summary.global_quantities.power_steady.value) > 0:
