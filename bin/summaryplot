if max(waveform['p_steady']) > 0:
    plt.plot(waveform['time'],waveform['p_steady'],plotstyle,label=r'$P_{STEADY}$')
    nleg = nleg + 1


plt.xlim(timevec[0],timevec[ntime-1])


if hmode == 1: hmode_display(plt,th_min,th_max)
nleg = nleg + 1

nice(plt,'','$P\/[\mathrm{MW}]$',fontsize)
legend = plt.legend(loc='upper right',bbox_to_anchor=(legx_pos,legy_pos),handlelength=1)
