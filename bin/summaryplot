    plt.plot(waveform['time'],waveform['p_neutron'],plotstyle,label=r'$P_{NEUT}$')
    nleg = nleg + 1

if max(waveform['p_ohmic']) > 0:
    plt.plot(waveform['time'],waveform['p_ohmic'],plotstyle,label=r'$P_{OHM}$')
