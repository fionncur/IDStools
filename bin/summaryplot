import matplotlib.pyplot as plt
import matplotlib.ticker as mtick

# Ip waveform
if len(summary.global_quantities.ip.value) < 1:
    print('summary.global_quantities.ip.value could not be read', file=sys.stderr)
    summary.global_quantities.ip.value = asarray([nan]*ntime)

# Current_non_inductive waveform
if len(summary.global_quantities.current_non_inductive.value) < 1:
    summary.global_quantities.current_non_inductive.value = asarray([nan]*ntime)

