#!/usr/bin/env python
from __future__ import print_function

import os, sys, glob, yaml, argparse, re, imas
from operator import itemgetter
from stat import *
from numpy import *

# ----------------------------------------------------------------------

def find_nearest(a, a0):
    'Element in nd array `a` closest to the scalar value `a0`'
    idx = abs(a - a0).argmin()
    return a.flat[idx],idx

# ----------------------------------------------------------------------

# Management of input arguments
parser = argparse.ArgumentParser(description=\
    '---- Display the plasma kinetic profiles from the core_profiles IDSs')
parser.add_argument('-u','--user_or_path',help='User or absolute path name of the DB where the data-entry is located', required=False)
parser.add_argument('-d','--database',help='Database name of the targeted data-entry', required=False)
parser.add_argument('-s','--shot',help='Shot number', required=True,type=int)
parser.add_argument('-r','--run',help='Run number',required=True,type=int)
parser.add_argument('-t','--time',help='Time', required=False,type=float)
args = vars(parser.parse_args())

# For execution from python shell
#args = {'run': 0, 'database': None, 'user_or_path': None, 'time': None, 'shot': 121003}

shot = args['shot']
run  = args['run']

# User or absolute path name
if args['user_or_path'] != None:
    user_or_path = args['user_or_path']
else:
    user_or_path = 'public'

# Database name
if args['database'] != None:
    database = args['database']
else:
    database = 'iterdb'

# Time
if args['time'] != None:
    time = args['time']
else:
    time = -99.

# -----------------------------------------------
# Open the database and read the necessary IDSs
# -----------------------------------------------
version = os.getenv('IMAS_VERSION')[0]
input=imas.ids(shot,run)
[err,n]=input.open_env(user_or_path,database,version,silent=True)
if err != 0:
    print('Shot ' + str(shot) + ', run ' + str(run) +' for user_or_path = '+user_or_path+' and database = '+database+' does not exist', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

if user_or_path == 'public':
    DB_ABS_PATH = '/work/imas/shared/'+str(database)+'/3/0'
else:
    DB_ABS_PATH = os.path.expanduser("~{}".format(user_or_path))+"/public/imasdb/"+str(database)+"/3/0"

try:
    #input.core_profiles.get()
    core_profiles = input.core_profiles
    core_profiles.time=input.core_profiles.partialGet('time')
    if core_profiles.time is None:
        print('No core_profiles IDS in the data-entry --> Abort.', file=sys.stderr)
        exit()
except:
    print('The core_profiles IDS is absent from the input data-entry', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

hostdir = os.environ["HOSTNAME"]+":"+DB_ABS_PATH
hostdir = hostdir[:-2]

# ----------------------------------------------------------------------

# -------------------------------------------
# Search for adequate time slice for display
# -------------------------------------------
ntime = len(core_profiles.time)
timevec = core_profiles.time
if ntime >= 1:
    if time >= 0:
        [tc,it] = find_nearest(timevec,time)
    else:
        it = int(ntime/2)
        tc = timevec[it]
    time = tc
    if ntime > 1:
        print('   Time  = '+'%.2f' % tc+' s in range ['+'%.2f' % timevec[0]+','+'%.2f' % timevec[ntime-1]+'] s', file=sys.stderr)
        print('   Index = ',str(it), file=sys.stderr)
        print('   Averaged resolution = ', (timevec[ntime-1]-timevec[0])/(ntime-1),' s', file=sys.stderr)
    else:
        print('   Time  = '+'%.2f' % tc+' s', file=sys.stderr)
else:
    if len(timevec) > 0:
        tc = timevec[0]
    else:
        tc = 0
    it = 0

time = tc

# -------------------------------------
# Read 1D-profiles for this time slice
# -------------------------------------
core_profiles.profiles_1d.resize(1)
core_profiles.profiles_1d[0] = input.core_profiles.partialGet('profiles_1d('+str(it)+')')

# ----------------------------------------------------------------------

# ------------------------
# Rho profile (mandatory)
# ------------------------
nrho=0
try:
    rho_tor_norm = core_profiles.profiles_1d[0].grid.rho_tor_norm
    nrho = len(rho_tor_norm)
    if nrho == 0:
        if len(core_profiles.profiles_1d[0].grid.rho_tor)>0:
            nrho = len(core_profiles.profiles_1d[0].grid.rho_tor)
            rho_tor_norm = core_profiles.profiles_1d[0].grid.rho_tor/core_profiles.profiles_1d[0].grid.rho_tor_norm
except:
    print('core_profiles.profiles_1d[0].grid.rho_tor/core_profiles.profiles_1d[0].grid.rho_tor_norm) could not be read', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

if nrho==0:
    print('core_profiles.profiles_1d[0].grid.rho_tor/core_profiles.profiles_1d[0].grid.rho_tor_norm) is empty', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()
if nrho==0:
    print('core_profiles.profiles_1d[0].grid.rho_tor_norm and rho_tor are empty', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

# ------------------------------
# Volume profile (not mandatory)
# ------------------------------
try:
    volume = core_profiles.profiles_1d[0].grid.volume
except:
    print('core_profiles.profiles_1d[0].grid.volume could not be read', file=sys.stderr)

# ---------------------------------------------
# General tests whether variables exist or not
# ---------------------------------------------

nions = len(core_profiles.profiles_1d[0].ion)
if len(core_profiles.profiles_1d[0].ion[0].pressure) < 1:
    print('core_profiles.profiles_1d[0].ion[0].pressure could not be read', file=sys.stderr)
    for iion in range(nions):
        core_profiles.profiles_1d[0].ion[iion].pressure = asarray([nan]*nrho)

if len(core_profiles.profiles_1d[0].ion[0].pressure_thermal) < 1:
    print('core_profiles.profiles_1d[0].ion[0].pressure_thermal could not be read', file=sys.stderr)
    for iion in range(nions):
        core_profiles.profiles_1d[0].ion[iion].pressure_thermal = asarray([nan]*nrho)

if len(core_profiles.profiles_1d[0].ion[0].pressure_fast_parallel) < 1:
    print('core_profiles.profiles_1d[0].ion[0].pressure_fast_parallel could not be read', file=sys.stderr)
    for iion in range(nions):
        core_profiles.profiles_1d[0].ion[iion].pressure_fast_parallel = asarray([nan]*nrho)

if len(core_profiles.profiles_1d[0].ion[0].pressure_fast_perpendicular) < 1:
    print('core_profiles.profiles_1d[0].ion[0].pressure_fast_perpendicular could not be read', file=sys.stderr)
    for iion in range(nions):
        core_profiles.profiles_1d[0].ion[iion].pressure_fast_perpendicular = asarray([nan]*nrho)

if len(core_profiles.profiles_1d[0].electrons.pressure) < 1:
    print('core_profiles.profiles_1d[0].electrons.pressure could not be read', file=sys.stderr)
    core_profiles.profiles_1d[0].electrons.pressure = asarray([nan]*nrho)

if len(core_profiles.profiles_1d[0].electrons.pressure_thermal) < 1:
    print('core_profiles.profiles_1d[0].electrons.pressure_thermal could not be read', file=sys.stderr)
    core_profiles.profiles_1d[0].electrons.pressure_thermal = asarray([nan]*nrho)

if len(core_profiles.profiles_1d[0].electrons.pressure_fast_parallel) < 1:
    print('core_profiles.profiles_1d[0].electrons.pressure_fast_parallel could not be read', file=sys.stderr)
    core_profiles.profiles_1d[0].electrons.pressure_fast_parallel = asarray([nan]*nrho)

if len(core_profiles.profiles_1d[0].electrons.pressure_fast_perpendicular) < 1:
    print('core_profiles.profiles_1d[0].electrons.pressure_fast_perpendicular could not be read', file=sys.stderr)
    core_profiles.profiles_1d[0].electrons.pressure_fast_perpendicular = asarray([nan]*nrho)

if len(core_profiles.profiles_1d[0].pressure_thermal) < 1:
    print('core_profiles.profiles_1d[0].pressure_thermal could not be read', file=sys.stderr)
    core_profiles.profiles_1d[0].pressure_thermal = asarray([nan]*nrho)

if len(core_profiles.profiles_1d[0].pressure_parallel) < 1:
    print('core_profiles.profiles_1d[0].pressure_parallel could not be read', file=sys.stderr)
    core_profiles.profiles_1d[0].pressure_parallel = asarray([nan]*nrho)

if len(core_profiles.profiles_1d[0].pressure_perpendicular) < 1:
    print('core_profiles.profiles_1d[0].pressure_perpendicular could not be read', file=sys.stderr)
    core_profiles.profiles_1d[0].pressure_perpendicular = asarray([nan]*nrho)

# ----------------------------------------------------------------------------------------

# ----------------------------------------------------------------------
# Total variables may be filled: in which case, we use them, otherwise
# we sum up on what we can (ions, electrons+ions, etc.)
# ----------------------------------------------------------------------

if len(core_profiles.profiles_1d[0].pressure_ion_total) > 1:
    pressure_ion_total = core_profiles.profiles_1d[0].pressure_ion_total
else:
    print('core_profiles.profiles_1d[0].pressure_ion_total could not be read', file=sys.stderr)
    if len(core_profiles.profiles_1d[0].ion[0].pressure) > 1:
        pressure_ion_total = 0.
        for iion in range(nions):
            pressure_ion_total = pressure_ion_total + core_profiles.profiles_1d[0].ion[iion].pressure
    else:
        print('core_profiles.profiles_1d[0].ion[0].pressure could not be read', file=sys.stderr)
        pressure_ion_total = asarray([nan]*nrho)

pressure_ion_thermal            = 0.
pressure_ion_fast_parallel      = 0.
pressure_ion_fast_perpendicular = 0.
for iion in range(nions):
    pressure_ion_thermal             = pressure_ion_thermal            + core_profiles.profiles_1d[0].ion[iion].pressure_thermal
    pressure_ion_fast_parallel       = pressure_ion_fast_parallel      + core_profiles.profiles_1d[0].ion[iion].pressure_fast_parallel
    pressure_ion_fast_perpendicular  = pressure_ion_fast_perpendicular + core_profiles.profiles_1d[0].ion[iion].pressure_fast_perpendicular

pressure_electron_total              = core_profiles.profiles_1d[0].electrons.pressure
pressure_electron_thermal            = core_profiles.profiles_1d[0].electrons.pressure_thermal
pressure_electron_fast_parallel      = core_profiles.profiles_1d[0].electrons.pressure_fast_parallel
pressure_electron_fast_perpendicular = core_profiles.profiles_1d[0].electrons.pressure_fast_perpendicular

pressure_total         = pressure_ion_total + pressure_electron_total
pressure_thermal       = core_profiles.profiles_1d[0].pressure_thermal
pressure_parallel      = core_profiles.profiles_1d[0].pressure_parallel
pressure_perpendicular = core_profiles.profiles_1d[0].pressure_perpendicular

# ----------------------------------------------------------------------

import matplotlib
if 'DISPLAY' not in os.environ:
    matplotlib.use('agg')
else:
    matplotlib.use('TKagg')
import matplotlib.pyplot as plt
import matplotlib.ticker as mtick

# Tick size and X and Y axes
ticksize = 12
fontsize = 12

# Font definition
font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}

# Frame configuration
nline = 3
ncol  = 8
legx_pos = 1.35
legy_pos = 1.05

# Plot signature
def Signature(hostdir,shot,run,plt):
    ax = plt.gca()
    xmin, xmax = ax.get_xlim()
    ymin, ymax = ax.get_ylim()
    #plt.text(xmax+0.01*abs(xmax),ymax-0.03*abs(ymax-ymin),hostdir[:-2]+' - Shot '+str(shot)+' / '+' Run '+str(run),fontsize=6,rotation=90)
    plt.text(xmax+0.01*abs(xmax-xmin)+0.01,ymax-0.03*abs(ymax-ymin),'Shot '+str(shot)+' / '+' Run '+str(run),fontsize=5,rotation=90)
    return

# Legend customization
def CustomLegend_wf(legend):
    frame = legend.get_frame()
    frame.set_facecolor('0.95')
    for label in legend.get_texts():
        label.set_fontsize(7)
    for label in legend.get_lines():
        label.set_linewidth(1.5)  # the legend line width
    return

def CustomLegend_pr(legend):
    frame = legend.get_frame()
    frame.set_facecolor('0.95')
    for label in legend.get_texts():
        label.set_fontsize(7)
    for label in legend.get_lines():
        label.set_linewidth(1.5)  # the legend line width
    return

# Plot customization
def nice(plt,x_label_string,y_label_string,fontsize):
    font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}
    plt.xticks(fontsize = ticksize)
    plt.yticks(fontsize = ticksize)
    plt.xlabel(x_label_string, fontdict=font, labelpad = 1)
    plt.ylabel(y_label_string, fontdict=font, labelpad = 0)
    plt.grid()
    if len(x_label_string) < 1:
        plt.tick_params(axis='x',which='both',bottom='off',top='off',labelbottom='off')

def time_display(plot,time):
    ymin = plot.gca().get_ylim()[0]
    ymax = plot.gca().get_ylim()[1]
    plot.plot([time,time],[ymin,ymax],color='gray',linestyle='--',linewidth=2,label=r'$t_{slice}$')
    plt.gca().set_ylim(ymin,ymax)

# ----------------------------------------------------------------------

# Minima and maxima calculations for plots
max_tot = max(nan_to_num(max(pressure_total[0:nrho-1])),nan_to_num(max(pressure_thermal[0:nrho-1])),nan_to_num(max(pressure_parallel[0:nrho-1])),nan_to_num(max(pressure_perpendicular[0:nrho-1])))
max_ion = max(nan_to_num(max(pressure_ion_thermal[0:nrho-1])),nan_to_num(max(pressure_ion_fast_parallel[0:nrho-1])),nan_to_num(max(pressure_ion_fast_perpendicular[0:nrho-1])))
max_el  = max(nan_to_num(max(pressure_electron_total[0:nrho-1])),nan_to_num(max(pressure_electron_thermal[0:nrho-1])),nan_to_num(max(pressure_electron_fast_parallel[0:nrho-1])),nan_to_num(max(pressure_electron_fast_perpendicular[0:nrho-1])))

max_tot = max_tot * 1.1
max_ion = max_ion * 1.1
max_el  = max_el  * 1.1

if max_tot == 0:
    print('No pressure profile found --> Abort.', file=sys.stderr)
    exit()

# ----------------------------------------------------------------------

nline = 3
ncol = 2

import matplotlib
if 'DISPLAY' not in os.environ:
    matplotlib.use('agg')
else:
    matplotlib.use('TKagg')

# Display the figure
plt.figure()
#plt.ion()

ax1 = plt.subplot2grid((nline,ncol), (0,0), colspan=1)
factor=1.e-6
plt.plot(rho_tor_norm,pressure_total*factor,label='Total')
plt.plot(rho_tor_norm,pressure_thermal*factor,label='Thermal')
plt.plot(rho_tor_norm,pressure_parallel*factor,label='Parallel')
plt.plot(rho_tor_norm,pressure_perpendicular*factor,label='Pperpendicular')
plt.xlim(rho_tor_norm[0],rho_tor_norm[nrho-1])
plt.ylim(0,max_tot*factor)
nice(plt,r'$\rho/\rho_0$',r'P (MPa)',fontsize)
legend = plt.legend(bbox_to_anchor=(legx_pos-0.3,legy_pos-0.05))
CustomLegend_wf(legend)
plt.title('Profiles displayed for t = '+'%.1f' % time+' s', fontdict=font)
Signature(hostdir,shot,run,plt)

ax2 = plt.subplot2grid((nline,ncol), (1,0), colspan=1)
plt.plot(rho_tor_norm,pressure_ion_thermal*factor,label='Thermal ion')
plt.plot(rho_tor_norm,pressure_ion_fast_parallel*factor,label='Fast parallel ion')
plt.plot(rho_tor_norm,pressure_ion_fast_perpendicular*factor,label='Fast perpendicular ion')
plt.ylim(0,max_ion*factor)
nice(plt,r'$\rho/\rho_0$',r'P (MPa)',fontsize)
legend = plt.legend(bbox_to_anchor=(legx_pos+0.4,legy_pos-0.05))
CustomLegend_wf(legend)
Signature(hostdir,shot,run,plt)

ax3 = plt.subplot2grid((nline,ncol), (2,0), colspan=1)
plt.plot(rho_tor_norm,pressure_electron_total*factor,label='Total electron')
plt.plot(rho_tor_norm,pressure_electron_thermal*factor,label='Thermal electron')
plt.plot(rho_tor_norm,pressure_electron_fast_parallel*factor,label='Fast parallel electron')
plt.plot(rho_tor_norm,pressure_electron_fast_perpendicular*factor,label='Fast perpendicular electron')
plt.ylim(0,max_el*factor)
nice(plt,r'$\rho/\rho_0$',r'P (MPa)',fontsize)
legend = plt.legend(bbox_to_anchor=(legx_pos+0.5,legy_pos-0.05))
CustomLegend_wf(legend)
Signature(hostdir,shot,run,plt)

ax = plt.gca()
xmin, xmax = ax.get_xlim()
ymin, ymax = ax.get_ylim()
plt.text(xmax-0.4*(xmax-xmin),ymin-0.6*(ymax-ymin),hostdir+' - Shot '+str(shot)+' / '+' Run '+str(run), fontdict=font,fontsize=6,color='black')

fig = plt.gcf()
fig.tight_layout()

try:
    fig.savefig('Pressure'+'_shot_'+str(shot)+'_run_'+str(run)+'_time_'+'%.1f' % time+'.png', dpi=100)
    print('----> Figure saved to '+'Pressure'+'_shot_'+str(shot)+'_run_'+str(run)+'_time_'+'%.1f' % time+'.png', file=sys.stderr)
except:
    print('The figure could not be saved (check local permissions).', file=sys.stderr)

plt.show()


