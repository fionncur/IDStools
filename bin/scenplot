    print('   Time  = '+'%.2f' % tc+' s in range ['+'%.2f' % timevec[0]+','+'%.2f' % timevec[ntime-1]+'] s')
    print('   Index = ',str(it))
    print('   Averaged resolution = ', (timevec[ntime-1]-timevec[0])/(ntime-1),' s')
else:
    if len(timevec) > 0:
        tc = timevec[0]
    else:
        tc = 0
    it = 0

# Read 1D-profiles for this time slice
