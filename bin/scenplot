    version = os.getenv('IMAS_VERSION')[0]
    input = imas.ids(shot,run)
    input.open_env(str(user_or_path),str(database),version)
except:
    print('Shot ' + str(shot) + ', run ' + str(run) + ' does not exist', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

if user_or_path == 'public':
    DB_ABS_PATH = '/work/imas/shared/'+str(database)+'/3/0'
else:
    DB_ABS_PATH = os.path.expanduser("~{}".format(user_or_path))+"/public/imasdb/"+str(database)+"/3/0"

try:
    #input.core_profiles.get()
    core_profiles = input.core_profiles # To inialise the empty IDS structure
    core_profiles.time=input.core_profiles.partialGet('time')
    core_profiles.global_quantities=input.core_profiles.partialGet('global_quantities')
except:
    print('The core_profiles IDS is absent from the input data-entry', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

try:
    #input.equilibrium.get()
    equilibrium = input.equilibrium # To inialise the empty IDS structure
except:
    print('The equilibrium IDS is absent from the input data-entry', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

try:
    input.summary.get()
