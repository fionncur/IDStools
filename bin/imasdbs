#!/usr/bin/env python

# @author: H.-J. Klingshirn
from __future__ import print_function
import optparse
import idstools.db_tools as dbtools
import os
import sys

TAB = ' ' * 3
SHOT_STR_LEN = 5
RUN_STR_LEN = 5
TOKAMAK_STR_LEN = 12
VERSION_STR_LEN = 6
IDSNAME_STR_LEN = 15
SLICENUM_STR_LEN = 4
RUNNUM_STR_LEN = 4
TIME_STR_LEN = 4

def extended(str, wlen):
    l = len(str)
    if l < wlen:
        return ' ' * (wlen - l) + str
    else:
        return str

def print_vector(vec, wlen):
    return "".join( [extended(str(x), wlen) for x in vec] )

def print_list(dbs, shotnum = None, compact = False):
    for tokamak, dvs in dbs:
        printed_tokamak = False
        for dv, dbbackends in dvs:
            printed_dataversion = False
            for backend, dbs in dbbackends:
                printed_backend = False
                for shot, runs in dbs:
                    if shotnum is not None:
                        # if a shotnum is given, only display databases with this shot number
                        if shot != shotnum:
                            continue

                    if not printed_tokamak:
                        print("Tokamak: " + tokamak)
                        printed_tokamak = True
                    if not printed_dataversion:
                        print(TAB + "Data version: " + dv)
                        printed_dataversion = True
                    if not printed_backend:
                        print(TAB * 2 + "UAL Backend: " + backend)
                        printed_backend = True
                    if compact:
                        print(TAB * 3 + "Shot " + extended(str(shot), SHOT_STR_LEN) \
                            + ": " + extended(str(len(runs)), RUNNUM_STR_LEN) + " runs")
                    else:
                        print(TAB * 3 + "Shot " + extended(str(shot), SHOT_STR_LEN) \
                            + " Runs: " + print_vector(runs, RUN_STR_LEN))

def print_times(dbs, opts, printTimes = False, shotnum= None, runnum = None):
    import idstools.ids_tools as ct

    for tokamak, dvs in dbs:
        printed_tokamak = False
        for dv, dbbackends in dvs:
            printed_dataversion = False
            for backend, dbs in dbbackends:
                printed_backend = False
                for shot, runs in dbs:

                    # If a shotnum and/or runnum is given, only display these
                    if shotnum is not None:
                        if shot != shotnum:
                            continue

                    printed_shot = False
                    for run in runs:
                        if runnum is not None:
                            if run != runnum:
                                continue

                        if not printed_tokamak:
                            print("Tokamak: " + tokamak)
                            printed_tokamak = True
                        if not printed_dataversion:
                            print(TAB + "Data version: " + dv)
                            printed_dataversion = True
                        if not printed_backend:
                            print(TAB * 2 + "UAL Backend: " + backend)
                            printed_backend = True
                        if not printed_shot:
                            print(TAB * 3 + "Shot " + extended(str(shot), SHOT_STR_LEN))
                            printed_shot = True

                        print(TAB * 4 + " Run: " + extended(str(run), RUN_STR_LEN))
                        db = ct.ImasDb(shot, run, opts.user, tokamak, dv, True, backend == "hdf5")
                        alltimes = db.all_times()
                        for idsname, times in alltimes:
                            if printTimes:
                                print(TAB * 5 + extended(idsname, IDSNAME_STR_LEN) + ": "\
                                        + extended(str(len(times)), SLICENUM_STR_LEN) + " slices (" \
                                        + print_vector(times, TIME_STR_LEN) + ")")
                            else:
                                print(TAB * 5 + extended(idsname, IDSNAME_STR_LEN) + ": " \
                                        + extended(str(len(times)), SLICENUM_STR_LEN) + " slices ("\
                                        + extended(str(times[0]), TIME_STR_LEN) + " - " \
                                        + extended(str(times[-1]), TIME_STR_LEN) + ")")

                        db.close()

p = optparse.OptionParser(usage = "%prog [OPTIONS] [COMMAND]\n\
\n\
This program lists existing IMAS databases.\n\
\n\
Possible commands are: \n\
\tlist <shot number>- list existing databases \n\
\tslices <shot number> <run number> - list existing databases, including number of timeslices and time range for time-dependent IDSs\n\
\ttimes <shot number> <run number> - list existing databases, including number of timeslices their time points for time-dependent IDSs \n\
\ttokamak - list existing tokamaks (with data versions)\n\
\tdataversion - list existing dataversions (with tokamaks)\n\
\n\
If the optional arguments shot number and run number are given, only databases with these numbers will be shown.\n\
\n\
If no command is given, the list command is performed. \n\
\n\
To see databases stored in the public imas database, use 'public' as the user name.\
")
p.add_option("-u", "--user", dest="user", default=None, help = "Show databases of specified user")
p.add_option("-t", "--tokamak", dest="tokamak", default=None, help = "Show only databases for specified tokamaks")
p.add_option("-v", "--version", dest="version", default=None, help = "Show only databases for specified data version")
p.add_option("--backend", dest="backend", default=None, help = "Show databases written with given backend(s). \n\
Comma-separated list of backends (Currently supported: mdsplus, hdf5). By default all backends are shown.")
p.add_option("-c", "--compact", action="store_true", dest="compact", default=False, help = "Compact/reduced output")

opts, args = p.parse_args()

if not args or args[0] == "list" or args[0] == "slices" or args[0] == "times":
    # Default action: show databases
    shotnum = None
    if len(args) > 1:
        try:
            shotnum = int(args[1])
        except:
            print("Second argument must be an integer",file=sys.stderr)
            sys.exit(1)

    runnum = None
    if len(args) > 2:
        try:
            runnum = int(args[2])
        except:
            print("Third argument must be an integer",file=sys.stderr)
            sys.exit(1)

    if len(args) > 0 and (args[0] == "slices" or args[0] == "times"):
        envdv = os.getenv("DATAVERSION")
        if opts.version is not None and envdv != opts.version:
            print("Cannot access IDS times for data version differing from current $DATAVERSION",file=sys.stderr)
            sys.exit(1)

    if opts.backend:
        backends = opts.backend.split(',')
    else:
        backends = None

    dbs = dbtools.list_databases(opts.user, opts.tokamak, opts.version, backends)

    if args and args[0] == "slices":
        print_times(dbs, opts, printTimes = False, shotnum = shotnum, runnum = runnum)
    elif args and args[0] == "times":
        print_times(dbs, opts, printTimes = True, shotnum = shotnum, runnum = runnum)
    else:
        print_list(dbs, shotnum, opts.compact)

elif args[0] == "tokamaks":
    for tokamak, dvs in dbtools.list_tokamaks(opts.user, opts.version):
        print(extended(tokamak, TOKAMAK_STR_LEN) + " " + print_vector(dvs, VERSION_STR_LEN))

elif args[0] == "dataversions":
    for dv, tokamaks in dbtools.list_dataversions(opts.user):
        print(extended(dv, VERSION_STR_LEN) + " " + print_vector(tokamaks, TOKAMAK_STR_LEN))

else:
    print("Unknown command: " + args[0] + ". Possible commands are (none), list, tokamaks")
