#!/usr/bin/env python
from sys import exit
import os
import argparse
import datetime
import numpy as np
from collections import OrderedDict
from fortranformat import FortranRecordReader
from pprint import pformat
import textwrap
import logging

import imas
from database_tools import idschk
from database_tools.idschk import *
from idstools.cli import *


# ----------------------------------------------------------------------


class GEQDSK:
    """
    GEQDSK module for IMAS

    [1] L. Lao, "G EQDSK FORMAT", https://w3.pppl.gov/ntcc/TORAY/G_EQDSK.pdf

    Attributes
    ----------
    fpath: str
        Path to GEQDSK file
    data: OrderedDict
        Information in GEQDSK file
    cocos: COCOS
        Class COCOS computed from input
    coef: dict
        COCOS Transformation coefficients regarding IDS default (COCOS=11)
    """

    def __init__(self, fpath, ipsign_out, b0sign_out):
        """
        Read GEQDSK file and set COCOS transformation coefficients

        Parameters
        ----------
        fpath: str
            Path to GEQDSK file
        ipsign_out: int
            Desired sign(Ip) in output
        b0sign_out: int
            Desired sign(B0) in output
        """

        #
        self.fpath = fpath
        logger.debug("GEQDSK fpath: \n%s",pformat(self.fpath,indent=2))

        self.data = self._load(self.fpath)
        logger.debug("GEQDSK data: \n%s",pformat(self.data,indent=2))

        self.cocos = self._set_cocos(self.data)
        logger.info("GEQDSK COCOS: \n%s",pformat(self.cocos.__dict__,indent=2))

        self.coef = self.cocos.values_coefficients(
            self.cocos.COCOS,
            IDS_COCOS,
            self.data["CURRENT"],
            self.data["BCENTR"],
            ipsign_out,
            b0sign_out,
        )
        logger.info("GEQDSK Transformation Coeff.: \n%s",pformat(self.coef,indent=2))

    def _load(self, fpath):
        """
        Read GEQDSK

        Parameters
        ----------
        fpath: str
            Path to GEQDSK file

        Returns
        -------
        dict
            Information in GEQDSK file
        """

        if not os.path.exists(fpath):
            exit("file not found: {}".format(fpath))

        if os.stat(fpath).st_size == 0:
            exit("file size error: {}".format(fpath))

        try:
            fp = open(fpath, "r")
        except OSError:
            exit("cannot open/read file: {}".format(fpath))

        fmt00 = FortranRecordReader("6a8,3i4")
        fmt20 = FortranRecordReader("5e16.9")
        fmt22 = FortranRecordReader("2i5")

        data = OrderedDict()

        #
        rec = fmt00.read(fp.readline())
        data["CASE"] = rec[0:6]
        data["IDUM"] = np.int32(rec[6])
        data["NW"] = nw = np.int32(rec[7])
        data["NH"] = nh = np.int32(rec[8])

        #
        rec = np.float64(fmt20.read(fp.readline()))
        data["RDIM"] = rec[0]
        data["ZDIM"] = rec[1]
        data["RCENTR"] = rec[2]
        data["RLEFT"] = rec[3]
        data["ZMID"] = rec[4]

        #
        rec = np.float64(fmt20.read(fp.readline()))
        data["RMAXIS"] = rec[0]
        data["ZMAXIS"] = rec[1]
        data["SIMAG"] = rec[2]
        data["SIBRY"] = rec[3]
        data["BCENTR"] = rec[4]

        #
        rec = np.float64(fmt20.read(fp.readline()))
        data["CURRENT"] = rec[0]
        data["SIMAG"] = rec[1]
        data["XDUM"] = rec[2]
        data["RMAXIS"] = rec[3]
        data["XDUM"] = rec[4]

        #
        rec = np.float64(fmt20.read(fp.readline()))
        data["ZMAXIS"] = rec[0]
        data["XDUM"] = rec[1]
        data["SIBRY"] = rec[2]
        data["XDUM"] = rec[3]
        data["XDUM"] = rec[4]

        #
        data["FPOL"] = self._read1d(fp, nw, fmt20)
        data["PRES"] = self._read1d(fp, nw, fmt20)
        data["FFPRIM"] = self._read1d(fp, nw, fmt20)
        data["PPRIME"] = self._read1d(fp, nw, fmt20)
        data["PSIRZ"] = np.reshape(self._read1d(fp, nw * nh, fmt20), (nh, nw))
        data["QPSI"] = self._read1d(fp, nw, fmt20)

        #
        rec = np.int32(fmt22.read(fp.readline()))
        data["NBBBS"] = nbbbs = rec[0]
        data["LIMITR"] = limitr = rec[1]

        #
        bbbs = np.reshape(self._read1d(fp, 2 * nbbbs, fmt20), (nbbbs, 2))
        data["RBBBS"] = bbbs[:, 0]
        data["ZBBBS"] = bbbs[:, 1]

        #
        lim = np.reshape(self._read1d(fp, 2 * limitr, fmt20), (limitr, 2))
        data["RLIM"] = lim[:, 0]
        data["ZLIM"] = lim[:, 1]

        return data

    def _read1d(self, fp, nlen, fmt):
        """
        Read array with specified format in Fortran

        Parameters
        ----------
        fp: _io.TextIOWrapper
            file pointer
        nlen: int
            length of record
        fmt: FortranRecordReader

        Returns
        -------
        numpy.ndarray, dtype=numpy.float64
        """

        ret = np.zeros(nlen, dtype=np.float64)
        i = 0
        while i < nlen - 1:
            fdata = fmt.read(fp.readline())
            i2 = min(i + len(fdata), nlen)
            ret[i:i2] = fdata[: i2 - i]
            i = i2

        if i < nlen:
            fdata = fmt.read(fp.readline())
            ret[i:] = fdata[: nlen - i]

        return ret

    def _set_cocos(self, g):
        """
        Read array with Fortran format specified

        Parameters
        ----------
        g: dict
            Information of GEQDSK file

        Returns
        -------
        COCOS
            COCOS index and values
        """

        # Sign(Ip) and Sign(B0) from input
        sigma_ip = np.sign(g["CURRENT"])
        sigma_b0 = np.sign(g["BCENTR"])

        # PSIRZ assumed to be divided by 2*pi
        exp_Bp = 0

        # Eq.(22)
        sign_psi_edge_axis = np.sign(g["SIBRY"] - g["SIMAG"])
        sigma_Bp = int(np.sign(sign_psi_edge_axis * sigma_ip))

        # Right-handed cylindrical coordinate system for GEQDSK format
        sigma_RphiZ = int(np.sign(+1))

        # Sign of q profile
        x = g["QPSI"][1:]
        if np.all(np.sign(x) > 0):
            sign_q_pos = int(np.sign(+1))
        elif np.all(np.sign(x) < 0):
            sign_q_pos = int(np.sign(-1))
        else:
            sign_q_pos = int(0)  # raise ValueError in COCOS Class

        # Sign of pprime
        x = g["PPRIME"][1:]
        if np.all(np.sign(x) > 0):
            sign_pprime_pos = int(np.sign(+1))
        elif np.all(np.sign(x) < 0):
            sign_pprime_pos = int(np.sign(-1))
        else:
            sign_pprime_pos = int(np.sign(0))  # raise ValueError in COCOS Class

        # Eq.(22)
        sigma_rhothetaphi = int(np.sign(sign_q_pos * sigma_ip * sigma_b0))

        values = {
            "exp_Bp": exp_Bp,
            "sigma_Bp": sigma_Bp,
            "sigma_RphiZ": sigma_RphiZ,
            "sigma_rhothetaphi": sigma_rhothetaphi,
            "sign_q_pos": sign_q_pos,
            "sign_pprime_pos": sign_pprime_pos,
        }

        return COCOS(values=values)


# ----------------------------------------------------------------------


def map_GEQDSK_to_IDS(geqdsk, eq):
    """
    Convert GEQDSK file into IDS/equilibrium

    Parameters
    ----------
    geqdsk: GEQDSK
        Class GEQDSK
    eq: imas_*_ual_*.equilibrium.equilibrium ('*' corresponds to IMAS/UAL ver.)
        IDS/equilibrium
    """

    def set_timebase(ids):
        """ """

        ids.time.resize(1)
        ids.time[0] = -1.0

    def common_properties(ids):
        """ """

        ids.ids_properties.homogeneous_time = 1
        ids.ids_properties.creation_date = datetime.datetime.now().strftime(
            "%d/%m/%Y %H:%M"
        )
        ids.ids_properties.provider = os.getenv("USER")
        ids.ids_properties.version_put.data_dictionary = os.getenv("IMAS_VERSION")
        ids.ids_properties.version_put.access_layer = os.getenv("UAL_VERSION")
        ids.ids_properties.version_put.access_layer_language = sys.version

        ids.code.name = "IDStools/geqdsk2ids"
        ids.code.repository = "https://git.iter.org/projects/IMAS/repos/idstools/browse"
        ids.code.output_flag.resize(1)
        ids.code.output_flag[0] = 0

    # Abbrev.
    ga = geqdsk.data
    coef = geqdsk.coef

    # IDS info.
    common_properties(eq)

    # Set time
    set_timebase(eq)

    # 0D
    eq.time_slice.resize(1)
    eq.time_slice[0].global_quantities.ip = ga["CURRENT"] * coef["sigma_Ip_eff"]
    eq.time_slice[0].global_quantities.magnetic_axis.r = ga["RMAXIS"]
    eq.time_slice[0].global_quantities.magnetic_axis.z = ga["ZMAXIS"]
    eq.time_slice[0].global_quantities.psi_axis = ga["SIMAG"] * coef["fact_psi"]
    eq.time_slice[0].global_quantities.psi_boundary = ga["SIBRY"] * coef["fact_psi"]

    # vacuume_toroidal_field
    eq.vacuum_toroidal_field.r0 = ga["RCENTR"]
    eq.vacuum_toroidal_field.b0.resize(1)
    eq.vacuum_toroidal_field.b0[0] = ga["BCENTR"] * coef["sigma_B0_eff"]

    # 1D
    nw = ga["NW"]
    nh = ga["NH"]
    eq.time_slice[0].profiles_1d.dpressure_dpsi.resize(nw)
    eq.time_slice[0].profiles_1d.f_df_dpsi.resize(nw)
    eq.time_slice[0].profiles_1d.f.resize(nw)
    eq.time_slice[0].profiles_1d.pressure.resize(nw)
    eq.time_slice[0].profiles_1d.q.resize(nw)
    eq.time_slice[0].profiles_1d.psi.resize(nw)

    eq.time_slice[0].profiles_1d.dpressure_dpsi = ga["PPRIME"] / coef["fact_psi"]
    eq.time_slice[0].profiles_1d.f_df_dpsi = ga["FFPRIM"] / coef["fact_psi"]
    eq.time_slice[0].profiles_1d.f = ga["FPOL"] * coef["sigma_B0_eff"]
    eq.time_slice[0].profiles_1d.pressure = ga["PRES"]
    eq.time_slice[0].profiles_1d.q = ga["QPSI"] * coef["fact_q"]
    simag = ga["SIMAG"]
    sibry = ga["SIBRY"]
    for i in range(nw):
        eq.time_slice[0].profiles_1d.psi[i] = (
            (1.0 - float(i) / float(nw - 1)) * (simag - sibry) + sibry
        ) * coef["fact_psi"]

    # Boundary
    nbbbs = ga["NBBBS"]
    eq.time_slice[0].boundary.outline.r.resize(nbbbs - 1)
    eq.time_slice[0].boundary.outline.z.resize(nbbbs - 1)
    eq.time_slice[0].boundary.outline.r = ga["RBBBS"][:-2]
    eq.time_slice[0].boundary.outline.z = ga["ZBBBS"][:-2]

    # 2D
    eq.time_slice[0].profiles_2d.resize(1)
    eq.time_slice[0].profiles_2d[0].grid_type.index = 1
    eq.time_slice[0].profiles_2d[0].grid.dim1.resize(nw)
    eq.time_slice[0].profiles_2d[0].grid.dim2.resize(nh)
    eq.time_slice[0].profiles_2d[0].psi.resize(nw, nh)
    eq.time_slice[0].profiles_2d[0].r.resize(nw, nh)
    eq.time_slice[0].profiles_2d[0].z.resize(nw, nh)
    for i in range(nw):
        eq.time_slice[0].profiles_2d[0].grid.dim1[i] = (
            float(i) / float(nw - 1) * ga["RDIM"] + ga["RLEFT"]
        )
    for j in range(nh):
        eq.time_slice[0].profiles_2d[0].grid.dim2[j] = (
            float(j) / float(nh - 1) * ga["ZDIM"] - 0.5 * ga["ZDIM"] + ga["ZMID"]
        )
    for j in range(nh):
        for i in range(nw):
            eq.time_slice[0].profiles_2d[0].psi[i, j] = (
                ga["PSIRZ"][j, i] * coef["fact_psi"]
            )
    for j in range(nh):
        for i in range(nw):
            eq.time_slice[0].profiles_2d[0].r[i, j] = (
                eq.time_slice[0].profiles_2d[0].grid.dim1[i]
            )
            eq.time_slice[0].profiles_2d[0].z[i, j] = (
                eq.time_slice[0].profiles_2d[0].grid.dim2[j]
            )

    logger.debug("IDS/equilibrium: \n%s",pformat(eq,indent=2))

# ----------------------------------------------------------------------


def main():
    """
    Converter from GEQDSK to IDS/equilibrium (geqdsk2ids)
    """

    # Read GEQDSK file
    logger.info("[1/3] loading GEQDSK file...")
    geqdsk = GEQDSK(args.fpath, args.ipsign, args.b0sign)

    # Map GEQDSK to IDS/equilibrium
    logger.info("[2/3] mapping to IDS/equilibrium...")
    eq = imas.equilibrium()
    map_GEQDSK_to_IDS(geqdsk, eq)

    # Create the output datafile, save the equilibrium IDS, and close the output datafile
    logger.info("[3/3] creating output datafile...")
    db = imas.DBEntry(
        get_backend_id(args.backend), args.database, args.shot, args.run, args.user
    )
    status, _ = db.create()
    if status != 0:
        exit(
            "can not open backend={}, user_or_path={}, database={}, shot={}, run={}".format(
                args.backend, args.user, args.database, args.shot, args.run
            )
        )
    db.put(eq)
    db.close()
    logger.info("IDS/equilibrium populated in shot/run = {}/{}.".format(args.shot, args.run))


# ----------------------------------------------------------------------


if __name__ == "__main__":
    prog=os.path.basename(__file__)
    parser = argparse.ArgumentParser(
        prog=prog,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        parents=[imas_parser],
        description=textwrap.dedent(
            """\
            File Converter from GEQDSK to IDS/equilibrium ({})
            -----------------------------------------------------------
            Usage:
                1) Load IMAS
                $ module load IMAS

                2) Install fortranformat (if never done)
                $ pip install fortranformat

                3) Create IDS data file in local database
                $ {} -i path_to_gfile -s 12345 -r 1 -u userid -d ITER
            """.format(prog,prog)
        ),
    )
    parser.add_argument(
        "-s", "--shot", dest="shot", help="Shot number", required=True, type=int
    )
    parser.add_argument(
        "-r", "--run", dest="run", help="Run number", required=True, type=int
    )
    parser.add_argument(
        "-i",
        "--input",
        dest="fpath",
        help="path to GEQDSK file",
        required=True,
        default=None,
    )
    parser.add_argument(
        "--verbose",
        help="increase output verbosity",
        required=False,
        default=False,
        action="store_true",
    )
    parser.add_argument(
        "--debug",
        help="debug information",
        required=False,
        default=False,
        action="store_true",
    )
    parser.add_argument(
        "--ipsign",
        dest="ipsign",
        help="desired sign of Ip in output (computes factors to obtain these signs), default=%(default)s uses input",
        required=False,
        type=int,
        default=0,
        choices=[-1, 0, 1],
    )
    parser.add_argument(
        "--b0sign",
        dest="b0sign",
        help="desired sign of B0 in output (computes factors to obtain these signs), default=%(default)s uses input",
        required=False,
        type=int,
        default=0,
        choices=[-1, 0, 1],
    )
    args = parser.parse_args()
     
    logger = logging.getLogger(prog)
    if args.debug:
        logger.setLevel(logging.DEBUG)
    elif args.verbose:
        logger.setLevel(logging.INFO)
    else:
        logger.setLevel(logging.WARNING)
    handler = logging.StreamHandler()
    logger.addHandler(handler)
    logfmt = logging.Formatter('%(asctime)s %(name)s (%(levelname)s): %(message)s')
    handler.setFormatter(logfmt)
     
    try:
        main()
    except SystemExit as e:
        logger.error(str(e))
