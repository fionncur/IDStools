#!/usr/bin/env python
import os
import argparse
import textwrap
import traceback
import re
import time

import imas
from idstools.cli import imas_parser
from database_tools import idschk
from database_tools.set_logger import set_logger
from database_tools.db_validator import db_validator


# ----------------------------------------------------------------------


def main():
    """
    Scenario Validation for IMAS Database
    """

    # Initialize logger
    logger = set_logger(__name__, logfile=args.output, level=args.log)

    # Set validator for given (shot, run), otherwise whole pulses found
    if args.shot and args.run:
        pulse = [(args.shot, args.run)]
    else:
        pulse = []

    logger.info("-----------------------------------------------------------")
    logger.info("START: " + __file__)
    logger.info("-----------------------------------------------------------")
    st = time.time()

    # Validation in IMASDB
    res = db_validator(
        args.user, args.database, args.version, args.backend, args.schema_file, pulse
    )

    et = time.time()
    logger.info("-----------------------------------------------------------")
    logger.info("END")
    logger.info("-----------------------------------------------------------")
    logger.info("Total elapsed time(s): %.2f", et - st)
    logger.info("-----------------------------------------------------------")


# ----------------------------------------------------------------------


if __name__ == "__main__":

    # Parse for command line options
    prog = os.path.basename(__file__)
    parser = argparse.ArgumentParser(
        prog=prog,
        formatter_class=argparse.RawDescriptionHelpFormatter,
        parents=[imas_parser],
        description=textwrap.dedent(
            """\
            Validation Tool for ITER Scenario DB
            -----------------------------------------------------------
            Usage:
                0) Load IMAS and install Cerberus (if not done before)
                $ module load IMAS
                $ pip install cerberus

                1) Validate all pulses in IMAS database to default schemas with output file
                $ {0} -o output.log

                2) Validate all pulses in IMAS database to schemas
                $ {0} -f /path/to/schema1.yaml /path/to/schema2.yaml
 
                3) Validate all pulses in local database to default schemas
                $ {0} -u username -d database 

                4) Validate one pulse in IMAS database to schemas
                $ {0} -s 131024 -r 40 -f /path/to/schema1.yaml /path/to/schema2.yaml
            """.format(
                prog
            )
        ),
    )
    parser.add_argument(
        "--shot", "-s", dest="shot", help="Shot number", required=False, type=int
    )
    parser.add_argument(
        "--run", "-r", dest="run", help="Run number", required=False, type=int
    )
    parser.add_argument(
        "--log",
        dest="log",
        help="Logging level, default=%(default)s",
        required=False,
        default="INFO",
        choices=["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
    )
    parser.add_argument(
        "--output",
        "-o",
        dest="output",
        help="file name of IDS validation, no file output unless given",
        required=False,
        default=None,
    )
    parser.add_argument(
        "--schema_file",
        "-f",
        dest="schema_file",
        help="list of validation schema",
        required=False,
        nargs="+",
        default=[],
    )
    args = parser.parse_args()

    # main()
    try:
        main()
    except Exception as e:
        logger.error(traceback.format_exc())
