#! /usr/bin/env python
### David.Coster@ipp.mpg.de
import numpy as np
import imas
import argparse
import os
import identifiers.constants_module as imas_constants
import matplotlib.pyplot as plt

IMAS_BACKEND = imas.imasdef.MDSPLUS_BACKEND

parser = argparse.ArgumentParser(description="Check match between transport fluxes and a simple calculation", epilog
="""
""", formatter_class=argparse.RawTextHelpFormatter)
parser.add_argument("--user", "-u", type=str, help="user",default=os.getenv("USER"))
parser.add_argument("--tokamak", "-t", "-m", "-d", type=str, help="tokamak",default=os.getenv("TOKAMAKNAME"))
parser.add_argument("--version", "-v", type=str, help="version",default='3')
parser.add_argument("--occurrence", "-o", type=int, help="version",default='0')
parser.add_argument("shot", type=int, help="Shot number")
parser.add_argument("run", type=int, help="Run number")
parser.add_argument("time", type=float, help="Time")
args=parser.parse_args()

IDS = imas.DBEntry(IMAS_BACKEND, args.tokamak, args.shot, args.run, user_name=args.user)
IDS.open()
T = IDS.get_slice('core_transport', args.time, imas.imasdef.CLOSEST_SAMPLE)
C = IDS.get_slice('core_profiles', args.time, imas.imasdef.CLOSEST_SAMPLE)
E = IDS.get_slice('equilibrium', args.time, imas.imasdef.CLOSEST_SAMPLE)

LABEL = '\n%s/%s/%s/%s/%s @ %0.3f' % (args.user, args.tokamak, args.version, args.shot, args.run, T.time)

# V' [-D Y' <|grad(rho_tor_norm)|^2> + v Y <|grad(rho_tor_norm)|>]
#gm3(:) 	Flux surface averaged |grad_rho_tor|^2 {dynamic} [-]
#gm7(:) 	Flux surface averaged |grad_rho_tor| {dynamic} [-]
# V' [-D Y' gm3 + v Y gm7]

try:
    model_index = [t.identifier.name for t in T.model].index('transport_solver')
    print('Found model "transport_solver" as model %s' % (model_index))
except:
    print('"transport_solver" not found in the transport models')
    exit()

Tm = T.model[model_index]

V = Tm.profiles_1d[-1].grid_d.volume
r = Tm.profiles_1d[-1].grid_d.rho_tor_norm
S = Tm.profiles_1d[-1].grid_d.surface
Vp_per_S =  np.gradient(V, r) / S

rho_tor_sep = E.time_slice[-1].profiles_1d.rho_tor[-1]

gm3 = np.interp(r, E.time_slice[-1].profiles_1d.rho_tor_norm, E.time_slice[-1].profiles_1d.gm3) / rho_tor_sep**2
gm7 = np.interp(r, E.time_slice[-1].profiles_1d.rho_tor_norm, E.time_slice[-1].profiles_1d.gm7) / rho_tor_sep

for T_i, C_i in zip(Tm.profiles_1d[-1].ion, C.profiles_1d[-1].ion):
    plt.figure()
    Gamma_i = Vp_per_S * (-T_i.particles.d * np.gradient(C_i.density, r) * gm3 + C_i.density * T_i.particles.v * gm7)
    plt.plot(r, Gamma_i, label = 'Direct evaluation')
    plt.plot(r, T_i.particles.flux, label = 'Transport code')
    plt.title('Particle fluxes for %s/%s %s' % (T_i.element[0].z_n, T_i.element[0].a, LABEL))
    plt.xlabel('rho_tor_norm')
    plt.ylabel('Particle flux density')
    plt.legend(loc=0)

    plt.figure()
    Q_i_conductive = Vp_per_S * (-T_i.energy.d * np.gradient(C_i.temperature, r) * gm3 + C_i.temperature * T_i.energy.v * gm7) * C_i.density * imas_constants.QE
    Q_i_convective = Gamma_i * C_i.temperature * imas_constants.QE
    plt.plot(r, Q_i_conductive, label = 'Direct evaluation (conductive)')
    base_line, = plt.plot(r, Q_i_convective*1.5, label = 'Direct evaluation (convective)')
    plt.fill_between(r, Q_i_convective*0.0, Q_i_convective*2.5, facecolor=base_line.get_color(), alpha=0.2)
    base_line, = plt.plot(r, Q_i_conductive + Q_i_convective*1.5, label = 'Direct evaluation')
    plt.fill_between(r, Q_i_conductive + Q_i_convective*0.0, Q_i_conductive + Q_i_convective*2.5, facecolor=base_line.get_color(), alpha=0.2)
    plt.plot(r, T_i.energy.flux, label = 'Transport code')
    plt.title('Energy fluxes for %s/%s %s' % (T_i.element[0].z_n, T_i.element[0].a, LABEL))
    plt.xlabel('rho_tor_norm')
    plt.ylabel('Energy flux density')
    plt.legend(loc=0)

T_e = Tm.profiles_1d[-1].electrons
C_e = C.profiles_1d[-1].electrons

plt.figure()
Gamma_e = np.array([t.particles.flux*t.z_ion for t in Tm.profiles_1d[-1].ion]).sum(axis=0)
plt.plot(r, Gamma_e, label = 'Ambipolar Transport code fluxes')
plt.plot(r, T_e.particles.flux, label = 'Transport code')
plt.title('Particle fluxes for electrons %s' % (LABEL))
plt.xlabel('rho_tor_norm')
plt.ylabel('Particle flux density')
plt.legend(loc=0)

plt.figure()
Q_e_conductive = Vp_per_S * (-T_e.energy.d * np.gradient(C_e.temperature, r) * gm3 + C_e.temperature * T_e.energy.v * gm7) * C_e.density * imas_constants.QE
Q_e_convective = Gamma_e * C_e.temperature * imas_constants.QE
plt.plot(r, Q_e_conductive, label = 'Direct evaluation (conductive)')
base_line, = plt.plot(r, Q_e_convective*1.5, label = 'Direct evaluation (convective)')
plt.fill_between(r, Q_e_convective*0.0, Q_e_convective*2.5, facecolor=base_line.get_color(), alpha=0.2)
base_line, = plt.plot(r, Q_e_conductive + Q_e_convective*1.5, label = 'Direct evaluation')
plt.fill_between(r, Q_e_conductive + Q_e_convective*0.0, Q_e_conductive + Q_e_convective*2.5, facecolor=base_line.get_color(), alpha=0.2)
plt.plot(r, T_e.energy.flux, label = 'Transport code')
plt.title('Energy fluxes for electrons %s' % (LABEL))
plt.xlabel('rho_tor_norm')
plt.ylabel('Energy flux density')
plt.legend(loc=0)

plt.show()
