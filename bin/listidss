#!/usr/bin/env python

# @author: H.-J. Klingshirn
from __future__ import print_function
import sys
import idstools.ids_cli_tools as cli
import idstools.ids_tools as ct

def extended(str, wlen):
    l = len(str)
    if l < wlen:
        return ' ' * (wlen - l) + str
    else:
        return str

def print_vector(vec, wlen):
    return " ".join( [extended(str(x), wlen) for x in vec] )

pars, args = cli.read_shot()

try:
    db = ct.ImasDb(pars["shot"], pars["run"], pars["user"], pars["tokamakname"], pars["dataversion"], True, pars["hdf5"])
except:
    print("Unable to open database", file=sys.stderr)
    print(sys.exc_info()[0], file=sys.stderr)
    sys.exit(1)

alltimes = db.all_times()

for idsname, times in alltimes:
    print(extended(idsname, 15) + ": " \
        + extended(str(len(times)), 5) + " slices: " \
        + print_vector(times, 4))
