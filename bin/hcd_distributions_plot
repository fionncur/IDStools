#!/bin/csh -f

set arglist = ("$*")

set SCRIPT=`readlink -f "$0"`
set SCRIPTPATH=`dirname "$SCRIPT"`

# Mask definition: (shot run user db tslice)
# shot  = (1 0 0 0 0)
# run   = (0 1 0 0 0)
# user  = (0 0 1 0 0)
# db    = (0 0 0 1 0)
# tslice  = (0 0 0 0 1)

set mask = (0 0 0 0 0)
set shot = default
set run  = default
set user = default
set db   = default
set tslice = default

foreach arg ($arglist)
    if (\"$arg\" == \"-h\" | \"$arg\" == \"--help\") then
       python $SCRIPTPATH/hcd_distributions_plot.py -h
       exit
    endif
    if ($mask[1] == 1) then
      set shot = $arg
    else if ($mask[2] == 1) then
      set run = $arg
    else if ($mask[3] == 1) then
      set user = $arg
    else if ($mask[4] == 1) then
      set db = $arg
    else if ($mask[5] == 1) then
      set tslice = $arg
    endif
    if (\"$arg\" == \"-s\" | \"$arg\" == \"--shot\") then
      set mask = (1 0 0 0 0)
    else if (\"$arg\" == \"-r\" | \"$arg\" == \"--run\") then
      set mask = (0 1 0 0 0)
    else if (\"$arg\" == \"-u\" | \"$arg\" == \"--user_or_path\") then
      set mask = (0 0 1 0 0)
    else if (\"$arg\" == \"-d\" | \"$arg\" == \"--database\") then
      set mask = (0 0 0 1 0)
    else if (\"$arg\" == \"-t\" | \"$arg\" == \"--time\") then
      set mask = (0 0 0 0 1)
    else
      set mask = (0 0 0 0 0)
    endif
end

set arg_for_python = ''
if ($shot != default) then
  set arg_for_python = `echo $arg_for_python "-s" $shot`
endif
if ($run != default) then
  set arg_for_python = `echo $arg_for_python "-r" $run`
endif
if ($user != default) then
  set arg_for_python = `echo $arg_for_python "-u" $user`
endif
if ($db != default) then
  set arg_for_python = `echo $arg_for_python "-d" $db`
endif
if ($tslice != default) then
  set arg_for_python = `echo $arg_for_python "-t" $tslice`
endif

python $SCRIPTPATH/hcd_distributions_plot.py $arg_for_python

