#!/usr/bin/env python
from __future__ import print_function

import os, sys, glob, yaml, argparse, re, imas
from operator import itemgetter
from stat import *
import init_mendeleiev as mend

# ----------------------------------------------------------------------

def find_nearest(a, a0):
    'Element in nd array `a` closest to the scalar value `a0`'
    idx = numpy.abs(a - a0).argmin()
    return a.flat[idx],idx

# ----------------------------------------------------------------------

# Management of input arguments
parser = argparse.ArgumentParser(description=\
    '---- Display the plasma kinetic profiles from the core_profiles IDSs')
parser.add_argument('-u','--user',help='username of the DB where the data-entry is located', required=False)
parser.add_argument('-m','--machine',help='tokamak name of the targeted data-entry', required=False)
parser.add_argument('-s','--shot',help='shot number', required=True,type=int)
parser.add_argument('-r','--run',help='run number',required=True,type=int)
parser.add_argument('-t','--time',help='time', required=False,type=float)
args = vars(parser.parse_args())

# For execution from python shell
#args = {'run': 0, 'machine': None, 'user': None, 'time': None, 'shot': 101007}

shot = args['shot']
run  = args['run']

# Username
if args['user'] != None:
    user = args['user']
else:
    #user = os.getenv('USER')
    user = 'public'

# Tokamak name
if args['machine'] != None:
    machine = args['machine']
else:
    machine = 'iterdb'

# Time
if args['time'] != None:
    time = args['time']
else:
    time = -99.

# Open the database and read the necessary IDSs
try:
    input = imas.ids(shot,run)
    input.open_env(str(user),str(machine),'3')
except:
    print('Shot ' + str(shot) + ', run ' + str(run) + ' does not exist', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

if user == 'public':
    MDSPLUS_TREE_BASE_0 = '/work/imas/shared/'+str(machine)+'/3/0'
else:
    MDSPLUS_TREE_BASE_0 = os.path.expanduser("~{}".format(user))+"/public/imasdb/"+str(machine)+"/3/0"

try:
    input.core_profiles.get()
    core_profiles = input.core_profiles
except:
    print('The core_profiles IDS is absent from the input datafile', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

hostdir = os.environ["HOSTNAME"]+":"+MDSPLUS_TREE_BASE_0
hostdir = hostdir[:-2]

# ----------------------------------------------------------------------

from math import *
from numpy import *
import matplotlib
if 'DISPLAY' not in os.environ:
    matplotlib.use('agg')
else:
    matplotlib.use('TKagg')
from matplotlib import *
import matplotlib.pyplot as plt
import matplotlib.ticker as mtick

# Search for adequate time slice for display
ntime = len(core_profiles.time)
timevec = core_profiles.time
if ntime >= 1:
    if time >= 0:
        [tc,it] = find_nearest(timevec,time)
    else:
        it = int(ntime/2)
        tc = timevec[it]
    time = tc
    if ntime > 1:
        print('   Time  = '+'%.2f' % tc+' s in range ['+'%.2f' % timevec[0]+','+'%.2f' % timevec[ntime-1]+'] s')
        print('   Index = ',str(it))
        print('   Averaged resolution = ', (timevec[ntime-1]-timevec[0])/(ntime-1),' s')
    else:
        print('   Time  = '+'%.2f' % tc+' s')
else:
    if len(timevec) > 0:
        tc = timevec[0]
    else:
        tc = 0
    it = 0

time = tc

# Mendeleiev table
table_mendeleiev = mend.create_table_mendeleiev()

# ----------------------------------------------------------------------

# A priori the plasma composition can be read
plot_compo = 1

# Rho profile (mandatory)
try:
    rho_tor_norm = 0
    if len(core_profiles.profiles_1d[it].grid.rho_tor_norm) > 0:
        nrho = len(core_profiles.profiles_1d[it].grid.rho_tor_norm)
        rho_tor_norm = core_profiles.profiles_1d[it].grid.rho_tor_norm
    elif len(core_profiles.profiles_1d[it].grid.rho_tor) > 0:
        nrho = len(core_profiles.profiles_1d[it].grid.rho_tor)
        rho_tor_norm = core_profiles.profiles_1d[it].grid.rho_tor/core_profiles.profiles_1d[it].grid.rho_tor[nrho-1]
except:
    print('core_profiles.profiles_1d[:].grid.rho_tor_norm and rho_tor could not be read', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

# Species A number (not mandatory)
try:
    nspecies = len(core_profiles.profiles_1d[it].ion)
    a = [0] * nspecies
    for ispecies in range(nspecies):
        a[ispecies] = int(core_profiles.profiles_1d[it].ion[ispecies].element[0].a)
except:
    print('core_profiles.profiles_1d[:].ion[0].element[0].a could not be read', file=sys.stderr)
    plot_compo = 0

# Species Z number (not mandatory)
try:
    nspecies = len(core_profiles.profiles_1d[it].ion)
    z = [0] * nspecies
    for ispecies in range(nspecies):
        z[ispecies] = int(core_profiles.profiles_1d[it].ion[ispecies].element[0].z_n)
except:
    print('core_profiles.profiles_1d[:].ion[0].element[0].z_n could not be read', file=sys.stderr)
    plot_compo = 0

# Volume profile (not mandatory)
try:
    volume = core_profiles.profiles_1d[it].grid.volume
except:
    print('core_profiles.profiles_1d[:].grid.volume could not be read', file=sys.stderr)

# Number of ions
nions = len(core_profiles.profiles_1d[it].ion)

# E-field profile
if len(core_profiles.profiles_1d[0].e_field.radial) < 1:
    print('core_profiles.profiles_1d[0].e_field.radial could not be read', file=sys.stderr)
    for itime in range(ntime):
        core_profiles.profiles_1d[itime].e_field.radial = asarray([nan]*nrho)

# Toroidal velocity profile
for iion in range(nions):
    if len(core_profiles.profiles_1d[0].ion[iion].velocity.toroidal) < 1:
        print('core_profiles.profiles_1d[0].ion[iion].velocity.toroidal could not be read', file=sys.stderr)
        for itime in range(ntime):
            core_profiles.profiles_1d[itime].ion[iion].velocity.toroidal = asarray([nan]*nrho)

# Poloidal velocity profile
for iion in range(nions):
    if len(core_profiles.profiles_1d[0].ion[iion].velocity.poloidal) < 1:
        print('core_profiles.profiles_1d[0].ion[iion].velocity.poloidal could not be read', file=sys.stderr)
        for itime in range(ntime):
            core_profiles.profiles_1d[itime].ion[iion].velocity.poloidal = asarray([nan]*nrho)

# Diamagnetic velocity profile
for iion in range(nions):
    if len(core_profiles.profiles_1d[0].ion[iion].velocity.diamagnetic) < 1:
        print('core_profiles.profiles_1d[0].ion[iion].velocity.diamagnetic could not be read', file=sys.stderr)
        for itime in range(ntime):
            core_profiles.profiles_1d[itime].ion[iion].velocity.diamagnetic = asarray([nan]*nrho)

# ----------------------------------------------------------------------

if (nspecies > 0) & (plot_compo==1):

    # Plasma composition
    species = []
    for ispecies in range(nspecies):
        species.append(table_mendeleiev[z[ispecies]][a[ispecies]].element)

# ----------------------------------------------------------------------


# Tick size and X and Y axes
ticksize = 12
fontsize = 12

# Font definition
font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}

# Frame configuration
nline = 3
ncol  = 8
legx_pos = 1.35
legy_pos = 1.05

# Plot signature
def Signature(hostdir,shot,run,plt):
    ax = plt.gca()
    xmin, xmax = ax.get_xlim()
    ymin, ymax = ax.get_ylim()
    #plt.text(xmax+0.01*abs(xmax),ymax-0.03*abs(ymax-ymin),hostdir[:-2]+' - Shot '+str(shot)+' / '+' Run '+str(run),fontsize=6,rotation=90)
    plt.text(xmax+0.01*abs(xmax-xmin)+0.01,ymax-0.03*abs(ymax-ymin),'Shot '+str(shot)+' / '+' Run '+str(run),fontsize=5,rotation=90)
    return

# Legend customization
def CustomLegend_wf(legend):
    frame = legend.get_frame()
    frame.set_facecolor('0.95')
    for label in legend.get_texts():
        label.set_fontsize(10)
    for label in legend.get_lines():
        label.set_linewidth(1.5)  # the legend line width
    return

def CustomLegend_pr(legend):
    frame = legend.get_frame()
    frame.set_facecolor('0.95')
    for label in legend.get_texts():
        label.set_fontsize(7)
    for label in legend.get_lines():
        label.set_linewidth(1.5)  # the legend line width
    return

# Plot customization
def nice(plt,x_label_string,y_label_string,fontsize):
    font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}
    plt.xticks(fontsize = ticksize)
    plt.yticks(fontsize = ticksize)
    plt.xlabel(x_label_string, fontdict=font, labelpad = 1)
    plt.ylabel(y_label_string, fontdict=font, labelpad = 0)
    plt.grid()
    if len(x_label_string) < 1:
        plt.tick_params(axis='x',which='both',bottom='off',top='off',labelbottom='off')

def time_display(plot,time):
    ymin = plot.gca().get_ylim()[0]
    ymax = plot.gca().get_ylim()[1]
    plot.plot([time,time],[ymin,ymax],color='gray',linestyle='--',linewidth=2,label=r'$t_{slice}$')
    plt.gca().set_ylim(ymin,ymax)

# ----------------------------------------------------------------------

import unicodedata

# Display the figure
plt.figure()
#plt.ion()

# E-field profile
ax1 = plt.subplot(2, 2, 1)
plt.plot(rho_tor_norm,core_profiles.profiles_1d[0].e_field.radial*1.e-3,label = species[iion])
plt.xlim(rho_tor_norm[0],rho_tor_norm[nrho-1])
nice(plt,r'$\rho/\rho_0$',r'E-field ($kV/m$)',fontsize)
Signature(hostdir,shot,run,plt)
plt.title('t = '+'%.1f' % time+' s', fontdict=font)

# Toroidal velocity profile
ax2 = plt.subplot(2, 2, 2)
for iion in range(nions):
    plt.plot(rho_tor_norm,core_profiles.profiles_1d[0].ion[iion].velocity.toroidal*1.e-3,label = species[iion])

plt.xlim(rho_tor_norm[0],rho_tor_norm[nrho-1])
nice(plt,r'$\rho/\rho_0$',r'$v_{tor}$ ($km/s$)',fontsize)
legend = plt.legend(bbox_to_anchor=(legx_pos-0.95,legy_pos-0.05))
CustomLegend_wf(legend)
Signature(hostdir,shot,run,plt)
plt.title('t = '+'%.1f' % time+' s', fontdict=font)

# Poloidal velocity profile
ax3 = plt.subplot(2, 2, 3)
for iion in range(nions):
    plt.plot(rho_tor_norm,core_profiles.profiles_1d[0].ion[iion].velocity.poloidal*1.e-3,label = species[iion])

plt.xlim(rho_tor_norm[0],rho_tor_norm[nrho-1])
nice(plt,r'$\rho/\rho_0$',r'$v_{pol}$ ($km/s$)',fontsize)
legend = plt.legend(bbox_to_anchor=(legx_pos-0.95,legy_pos-0.5))
CustomLegend_wf(legend)
Signature(hostdir,shot,run,plt)
plt.title('t = '+'%.1f' % time+' s', fontdict=font)

# Diamagnetic velocity profile
ax4 = plt.subplot(2, 2, 4)
for iion in range(nions):
    plt.plot(rho_tor_norm,core_profiles.profiles_1d[0].ion[iion].velocity.diamagnetic*1.e-3,label = species[iion])

plt.xlim(rho_tor_norm[0],rho_tor_norm[nrho-1])
nice(plt,r'$\rho/\rho_0$',r'$v_{dia}$ ($km/s$)',fontsize)
legend = plt.legend(bbox_to_anchor=(legx_pos-0.95,legy_pos-0.5))
CustomLegend_wf(legend)
Signature(hostdir,shot,run,plt)
plt.title('t = '+'%.1f' % time+' s', fontdict=font)

ax = plt.gca()
xmin, xmax = ax.get_xlim()
ymin, ymax = ax.get_ylim()
plt.text(xmin-0.7*(xmax-xmin),ymin-0.4*(ymax-ymin),hostdir+' - Shot '+str(shot)+' / '+' Run '+str(run), fontdict=font,fontsize=6,color='black')

plt.tight_layout() # Adjust spacking between figures

fig = plt.gcf()

try:
    fig.savefig('Neutrons'+'_shot_'+str(shot)+'_run_'+str(run)+'_time_'+'%.1f' % time+'.png', dpi=100)
    print('----> Figure saved to '+'Neutrons'+'_shot_'+str(shot)+'_run_'+str(run)+'_time_'+'%.1f' % time+'.png')
except:
    print('The figure could not be saved (check local permissions).', file=sys.stderr)

plt.show()


