#!/usr/bin/env python
from __future__ import print_function

import os, sys, glob, yaml, argparse, re, imas, pdb
from operator import itemgetter
from stat import *
from numpy import *

# ----------------------------------------------------------------------

def find_nearest(a, a0):
    'Element in nd array `a` closest to the scalar value `a0`'
    idx = abs(a - a0).argmin()
    return a.flat[idx],idx

# ----------------------------------------------------------------------

# Management of input arguments
parser = argparse.ArgumentParser(description=\
    '---- Display the neutron profiles from the distribution_sources IDSs')
parser.add_argument('-u','--user_or_path',help='User or absolute path name of the DB where the data-entry is located', required=False)
parser.add_argument('-d','--database',help='Database name of the targeted data-entry', required=False)
parser.add_argument('-s','--shot',help='Shot number', required=True,type=int)
parser.add_argument('-r','--run',help='Run number',required=True,type=int)
parser.add_argument('-t','--time',help='Time', required=False,type=float)
args = vars(parser.parse_args())

# For execution from python shell
#args = {'run': 0, 'database': None, 'user_or_path': None, 'time': None, 'shot': 121003}

shot = args['shot']
run  = args['run']

# User or absolute path name
if args['user_or_path'] != None:
    user_or_path = args['user_or_path']
else:
    user_or_path = 'public'

# Database name
if args['database'] != None:
    database = args['database']
else:
    database = 'iterdb'

# Time
if args['time'] != None:
    time = args['time']
else:
    time = -99.

# Open the database and read the necessary IDSs
version = os.getenv('IMAS_VERSION')[0]
input=imas.ids(shot,run)
[err,n]=input.open_env(user_or_path,database,version,silent=True)
if err != 0:
    print('Shot ' + str(shot) + ', run ' + str(run) +' for user_or_path = '+user_or_path+' and database = '+database+' does not exist', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

if user_or_path == 'public':
    DB_ABS_PATH = '/work/imas/shared/'+str(database)+'/3/0'
else:
    DB_ABS_PATH = os.path.expanduser("~{}".format(user_or_path))+"/public/imasdb/"+str(database)+"/3/0"

try:
    #input.distribution_sources.get()
    distribution_sources = input.distribution_sources
    distribution_sources.time=input.distribution_sources.partialGet('time')
    if distribution_sources.time is None:
        print('No distribution_sources IDS in the data-entry --> Abort.', file=sys.stderr)
        exit()

except:
    print('The distribution_sources IDS is absent from the input data-entry', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

hostdir = os.environ["HOSTNAME"]+":"+DB_ABS_PATH
hostdir = hostdir[:-2]

# ----------------------------------------------------------------------

# Search for adequate time slice for display
ntime = len(distribution_sources.time)
timevec = distribution_sources.time
if ntime >= 1:
    if time >= 0:
        [tc,it] = find_nearest(timevec,time)
    else:
        it = int(ntime/2)
        tc = timevec[it]
    time = tc
    if ntime > 1:
        print('   Time  = '+'%.2f' % tc+' s in range ['+'%.2f' % timevec[0]+','+'%.2f' % timevec[ntime-1]+'] s', file=sys.stderr)
        print('   Index = ',str(it), file=sys.stderr)
        print('   Averaged resolution = ', (timevec[ntime-1]-timevec[0])/(ntime-1),' s', file=sys.stderr)
    else:
        print('   Time  = '+'%.2f' % tc+' s', file=sys.stderr)
else:
    if len(timevec) > 0:
        tc = timevec[0]
    else:
        tc = 0
    it = 0

time = tc

# Read quantities for this time slice
input.distribution_sources.getSlice(time,1)
nsources = len(input.distribution_sources.source)
if nsources>1:
    print('Distribution_sources contains '+str(nsources)+' sources', file=sys.stderr)
else:
    print('Distribution_sources contains '+str(nsources)+' source', file=sys.stderr)

active = [1]*nsources # A priori all sources are active
distribution_sources.source.resize(nsources)
for isource in range(nsources):
    distribution_sources.source[isource].profiles_1d.resize(1)
    distribution_sources.source[isource].global_quantities.resize(1)
    distribution_sources.source[isource].process.resize(1)
    try:
        distribution_sources.source[isource].profiles_1d[0] = input.distribution_sources.partialGet('source('+str(isource)+')/profiles_1d('+str(it)+')')
    except:
        print('Source '+str(isource)+' has no profiles_1d -> considered as inactive', file=sys.stderr)
        active[isource] = 0
    try:
        distribution_sources.source[isource].global_quantities[0] = input.distribution_sources.partialGet('source('+str(isource)+')/global_quantities('+str(it)+')')
    except:
        if active[isource]==1:
            print('Source '+str(isource)+' has no global_quantities -> considered as inactive', file=sys.stderr)
            active[isource] = 0
    try:
        distribution_sources.source[isource].process[0] = input.distribution_sources.partialGet('source('+str(isource)+')/process(0)')
    except:
        if active[isource]==1:
            print('Source '+str(isource)+' has no process -> considered as inactive', file=sys.stderr)
            active[isource] = 0

if sum(active)==0:
    print('No active neutron sources --> Leave.', file=sys.stderr)
    exit()

# ----------------------------------------------------------------------

# Rho profile (mandatory)
nrho=0
try:
    rho_tor_norm = distribution_sources.source[0].profiles_1d[0].grid.rho_tor_norm
    nrho = len(rho_tor_norm)
    if nrho == 0:
        if len(distribution_sources.source[0].profiles_1d[0].grid.rho_tor)>0:
            nrho = len(distribution_sources.source[0].profiles_1d[0].grid.rho_tor)
            rho_tor_norm = distribution_sources.source[0].profiles_1d[0].grid.rho_tor/distribution_sources.source[0].profiles_1d[0].grid.rho_tor[nrho-1]
except:
    print('distribution_sources.source[0].profiles_1d[0].grid.rho_tor(_norm) could not be read', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()
if nrho==0:
    print('core_profiles.profiles_1d[:].grid.rho_tor_norm and rho_tor are empty', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

if nrho==0:
    print('distribution_sources.source[0].profiles_1d[0].grid.rho_tor_norm) is empty', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

# Volume profile (not mandatory)
try:
    volume = distribution_sources.source[0].profiles_1d[0].grid.volume
except:
    print('distribution_sources.source[0].profiles_1d[0].grid.volume could not be read', file=sys.stderr)

# Number of distribution sources
nsources = len(distribution_sources.source)

# Toroidal velocity profile
for isource in range(nsources):
    if len(distribution_sources.source[isource].profiles_1d[0].particles) < 1:
        print('distribution_sources.source[isource].profiles_1d[0].particles could not be read', file=sys.stderr)
        distribution_sources.source[isource].profiles_1d[0].particles = asarray([nan]*nrho)

# ----------------------------------------------------------------------

# Tick size and X and Y axes
ticksize = 12
fontsize = 12

# Font definition
font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}

# Frame configuration
nline = 3
ncol  = 8
legx_pos = 1.35
legy_pos = 1.05

# Plot signature
def Signature(hostdir,shot,run,plt):
    ax = plt.gca()
    xmin, xmax = ax.get_xlim()
    ymin, ymax = ax.get_ylim()
    plt.text(xmax+0.01*abs(xmax),ymax-0.03*abs(ymax-ymin),hostdir[:-2]+' - Shot '+str(shot)+' / '+' Run '+str(run),fontsize=6,rotation=90)
    #plt.text(xmax+0.01*abs(xmax-xmin)+0.01,ymax-0.03*abs(ymax-ymin),'Shot '+str(shot)+' / '+' Run '+str(run),fontsize=5,rotation=90)
    return

# Legend customization
def CustomLegend_wf(legend):
    frame = legend.get_frame()
    frame.set_facecolor('0.95')
    for label in legend.get_texts():
        label.set_fontsize(7)
    for label in legend.get_lines():
        label.set_linewidth(1.5)  # the legend line width
    return

def CustomLegend_pr(legend):
    frame = legend.get_frame()
    frame.set_facecolor('0.95')
    for label in legend.get_texts():
        label.set_fontsize(7)
    for label in legend.get_lines():
        label.set_linewidth(1.5)  # the legend line width
    return

# Plot customization
def nice(plt,x_label_string,y_label_string,fontsize):
    font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}
    plt.xticks(fontsize = ticksize)
    plt.yticks(fontsize = ticksize)
    plt.xlabel(x_label_string, fontdict=font, labelpad = 1)
    plt.ylabel(y_label_string, fontdict=font, labelpad = 0)
    plt.grid()
    if len(x_label_string) < 1:
        plt.tick_params(axis='x',which='both',bottom='off',top='off',labelbottom='off')

def time_display(plot,time):
    ymin = plot.gca().get_ylim()[0]
    ymax = plot.gca().get_ylim()[1]
    plot.plot([time,time],[ymin,ymax],color='gray',linestyle='--',linewidth=2,label=r'$t_{slice}$')
    plt.gca().set_ylim(ymin,ymax)

# ----------------------------------------------------------------------

import matplotlib
if 'DISPLAY' not in os.environ:
    matplotlib.use('agg')
else:
    matplotlib.use('TKagg')
import matplotlib.pyplot as plt
import matplotlib.ticker as mtick

import unicodedata

# Display the figure
plt.figure()
#plt.ion()

# Neutron profiles: distributions are for neutrons only if distribution_sources.source{isource}.species.type.index = 6
print(' ------------------------------------------------------------', file=sys.stderr)

# Number of sources limited to 32 in the UAL
if nsources > 32:
    nsources=32

for isource in range(nsources):
    mlabel1 = unicodedata.normalize('NFKD', distribution_sources.source[isource].process[0].type.description).encode('ascii','ignore')
    mlabel2 = unicodedata.normalize('NFKD', distribution_sources.source[isource].process[0].reactant_energy.description).encode('ascii','ignore')
    mlabel  = (mlabel1 + b'; ' + mlabel2).decode()
    plt.plot(rho_tor_norm,distribution_sources.source[isource].profiles_1d[0].particles,label=mlabel)
    print(' ' + mlabel + '; P = '+'%.2f' % (distribution_sources.source[isource].global_quantities[0].power*1.e-3)+' kW', file=sys.stderr)

print(' ------------------------------------------------------------', file=sys.stderr)

plt.xlim(rho_tor_norm[0],rho_tor_norm[nrho-1])
nice(plt,r'$\rho/\rho_0$',r'Neutron rate ($s^{-1}.m{^{-3}}$)',fontsize)
legend = plt.legend(bbox_to_anchor=(legx_pos-0.35,legy_pos-0.05))
CustomLegend_wf(legend)
Signature(hostdir,shot,run,plt)
plt.title('Profiles displayed for t = '+'%.1f' % time+' s', fontdict=font)

fig = plt.gcf()

try:
    fig.savefig('Neutrons'+'_shot_'+str(shot)+'_run_'+str(run)+'_time_'+'%.1f' % time+'.png', dpi=100)
    print('----> Figure saved to '+'Neutrons'+'_shot_'+str(shot)+'_run_'+str(run)+'_time_'+'%.1f' % time+'.png', file=sys.stderr)
except:
    print('The figure could not be saved (check local permissions).', file=sys.stderr)

plt.show()


