#! /usr/bin/env python
### David.Coster@ipp.mpg.de
import numpy as np
import imas
import argparse
import os,sys
import time
from idstools.cli import *

parser = argparse.ArgumentParser(description="Calculate size of IDSs", epilog
="""
""", formatter_class=argparse.RawTextHelpFormatter, parents=[imas_parser])
parser.add_argument("shot", type=int, help="Shot number")
parser.add_argument("run", type=int, help="Run number")
args=parser.parse_args()

def byte_size(O):
  S = 0
  if type(O) == str: 
    S += len(O)
  elif type(O) == np.ndarray:
    S += O.nbytes
  elif type(O) == int:
    S += 4
  elif type(O) == float:
    S += 8
  elif type(O) == list:
    for o in O:
      S += byte_size(o)
  elif type(O) == dict:
    for o in O.values():
      S += byte_size(o)
  else:
    for o in O.__dict__.values():
      S += byte_size(o)
  return S


IDS = imas.DBEntry(get_backend_id(args.backend), args.database, args.shot, args.run, user_name=args.user)
status,idx = IDS.open()

print('\n\nExamining data for %s/%s/%s/%s/%s\n\n' % (args.user, args.database, args.version, args.shot, args.run))

if status!=0:
  print('Error opening pulse! Please check existence.')
  sys.exit(status)


SIZES = {}
for i in [i.value for i in imas.IDSName]:
  nocc = eval("imas.%s.getMaxOccurrences()" % (i))
  for o in range(nocc+1):
    HT = IDS.partial_get(i, 'ids_properties/homogeneous_time', occurrence=o)
    if HT >= 0:
      field = "%s/%s" % (i, o)
      SIZES[field] = {}
      start_time = time.time()
      _IDS = IDS.get(i)
      SIZES[field]['time'] = time.time() - start_time
      SIZES[field]['bytes'] = byte_size(_IDS)
      print('Reading %0.3f MB data for %s took %0.2f seconds' % ( SIZES[field]['bytes']/1024**2, field, SIZES[field]['time']))
      del _IDS

total_bytes = np.array([v['bytes'] for v in SIZES.values()]).sum()
total_time  = np.array([v['time']  for v in SIZES.values()]).sum()

print('\n\nTotal reading time = %0.2f s\n' % (total_time))

print('\nTotal data size = %4.1f MB\n' % (total_bytes/1024**2))

print('\nFractions of the total size for %s/%s/%s/%s/%s\n' % (args.user, args.database, args.version, args.shot, args.run))

print('% bytes    IDS')
for v in SIZES.keys():
    print('%4.1f %%     %s' % (SIZES[v]['bytes']/total_bytes*100, v))
