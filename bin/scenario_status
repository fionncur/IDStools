#!/usr/bin/env python

import os, argparse, yaml, re

# Management of input arguments
parser = argparse.ArgumentParser(description=\
	 '---- Show status and potential parent and children for a given simulation stored in ITER DB folder')
parser.add_argument("-f","--folder",help=\
                    "folder where to search for scenarios", required=False)
parser.add_argument('-s','--shot',help='shot number', required=True,type=int)
# currently limiting run < 10000 because of the search path /3/0
parser.add_argument('-r','--run',help='run number',required=True,type=int,
                    choices=range(0,9999),metavar="[0-9999]") 
args = vars(parser.parse_args())
shot = str(args['shot'])
run  = str(args['run'])
if args['folder'] != None:
    folder = args['folder']
else:
    LL_version = int(os.environ['UAL_VERSION'][0])
    if LL_version < 4:
        folder = os.environ['IMAS_HOME']+'/shared/iterdb/3/0'
    else:
        folder = os.environ['IMAS_HOME']+'/shared/imasdb/ITER/3/0'

# ------------------------------------------------------------------------------------------------------------

def read_yaml(shot,run,folder):
    filename = folder+f'/ids_{shot}{run.rjust(4,"0")}.yaml'
    try:
        with open(filename, 'r') as f:
            data = yaml.load(f,Loader=yaml.CLoader)
    except Exception as exc:
        if args['folder'] == None:
            print(f"Warning: {exc}")
            data = None
        else:
           try:
               LL_version = int(os.environ['UAL_VERSION'][0])
               if LL_version < 4:
                   filename = os.environ['IMAS_HOME']+'/shared/iterdb/3/0'\
                             +f'/ids_{shot}{run.rjust(4,"0")}.yaml'
               else:
                   filename = os.environ['IMAS_HOME']+'/shared/imasdb/ITER/3/0'\
                             +f'/ids_{shot}{run.rjust(4,"0")}.yaml'
               with open(filename, 'r') as f:
                   data = yaml.load(f,Loader=yaml.CLoader)
           except Exception as exc:
               print(f"Warning: {exc}")
               data = None
    return data

def find_parent(data,family):
    replaces = data['database_relations']['replaces']
    if replaces is not None:
        string_list = re.findall(r'\d+',replaces)
        shotp = string_list[0]
        runp = string_list[1]
        datap = read_yaml(shotp,runp,folder)
        if datap is not None:
            family['parents']['shot'].insert(0,shotp) # Order to be reversed for parents
            family['parents']['run'].insert(0,runp)
            family['parents']['status'].insert(0,datap['status'])
            family['parents']['comment'].insert(0,datap['database_relations']['replaces'])
            family = find_parent(datap,family)
    return family
    
def find_children(data,family):
    replaced_by = data['database_relations']['replaced_by']
    if replaced_by is not None:
        string_list = re.findall(r'\d+',replaced_by)
        shotc = string_list[0]
        runc = string_list[1]
        datac = read_yaml(shotc,runc,folder)
        if datac is not None:
            family['children']['shot'].append(shotc)
            family['children']['run'].append(runc)
            family['children']['status'].append(datac['status'])
            family['children']['comment'].append(datac['database_relations']['replaces'])
            family = find_children(datac,family)
    return family



data = read_yaml(shot,run,folder)
if data is None:
    print(f'Data entry {shot}/{run} does not exist')
    exit()    
    
if 'database_relations' not in data.keys():
    print(f'No database_relations defined: the yaml file associated with this {shot}/{run} might be too old (its status is {data["status"]}).')
    exit()
else:

    class generic_member():
        def __init__(self):
            self.value = {}
            self.value['shot']    = []
            self.value['run']     = []
            self.value['status']  = []
            self.value['comment'] = []

    family = {}
    family['parents']  = generic_member().value
    family['children'] = generic_member().value

    family = find_parent(data,family)
    family = find_children(data,family)

print("-----------------------------------------------------------------")
print("  SCENARIO \t STATUS \t REASON WHY IT REPLACES PREVIOUS")
for iparent in range(len(family['parents']['shot'])):
    print(" ",family['parents']['shot'][iparent],family['parents']['run'][iparent]
          ,'\t',family['parents']['status'][iparent]
          ,'\t',family['parents']['comment'][iparent])
print("*",shot,run,'\t',data['status']
          ,'\t',data['database_relations']['replaces'])
for ichild in range(len(family['children']['shot'])):
    print(" ",family['children']['shot'][ichild],family['children']['run'][ichild]
          ,'\t',family['children']['status'][ichild]
          ,'\t',family['children']['comment'][ichild])
print("-----------------------------------------------------------------")






