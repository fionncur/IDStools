#!/usr/bin/env python
from __future__ import print_function

import argparse,os,imas
import sys,pdb
from numpy import *
from idstools.cli import *

# ----------------------------------------------------------------------

def find_nearest(a, a0):
    "Element in nd array `a` closest to the scalar value `a0`"
    idx = abs(a - a0).argmin()
    return a.flat[idx],idx

# ----------------------------------------------------------------------

# Management of input arguments
parser = argparse.ArgumentParser(description='---- Display the plasma equilibrium from the equilibrium IDS',
                                 parents=[imas_parser])
parser.add_argument('-s','--shot',help='Shot number', required=True,type=int)
parser.add_argument('-r','--run',help='Run number',required=True,type=int)
parser.add_argument('-t','--time',help='Time (default=middle)',type=float,default=-99.0)
parser.add_argument('-o','--occurrence',help='Occurrence number (default=%(default)s)',type=int,default=0)
parser.add_argument('-p','--plotrho',help='Plots rho(R,Z)',action='store_true')
parser.add_argument('-a','--allInfo',help='Adds all extra provenance info to the plot',action='store_true')

args = parser.parse_args()

# Open the database and read the necessary IDSs
input=imas.DBEntry(get_backend_id(args.backend),args.database,args.shot,args.run,args.user)
err,n=input.open()
if err != 0:
    print('Shot {0}, run {1} for user={2} and database={3} does not exists'.format(args.shot,args.run,args.user,args.database),file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

if args.user == 'public':
    DB_ABS_PATH = os.environ['IMAS_HOME']+'/shared/imasdb/'+args.database+'/3'
else:
    DB_ABS_PATH = os.path.expanduser("~{}".format(args.user))+"/public/imasdb/"+args.database+"/3"

try:
    equilibrium = imas.equilibrium()
    equilibrium.time=input.partial_get('equilibrium','time',args.occurrence)
    if equilibrium.time is None:
        print("The equilibrium IDS for this occurence is empty in the input"\
              +" data-entry because equilibrium.time is empty", file=sys.stderr)
        exit()
except Exception as exc:
    print("Can not retrieve the equilibrium IDS from the input data-entry: {}".format(exc), file=sys.stderr)
    print("----> Aborted.", file=sys.stderr)
    exit()

# Search for adequate time slice for equilibrium display
ntime = len(equilibrium.time)
timevec = equilibrium.time
time = args.time
if len(timevec) > 1:
    if time >= 0:
        [tc,it] = find_nearest(timevec,time)
    else:
        it = int(ntime/2)
        tc = timevec[it]
    time = tc
    print('   Time  = '+'%.2f' % tc+' s in range ['+'%.2f' % timevec[0]+','+'%.2f' % timevec[ntime-1]+'] s', file=sys.stderr)
    print('   Index = ',str(it), file=sys.stderr)
    print('   Averaged resolution = ', (timevec[ntime-1]-timevec[0])/(ntime-1),' s', file=sys.stderr)
else:
    if len(timevec) > 0:
        tc = timevec[0]
    else:
        tc = 0
    it = 0
    time = tc

# Read 2D-profiles for this time slice
equilibrium.time_slice.resize(1)
equilibrium.time_slice[0] = input.partial_get('equilibrium','time_slice('+str(it)+')',args.occurrence)

if len(equilibrium.time_slice[0].profiles_2d) == 0:
    print("The equilibrium IDS is empty: len(equilibrium.time_slice[0].profiles_2d)=0", file=sys.stderr)
    print("----> Aborted.", file=sys.stderr)
    exit()

# phi(R,Z) for rho(R,Z) calculation
if len(equilibrium.time_slice[0].profiles_2d[0].phi) < 1:
    print("equilibrium.time_slice[:].profiles_2d[0].phi could not be read", file=sys.stderr)
    args.plotrho = False

# psi(R,Z)
if len(equilibrium.time_slice[0].profiles_2d[0].psi) < 1:
    print("equilibrium.time_slice[:].profiles_2d[0].psi could not be read", file=sys.stderr)
    print("----> Aborted.", file=sys.stderr)
    exit()

# ----------------------------------------------------------------------

import matplotlib
if 'DISPLAY' not in os.environ:
    matplotlib.use('agg')
else:
    matplotlib.use('TKagg')
import matplotlib.pyplot as plt

# Tick size and X and Y axes
ticksize = 15

# Font definition
font = {'family': 'serif',
        'color':  'darkred',
        'weight': 'normal',
        'size': 18,
        }

# Cartesian (R,Z) grids
r2d   = equilibrium.time_slice[0].profiles_2d[0].r
z2d   = equilibrium.time_slice[0].profiles_2d[0].z
psi2d = equilibrium.time_slice[0].profiles_2d[0].psi
 
if equilibrium.time_slice[0].profiles_2d[0].grid_type.index == 1 \
   and size(r2d) == 0:
    r1d = equilibrium.time_slice[0].profiles_2d[0].grid.dim1
    z1d = equilibrium.time_slice[0].profiles_2d[0].grid.dim2
    nr = len(r1d)
    nz = len(z1d)
    r2d = empty(shape=(nr,nz))
    z2d = empty(shape=(nr,nz))
    for iz in range(nz):
      r2d[:,iz]=r1d
    for ir in range(nr):
      z2d[ir,:]=z1d

if not ((size(r2d) == size(z2d)) and (size(r2d) == size(psi2d))):
    print('r, z and psi have not the same dimension in equilibrium.time_slice[0].profiles_2d[0]', file=sys.stderr)
    print("----> Aborted.", file=sys.stderr)
    exit()

# Display the figure
plt.figure()
if args.plotrho:
    rho2d = sqrt(equilibrium.time_slice[0].profiles_2d[0].phi/amax(equilibrium.time_slice[0].profiles_2d[0].phi))
    plt.contour(r2d,z2d,rho2d,30,colors='r')
plt.contour(r2d,z2d,psi2d,30)
plt.xlim(r2d.min(),r2d.max())
plt.gca().set_aspect('equal', adjustable='box')
plt.xlabel('$R$ [m]', fontdict=font)
plt.ylabel('$Z$ [m]', fontdict=font)
plt.xticks(fontsize = ticksize)
plt.yticks(fontsize = ticksize)
plottitle='2D equilibrium'
if args.allInfo:
    plottitle+=' (t={:.3f})'.format(time)
plt.title(plottitle, fontdict=font)

#from matplotlib.offsetbox import AnchoredText
#anchored_text = AnchoredText('Shot '+str(shot)+' / '+'Run '+str(run),prop=dict(size=8),loc=4)
#ax.add_artist(anchored_text)

fig = plt.gcf()
ax = plt.gca()

if args.allInfo:
    hostdir= os.environ["HOSTNAME"]+":"+DB_ABS_PATH
    xmin, xmax = ax.get_xlim()
    ymin, ymax = ax.get_ylim()
    ax.text(xmax+0.01*abs(xmax),ymin+0.5*abs(ymax-ymin),
            '{0}-Shot:{1},{2}'.format(hostdir,args.shot,args.run),
            horizontalalignment='left',verticalalignment='center',rotation='vertical',fontsize=7)


fig.set_size_inches(4.5,6.5)
try:
    fname = 'Equilibrium_shot_{0}_run_{1}_time_{2:.1f}.png'.format(args.shot,args.run,time)
    fig.savefig(fname, dpi=100)
    print('----> Figure saved to '+fname, file=sys.stderr)
except:
    print('The figure could not be saved (check local permissions).', file=sys.stderr)
plt.show()

