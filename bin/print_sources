#! /usr/bin/env python
### David.Coster@ipp.mpg.de
import numpy as np
import imas
import argparse
import os,sys
from idstools.cli import *

db_group.add_argument("--tokamak", "-t", 
                   type=str, dest="database", default=os.getenv("TOKAMAKNAME"),
                   help="tokamak name \t[deprecated: use -d instead]")

parser = argparse.ArgumentParser(description="View information about sources", epilog
="""
""", formatter_class=argparse.RawTextHelpFormatter, parents=[imas_parser])
parser.add_argument("-S", "--SlicingMethod",
                    type=str, default="CLOSEST", 
                    choices=["CLOSEST","PREVIOUS","LINEAR"],
                    help="Slicing method \t(default=%(default)s)")
parser.add_argument("-o", "--occurrence", 
                    type=int, default=0,
                    help="occurrence")
parser.add_argument("shot", type=int, help="Shot number")
parser.add_argument("run", type=int, help="Run number")
parser.add_argument("time", type=float, help="Time")
args=parser.parse_args()

IDS = imas.DBEntry(get_backend_id(args.backend), args.database, args.shot, args.run, user_name=args.user)
status,idx = IDS.open()

if status!=0:
  print('Error opening pulse! Please check existence.')
  sys.exit(status)

S = IDS.get_slice('core_sources', args.time, get_slice_mode(args.SlicingMethod), occurrence=args.occurrence)
print('\nTime = %0.3f for %s/%s/%s/%s/%s\n' % (S.time, args.user, args.database, args.version, args.shot, args.run))

for s in S.source:
    print(s.identifier.name)
    print("       electrons", end='')
    # electrons
    i= s.profiles_1d[0].electrons
    if len(i.particles) == 0:
        print('     particles     --       ', end='')
    else:
        print('     particles %13.6e' % (np.trapz(i.particles, s.profiles_1d[0].grid.volume)), end='')
    if len(i.energy) == 0:
        print('     energy     --       ')
    else:
        print('     energy %13.6e' % (np.trapz(i.energy, s.profiles_1d[0].grid.volume)))
    # ions
    for i in s.profiles_1d[0].ion:
        if len(i.element) > 0:
            print("    ", i.element[0].a, i.element[0].z_n, i.z_ion, end='')
            if len(i.particles) == 0:
                print('     particles     --       ', end='')
            else:
                print('     particles %13.6e' % (np.trapz(i.particles, s.profiles_1d[0].grid.volume)), end='')
            if len(i.energy) == 0:
                print('     energy     --     ')
            else:
                print('     energy %13.6e' % (np.trapz(i.energy, s.profiles_1d[0].grid.volume)))
