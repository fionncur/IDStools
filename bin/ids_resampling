#!/usr/bin/env python
from __future__ import print_function

import imas,os,sys,argparse
import numpy as np
from idstools.cli import *


def resample_indices(dbin,dbout,idsname,start=0,stop=None,step=1):
    times = dbin.partial_get(idsname,'time')
    for i in times[range(start,len(times) if stop==None else stop,step)]:
        s = dbin.get_slice(idsname,i,imas.imasdef.PREVIOUS_INTERP)
        dbout.put_slice(s)

def resample_times(dbin,dbout,idsname,start=None,stop=None,step=None):
    times = dbin.partial_get(idsname,'time')
    if step==None: # work on indices
        rstart = 0 if start==None else np.argmax(times>=start)
        rstop = len(times) if stop==None else (np.argmax(times>stop)-1)
        rtimes = [times[range(rstart,rstop,1)]]
    else:
        rstart = times[0] if start==None else start
        rstop = times[-1] if stop==None else stop
        rtimes = np.arange(rstart,rstop,step)

    for i in rtimes:
        s = dbin.get_slice(idsname,i,imas.imasdef.PREVIOUS_INTERP)
        dbout.put_slice(s)


#if __name__ == "__main__":

# Management of input arguments
parser = argparse.ArgumentParser(description='Resample IDSs from a data-entry and save them into another data-entry',
                                 parents=[imas_parser])
parser.add_argument('-si','--shot_input',help='Input shot number',required=True,type=int)
parser.add_argument('-ri','--run_input',help='Input run number',required=True,type=int)
parser.add_argument('-so','--shot_output',help='Output shot number',required=True,type=int)
parser.add_argument('-ro','--run_output',help='Output run number',required=True,type=int)
# default user from parent parser is 'public',
# which is fine for exploration scripts but less
# for management scripts
parser.set_defaults(user=os.environ['USER'])
parser.add_argument('-do','--database_output',type=str,default=None,
                    help='Database name for the destination data-entry')
parser.add_argument('-bo','--backend_output',type=str,
                    help='Backend name for the destination data-entry')
#parser.add_argument('-f','--force',action='store_true',
#                    help='Force the creation of destination data-entry (existing data might be lost)')
group = parser.add_mutually_exclusive_group()
group.add_argument('--index-range',type=str,
                   help='Specified range of slices index as "start,stop,step". If omitted, start=0, stop=len(timebase),step=1, e.g. "0,,10" to keep 1 every 10 slices. Works only for IDS with homogeneous timebase. (Default)')
group.add_argument('--time-range',type=str,
                   help='Specified range of times as "start,stop,step". If omitted, start=time[0], stop=time[-1]), while omitting step will keep of slices between start and stop, e.g. "10.,50.," to keep all times between 10. and 50. secondes). Works only for IDS with homogeneous timebase unless all three values are specified.')
parser.add_argument('ids',nargs='*',type=str,
                    help='IDSs to resample (leave empty to resample all)')


args = parser.parse_args()


if args.database_output == None:
    args.database_output = args.database

if args.backend_output == None:
    args.backend_output = args.backend

if args.shot_input==args.shot_output \
   and args.run_input == args.run_output \
   and args.user == os.environ['USER'] \
   and args.database == args.database_output \
   and args.backend == args.backend_output:
    print('Can not use the same data-entry as source and destination!',file=sys.stderr)
    exit()

if args.ids == []:
    args.ids = [ids.value for ids in list(imas.IDSName)]


# OPEN SOURCE
src = imas.DBEntry(get_backend_id(args.backend),args.database,
                   args.shot_input,args.run_input,user_name=args.user)
status,_ = src.open()
if status!=0:
    print('Error opening source pulse! Please check existence.',file=sys.stderr)
    sys.exit(status)


# TEMP
tmp = imas.DBEntry(imas.imasdef.MEMORY_BACKEND,'tmp',1,1)
status,_ = tmp.create()
if status!=0:
    print('Error creating temporary data-entry in memory!',file=sys.stderr)
    sys.exit(status)


dest = imas.DBEntry(get_backend_id(args.backend_output),args.database_output,
                    args.shot_output,args.run_output,user_name=os.environ['USER'])
#if not args.force:
# OPEN DEST
#    status,_ = dest.open()
#    if status!=0:
#        print('Destination pulse does not exist. Creating.')
#        status,_ = dest.create()
#        if status!=0:
#            print('Error opening destination pulse! Please check parameters.',
#                  file=sys.stderr)
#            sys.exit(status)
#else:

# CREATE DEST
status,_ = dest.create()
if status!=0:
    print('Error creating destination pulse! Please check parameters and permissions.',
          file=sys.stderr)
    sys.exit(status)



for idsname in args.ids:
    homogeneous = src.partial_get(idsname,'ids_properties/homogeneous_time')
    if homogeneous == 1:
        if args.time_range!=None:
            r = args.time_range.split(',')
            start = int(r[0]) if r[0]!='' else 0
            stop = int(r[1]) if r[1]!='' else None
            step = int(r[2]) if r[2]!='' else 1
            resample_times(src,tmp,idsname,start=start,stop=stop,step=step)
        else:
            if args.index_range==None:
                args.index_range=',,'
            r = args.index_range.split(',')
            start = int(r[0]) if r[0]!='' else 0
            stop = int(r[1]) if r[1]!='' else None
            step = int(r[2]) if r[2]!='' else 1
            resample_indices(src,tmp,idsname,start=start,stop=stop,step=step)
    elif homogeneous==0:
        if args.time_range!=None:
            r = args.time_range.split(',')
            if r[0]!='' and r[1]!='' and r[2]!='':
                resample_times(src,tmp,idsname,start=r[0],stop=r[1],step=r[2])
            else:
                print(f'Skipping IDS {idsname} because its homogeneous_time={homogeneous}',file=sys.stderr)
                continue
        else:
            print(f'Skipping IDS {idsname} because its homogeneous_time={homogeneous}',file=sys.stderr)
            continue
    else:
        #print(f'Skipping IDS {idsname} because its homogeneous_time={homogeneous}',file=sys.stderr)
        continue

    dest.put(tmp.get(idsname))


