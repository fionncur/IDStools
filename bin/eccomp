#!/usr/bin/env python
from __future__ import print_function

# MODULES
# --------
import numpy as np
from numpy import *
import imas,argparse,sys,os,copy
import matplotlib
matplotlib.use('TKagg')
import matplotlib.pyplot as plt
#import scipy.signal

def find_nearest(a, a0):
    'Element in nd array `a` closest to the scalar value `a0`'
    idx = abs(a - a0).argmin()
    return a.flat[idx],idx

def find_minima(y):
    #mindex = sig.argrelextrema(y,np.less)
    mindex = []
    t = len(y)//50
    for i in range(t,len(y)-t):
        if (y[i-t] > y[i-1] > y[i] < y[i+1] < y[i+t]):
            mindex.append(i)
    return mindex

def find_maxima(y):
    #maxdex = sig.argrelextrema(y,np.greater)
    maxdex = []
    t = len(y)//50
    for i in range(t,len(y)-t):
        if (y[i-t] < y[i-1] < y[i] > y[i+1] > y[i+t]):
            maxdex.append(i)
    return maxdex

def find_fwhm(x,y,maxind,lowbnd,uppbnd):
    npyleft = np.array(y[lowbnd:maxind])
    npyright = np.array(y[maxind:uppbnd])
    lindex = lowbnd+find_nearest(npyleft,y[maxind]/2)[1]
    rindex = maxind+find_nearest(npyright,y[maxind]/2)[1]
    fwhm = x[rindex]-x[lindex]
    return fwhm
    

def StrToList(string):
    if (string[0]=='['):
        slist = string.split(',')
        slist[0] = slist[0][1:]
        slist[-1] = slist[-1][:-1]
        slist = [int(slist[i]) for i in range(len(slist))]
        return slist
    else:
        return [int(string)]

# MANAGEMENT OF INPUT ARGUMENTS
# ------------------------------
parser = argparse.ArgumentParser(description=\
	 '---- Display EC results')
parser.add_argument('-s','--shot',help='Shot number, either int 130012, or list [130012,130012]', required=True,type=str)
parser.add_argument('-r','--run',help='Run number, either int 23, or list [23,24]',required=True,type=str)
parser.add_argument('-u','--user_or_path',help='User or absolute path name where the data-entry is located', required=False)
parser.add_argument('-d','--database',help='Database name where the data-entry is located', required=False)
parser.add_argument('-t','--time',help='Time for which profiles are displayed', required=False,type=float)
parser.add_argument('-f','--force_psi',help='= 1 to force displaying the profiles versus poloidal flux', required=False)
parser.add_argument('-v','--verbose',help='= 1 to display numerical analysis of gaussian profiles', required=False)

args = vars(parser.parse_args())
shot,run = args['shot'],args['run']
shot,run = StrToList(shot),StrToList(run)

assert (len(shot)<=len(run)), 'There must be a run number corresponding to each shot'
if (len(run)>len(shot)):
    assert(len(shot)==1), 'Either give a shot for each run or give a single shot for every run'
    shot = len(run)*shot

# User or absolute path name
if args['user_or_path'] != None:
    user_or_path = args['user_or_path']
else:
    user_or_path = 'public'

# Database name
if args['database'] != None:
    database = args['database']
else:
    database = 'iter'

# Time
if args['time'] != None:
    time = args['time']
else:
    time = -99.

if args['verbose'] != None:
    verbose = bool(args['verbose'])
else:
    verbose = False


# Flag to force psi radial coordinate to be used
if args['force_psi'] != None:
    force_psi = int(args['force_psi'])
else:
    force_psi = 0

# DISPLAY PARAMETERS
# -------------------
fontsize = 12
figure_width  = 6.9
figure_height = 8

plt.rcParams['font.size'] = fontsize
plt.rcParams['axes.linewidth'] = 1.5
plt.rcParams['grid.alpha'] = 1.0

font = {'family': 'serif',
        'color':  'darkred',
        'weight': 'normal',
        'size': fontsize,
        }


# ----------------------------------------------------------------------

# Legend customization
def CustomLegend(legend):
    frame = legend.get_frame()
    frame.set_facecolor('0.95')
    for label in legend.get_texts():
        label.set_fontsize(fontsize)
    for label in legend.get_lines():
        label.set_linewidth(1.5)  # the legend line width    
    return

# ----------------------------------------------------------------------

# READ IDS'S FROM LOCAL DATABASE
# -------------------------------
version = os.getenv('IMAS_VERSION')[0]

nsimu = len(shot)
for isimu in range(nsimu):
    ishot= shot[isimu]
    irun = run[isimu]
    input = imas.ids(ishot,irun)

    input = imas.DBEntry(imas.imasdef.MDSPLUS_BACKEND,database,ishot,irun,user_or_path)
    err,idx = input.open()

    if err != 0:
        print('Shot ' + str(ishot) + ', run ' + str(irun) +' for user_or_path = '
              +user_or_path+' and database = '+database+' does not exist', file=sys.stderr)
        print('----> Aborted.', file=sys.stderr)
        exit()
 
    exec('waves_'+str(isimu)+' = input.get(\'waves\')') 
    input.close()

    # TIME VECTOR AND TIME INDEX
    # ---------------------------

    exec('timevec_'+str(isimu)+'= waves_'+str(isimu)+'.time')
    timevec = eval('timevec_'+str(isimu))
    exec('ntime_'+str(isimu)+'= len(timevec)')
    ntime = eval('ntime_'+str(isimu))
    
    if ntime==1:
        if len(timevec) > 0:
            tc = timevec[0]
        else:
            tc = 0
        it = 0
    else:
        if time>=0:
            [tc,it] = find_nearest(timevec,time)
        else:
            it = int(ntime/2)
            if len(timevec) > 0:
                tc = timevec[it]
            else:
                tc = 0
        print('--------------------------------------------------------------------------', file=sys.stderr)
        if len(timevec) > 0:
            print(' Time  = '+'%.2f' % tc+' s in range ['+'%.2f' % timevec[0]+','+'%.2f' % timevec[ntime-1]+'] s', file=sys.stderr)
            print(' Index = ',str(it), file=sys.stderr)        
            print(' Averaged resolution = ', (timevec[ntime-1]-timevec[0])/(ntime-1),' s', file=sys.stderr)  
            print('--------------------------------------------------------------------------', file=sys.stderr)
    time = tc

    exec('nwaves_'+str(isimu)+'= len(waves_'+str(isimu)+'.coherent_wave)')
    exec('is_active_'+str(isimu)+' = [0]*nwaves_'+str(isimu))
    exec('nrho_'+str(isimu)+' = 0')
    exec('psi_based_'+str(isimu)+' = 0')
    exec('psi_there_'+str(isimu)+' = 0')
    exec('waves = copy.deepcopy(waves_'+str(isimu)+')')
    for iwave in range(eval('nwaves_'+str(isimu))):
        if size(waves.coherent_wave[iwave].global_quantities) > 0:
            if waves.coherent_wave[iwave].global_quantities[0].power>0:
                exec('is_active_'+str(isimu)+'[iwave] = 1')
                try:
                    exec('rho_tor_norm_'+str(isimu)+' = 0')
                    if len(waves.coherent_wave[iwave].profiles_1d[it].grid.rho_tor_norm) > 0:
                        exec('nrho_'+str(isimu)+' = len(waves.coherent_wave[iwave].profiles_1d[it].grid.rho_tor_norm)')
                        exec('rho_tor_norm_'+str(isimu)+' = waves.coherent_wave[iwave].profiles_1d[it].grid.rho_tor_norm')
                    elif len(waves.coherent_wave[iwave].profiles_1d[it].grid.rho_tor) > 0:
                        exec('nrho_'+str(isimu)+' = len(waves.coherent_wave[iwave].profiles_1d[it].grid.rho_tor)')
                        exec('rho_tor_norm_'+str(isimu)+
                             ' = waves.coherent_wave[iwave].profiles_1d[it].grid.rho_tor/waves.coherent_wave[iwave].profiles_1d[it].grid.rho_tor[nrho-1]')
                    elif len(waves.coherent_wave[iwave].profiles_1d[it].grid.psi) > 0:
                        exec('psi_based_'+str(isimu)+' = 1')
                        exec('nrho_'+str(isimu)+' = len(waves.coherent_wave[iwave].profiles_1d[it].grid.psi)')
                        exec('rho_tor_norm_'+str(isimu)+' = -waves.coherent_wave[iwave].profiles_1d[it].grid.psi')
                except:
                    print('waves.coherent_wave[iwave].profiles_1d[it].grid.rho_tor_norm, rho_tor and psi could not be read', file=sys.stderr)
                    print('----> Aborted.', file=sys.stderr)
                    exit()
                if eval('nrho_'+str(isimu))==0:
                    print('waves.coherent_wave[iwave].profiles_1d[it].grid.rho_tor_norm, rho_tor and psi are empty', file=sys.stderr)
                    print('----> Aborted.', file=sys.stderr)
                    exit()
                if len(waves.coherent_wave[iwave].profiles_1d[it].grid.psi) > 0:
                    exec('psi_there_'+str(isimu)+' = 1')
                    exec('npsi_'+str(isimu)+' = len(waves.coherent_wave[iwave].profiles_1d[it].grid.psi)')
                    exec('psi1d_'+str(isimu)+' = -waves.coherent_wave[iwave].profiles_1d[it].grid.psi')
        else:
            print('waves.coherent_wave[iwave].global_quantities has not been allocated')
            print('----> Aborted.', file=sys.stderr)
            exit()

    if force_psi == 1:
        if eval('psi_there_'+str(isimu)) == 0:
            print('The psi radial coordinate forced but the 1D psi profile is not filled')
            print('----> Aborted.', file=sys.stderr)
            exit()
        else:
            exec('nrho_'+str(isimu)+' = npsi_'+str(isimu))
            exec('rho_tor_norm_'+str(isimu)+' = psi1d_'+str(isimu))
            exec('psi_based_'+str(isimu)+' = 1')

    if sum(eval('is_active_'+str(isimu)))==0:
        print('The waves IDS appears empty ----> Abort.', file=sys.stderr)
        exit()

    # LOOP OVER ALL EC LAUNCHERS
    exec('single_ec_launcher_name_'+str(isimu)+'         = dict()')
    exec('single_injected_power_'+str(isimu)+'           = dict()')   # for the chosen time slice
    exec('single_absorbed_power_'+str(isimu)+'           = dict()')   # for the chosen time slice
    exec('single_eccd_'+str(isimu)+'                     = dict()')   # for the chosen time slice
    exec('total_injected_power_'+str(isimu)+'            = 0')        # for the chosen time slice

    exec('total_power_density_profile_'+str(isimu)+'     = [0]*nrho_'+str(isimu)) # profile
    exec('total_current_density_profile_'+str(isimu)+'   = [0]*nrho_'+str(isimu)) # profile
    exec('single_power_density_profile_'+str(isimu)+'    = dict()')   # profile
    exec('single_current_density_profile_'+str(isimu)+'  = dict()')   # profile

    exec('total_power_waveform_'+str(isimu)+'    = [0]*ntime') # waveform
    exec('total_current_waveform_'+str(isimu)+'  = [0]*ntime') # waveform
    exec('single_power_waveform_'+str(isimu)+'   = dict()')    # waveform
    exec('single_current_waveform_'+str(isimu)+' = dict()')    # waveform

    exec('waves = copy.deepcopy(waves_'+str(isimu)+')')
    exec('codename_'+str(isimu)+' = waves.code.name.upper()')

    for iwave in range(eval('nwaves_'+str(isimu))):
        if(len(waves.coherent_wave[iwave].identifier.antenna_name)>0):
            exec('single_ec_launcher_name_'+str(isimu)+'[iwave] = waves.coherent_wave[iwave].identifier.antenna_name')
        else:
            exec('single_ec_launcher_name_'+str(isimu)+'[iwave] = \'Launcher\'+str(iwave+1)')
        if eval('is_active_'+str(isimu)+'[iwave]'):
            exec('single_power_waveform_'+str(isimu)+'[iwave]   = []')
            exec('single_current_waveform_'+str(isimu)+'[iwave] = []')
            for itime in range(ntime):
                exec('single_power_waveform_'+str(isimu)+'[iwave].append(waves.coherent_wave[iwave].global_quantities[itime].electrons.power_thermal)')
                exec('single_current_waveform_'+str(isimu)+'[iwave].append(waves.coherent_wave[iwave].global_quantities[itime].current_tor)')
                exec('total_power_waveform_'+str(isimu)+'[itime]   = total_power_waveform_'+str(isimu)+'[itime]   + waves.coherent_wave[iwave].global_quantities[itime].electrons.power_thermal')
                exec('total_current_waveform_'+str(isimu)+'[itime] = total_current_waveform_'+str(isimu)+'[itime] + waves.coherent_wave[iwave].global_quantities[itime].current_tor')
            exec('total_power_density_profile_'+str(isimu)+'            = total_power_density_profile_'+str(isimu)+'  + waves.coherent_wave[iwave].profiles_1d[it].power_density')
            exec('single_power_density_profile_'+str(isimu)+'[iwave]    = waves.coherent_wave[iwave].profiles_1d[it].power_density')
            exec('total_current_density_profile_'+str(isimu)+'         = total_current_density_profile_'+str(isimu)+'   + waves.coherent_wave[iwave].profiles_1d[it].current_parallel_density')
            exec('single_current_density_profile_'+str(isimu)+'[iwave] = waves.coherent_wave[iwave].profiles_1d[it].current_parallel_density')
            exec('single_injected_power_'+str(isimu)+'[iwave] = 0.')
            for ibeam in range(len(waves.coherent_wave[iwave].beam_tracing[it].beam)):
                if waves.coherent_wave[iwave].beam_tracing[it].beam[ibeam].power_initial > 0:
                    exec('total_injected_power_'+str(isimu)+'         = total_injected_power_'+str(isimu)+' + waves.coherent_wave[iwave].beam_tracing[it].beam[ibeam].power_initial')
                    exec('single_injected_power_'+str(isimu)+'[iwave] = single_injected_power_'+str(isimu)+'[iwave] + waves.coherent_wave[iwave].beam_tracing[it].beam[ibeam].power_initial')
            exec('single_absorbed_power_'+str(isimu)+'[iwave] = waves.coherent_wave[iwave].global_quantities[it].power')
            exec('single_eccd_'+str(isimu)+'[iwave]           = waves.coherent_wave[iwave].global_quantities[it].current_tor')
            print(' '+eval('single_ec_launcher_name_'+str(isimu)+'[iwave]')+' is active with a power of {:.2f}'.format(eval('single_injected_power_'+str(isimu)+'[iwave]')*1.e-6)
                  +' MW --> Absorbed power = {:.2f}'.format(eval('single_absorbed_power_'+str(isimu)+'[iwave]')*1.e-6)+' MW', file=sys.stderr)
            print('                                           --> ECCD =  {:.2f}'.format(eval('single_eccd_'+str(isimu)+'[iwave]')*1.e-3)+' kA', file=sys.stderr)
        else:
            print(' '+eval('single_ec_launcher_name_'+str(isimu)+'[iwave]')+' is off', file=sys.stderr)
    print('--------------------------------------------------------------------------', file=sys.stderr)

fig1,ax1 =plt.subplots(1,1)
fig2,ax2 =plt.subplots(1,1) 
ax1.set_title('ECRH Profiles')
ax2.set_title('ECCD Profiles')
firstloop = True
for isimu in range(nsimu):
    ishot = shot[isimu]
    irun = shot[isimu]
    # PROFILE OF ABSORBED POWER DENSITY [MW/M3]
    if sum(eval('is_active_'+str(isimu)))>0:
        totalx1 = eval('rho_tor_norm_'+str(isimu))
        totaly1 = eval('total_power_density_profile_'+str(isimu)+'*1.e-6')
        totallabel1 = 'Total-'+eval('codename_'+str(isimu))
        ax1.plot(totalx1,totaly1,label=totallabel1)
        if (verbose):    
            maxima = find_maxima(totaly1)
            print('There are '+str(len(maxima)-1)+' maxima:')
            fwhm = []
            for i in range(len(maxima)):
                if (i == 0):
                    fwhm.append(find_fwhm(totalx1,totaly1,maxima[0],0,(maxima[0]+maxima[1])//2))
                elif (i == len(maxima) - 1):
                    fwhm.append(find_fwhm(totalx1,totaly1,maxima[i],(maxima[i-1]+maxima[i])//2,len(totaly1)))
                    print('('+str(totalx1[maxima[i]])+', '+str(totaly1[maxima[i]])+') --- fwhm: '+str(fwhm[i]))
                else:
                    fwhm.append(find_fwhm(totalx1,totaly1,maxima[i],(maxima[i-1]+maxima[i])//2,(maxima[i]+maxima[i+1])//2))
                    print('('+str(totalx1[maxima[i]])+', '+str(totaly1[maxima[i]])+') --- fwhm: '+str(fwhm[i]))
            
        #print(fwhm[1:])
    if (nsimu == 1):
        for iwave in range(eval('nwaves_'+str(isimu))):
            if eval('is_active_'+str(isimu)+'[iwave]'):
                exec('ax1.plot(rho_tor_norm_'+str(isimu)+', single_power_density_profile_'+str(isimu)+'[iwave]*1.e-6,linestyle="--",label=single_ec_launcher_name_'+str(isimu)+'[iwave])')
    ax1.set_ylabel('Absorbed power $\mathrm{[MW/m^{3}]}$')
    if psi_based_0 == 0:
        ax1.set_xlabel('Normalized toroidal flux coordinate')
    else:
        ax1.set_xlabel('-(Poloidal flux coordinate) [Wb]')
    ax1.grid(b=True)
    ax1.legend()
    fig1.set_size_inches(figure_width,figure_height)
    fig1.tight_layout()
    fig1.savefig('ECRH_profile_shot_{0}_run_{1}.png'.format(ishot,irun),bbox_inches="tight")

    # ECCD PROFILE [MA/M2]
    exec('is_active = is_active_'+str(isimu))
    exec('rho_tor_norm = rho_tor_norm_'+str(isimu))
    exec('total_current_density_profile = total_current_density_profile_'+str(isimu))
    exec('single_current_density_profile = single_current_density_profile_'+str(isimu))
    exec('single_ec_launcher_name = single_ec_launcher_name_'+str(isimu))
    exec('psi_based = psi_based_'+str(isimu))
    exec('total_current_waveform = total_current_waveform_'+str(isimu))
    exec('single_current_waveform = single_current_waveform_'+str(isimu))
    exec('nwaves = nwaves_'+str(isimu))
    if sum(is_active)>0:
        totalx2 = rho_tor_norm
        totaly2 = total_current_density_profile*1.e-6
        totallabel2 = 'Total-'+eval('codename_'+str(isimu))
        ax2.plot(totalx2, totaly2,label=totallabel2)
        if (verbose):    
            minima = find_minima(totaly2)
            print('There are '+str(len(minima))+' minima:')
            fwhm = []
            for i in range(len(minima)):
                if (i == 0):
                    fwhm.append(find_fwhm(totalx2,totaly2,minima[0],0,(minima[0]+minima[1])//2))
                elif (i == len(minima) - 1):
                    fwhm.append(find_fwhm(totalx2,totaly2,minima[i],(minima[i-1]+minima[i])//2,len(totaly2)))
                else:
                    fwhm.append(find_fwhm(totalx2,totaly2,minima[i],(minima[i-1]+minima[i])//2,(minima[i]+minima[i+1])//2))
                print('('+str(totalx2[minima[i]])+', '+str(totaly2[minima[i]])+') --- fwhm: '+str(fwhm[i]))
        #print(fwhm)
    if (nsimu == 1):
        for iwave in range(nwaves):
            if is_active[iwave]:
                ax2.plot(rho_tor_norm, single_current_density_profile[iwave]*1.e-6,linestyle="--",label=single_ec_launcher_name[iwave])
    ax2.set_ylabel('$\mathrm{ECCD} [MA/m^{2}]}$')
    if psi_based == 0:
        ax2.set_xlabel('Normalized toroidal flux coordinate')
    else:
        ax2.set_xlabel('-(Poloidal flux coordinate) [Wb]')
    ax2.grid(b=True)
    ax2.legend()
    fig2.set_size_inches(figure_width,figure_height)
    fig2.tight_layout()
    fig2.savefig('ECCD_profile_shot_{0}_run_{1}.png'.format(ishot,irun),bbox_inches="tight")
    
    # EC POWER AND ECCD WAVEFORMS
    #ntime = 2
    if ntime==1:
        print('Only one time slice --> ECRH and ECCD waveforms not displayed', file=sys.stderr)
        #plt.show(block=True)
    else:
        if (firstloop):
            fig3,ax3 =plt.subplots(1,1)
            ax3.set_title('ECRH Waveforms')
            ax3.set_ylabel('Power to the electrons $\mathrm{[MW]}$')
            ax3.set_xlabel('Time (s)')
        # EC POWER WAVEFORM
        if sum(is_active)>0:
            print(isimu)
            ax3.plot(eval('timevec_'+str(isimu)), array(eval('total_power_waveform_'+str(isimu)))*1.e-6,label='Total-'+eval('codename_'+str(isimu)))
        if (nsimu == 1):    
            for iwave in range(nwaves):
                if is_active[iwave]:
                    ax3.plot(timevec, array(eval('single_power_waveform_'+str(isimu)+'[iwave]'))*1.e-6,linestyle="--",label=single_ec_launcher_name[iwave])
        ax3.grid(b=True)
        ax3.legend()
        fig3.set_size_inches(figure_width,figure_height)
        fig3.tight_layout()
        fig3.savefig('ECRH_waveform_shot_{0}_run_{1}.png'.format(ishot,irun),bbox_inches="tight")

        # ECCD WAVEFORM
        if (firstloop):
            fig4,ax4 =plt.subplots(1,1)  
            ax4.set_title('ECCD Waveforms')
            ax4.set_ylabel('ECCD $\mathrm{[kA]}$')
            ax4.set_xlabel('Time (s)')
        if sum(is_active)>0:
            ax4.plot(eval('timevec_'+str(isimu)), array(eval('total_current_waveform_'+str(isimu)))*1.e-3,label='Total-'+eval('codename_'+str(isimu)))
        if (nsimu == 1):   
            for iwave in range(nwaves):
                if is_active[iwave]:
                    ax4.plot(timevec, array(eval('single_current_waveform_'+str(isimu)+'[iwave]'))*1.e-3,linestyle="--",label=single_ec_launcher_name[iwave])
        ax4.grid(b=True)
        ax4.legend()
        fig4.set_size_inches(figure_width,figure_height)
        fig4.tight_layout()
        fig4.savefig('ECCD_waveform_shot_{0}_run_{1}.png'.format(ishot,irun),bbox_inches="tight")
    firstloop = False
plt.show(block=True)
