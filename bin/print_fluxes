#! /usr/bin/env python
### David.Coster@ipp.mpg.de
import numpy as np
import imas
import argparse
import os,sys
from idstools.cli import *

db_group.add_argument("--tokamak", "-t", 
                   type=str, dest="database", default=os.getenv("TOKAMAKNAME"),
                   help="tokamak name \t[deprecated: use -d instead]")

parser = argparse.ArgumentParser(description="View information about fluxes", epilog
="""
""", formatter_class=argparse.RawTextHelpFormatter, parents=[imas_parser])
parser.add_argument("-S", "--SlicingMethod",
                    type=str, default="CLOSEST", 
                    choices=["CLOSEST","PREVIOUS","LINEAR"],
                    help="Slicing method \t(default=%(default)s)")
parser.add_argument("-o", "--occurrence", 
                    type=int, default=0,
                    help="occurrence")
parser.add_argument("shot", type=int, help="Shot number")
parser.add_argument("run", type=int, help="Run number")
parser.add_argument("time", type=float, help="Time")
args=parser.parse_args()

IDS = imas.DBEntry(get_backend_id(args.backend), args.database, args.shot, args.run, user_name=args.user)
status,idx = IDS.open()

if status!=0:
  print('Error opening pulse! Please check existence.')
  sys.exit(status)

T = IDS.get_slice('core_transport', args.time, get_slice_mode(args.SlicingMethod), occurrence=args.occurrence)
print('\nTime = %0.3f for %s/%s/%s/%s/%s\n' % (T.time, args.user, args.database, args.version, args.shot, args.run))

for t in T.model:
    print("%s (%s)" % (t.identifier.name, t.flux_multiplier))
    print("       electrons", end='')
    # electrons
    i= t.profiles_1d[0].electrons
    if len(i.particles.flux) == 0:
        print('     particles     --       ', end='')
    else:
        print('     particles %13.6e' % ((i.particles.flux * t.profiles_1d[0].grid_flux.surface)[-1]), end='')
    if len(i.energy.flux) == 0:
        print('     energy     --       ')
    else:
        print('     energy %13.6e' % ((i.energy.flux * t.profiles_1d[0].grid_flux.surface)[-1]))
    # ions
    for i in t.profiles_1d[0].ion:
        print("    ", i.element[0].a, i.element[0].z_n, i.z_ion, end='')
        if len(i.particles.flux) == 0:
           print('     particles     --       ', end='')
        else:
           print('     particles %13.6e' % ((i.particles.flux * t.profiles_1d[0].grid_flux.surface)[-1]), end='')
        if len(i.energy.flux) == 0:
           print('     energy     --     ')
        else:
           print('     energy %13.6e' % ((i.energy.flux * t.profiles_1d[0].grid_flux.surface)[-1]))
