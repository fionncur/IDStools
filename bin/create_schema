#!/usr/bin/env python
from os import getenv, path
import re
import yaml
import argparse
import imas
from xml.etree import ElementTree as ET


IMAS_DIR = "IMAS_PREFIX"
FILE_IDSDef = getenv(IMAS_DIR) + "/include/IDSDef.xml"


# ----------------------------------------------------------------------


def main():
    """
    create validation schema wrt DD
    """

    # Load IMAS-DD file
    if path.isfile(FILE_IDSDef):
        root = ET.parse(FILE_IDSDef).getroot()
    else:
        exit("file not found:{}".format(FILE_IDSDef))

    # Initialization for yaml.Dumper
    yaml.Dumper.ignore_aliases = lambda *args: True

    # Default rules for dynamic array
    common_schema = {"ids_nan": False, "ids_inf": False, "ids_dim": False}

    for dd in root:
        if dd.tag == "IDS":
            idsname = dd.get("name")
            if (args.idslist is None) or (idsname in args.idslist):
                out = {}
                wrk = {}
                for field in dd.iter():
                    data_type = field.attrib.get("data_type")
                    path_doc = field.attrib.get("path_doc")
                    # in case of data_type = INT_*D and FLT_*D
                    if (
                        data_type
                        and re.search("^(INT|FLT)_([1-9])D$", data_type) is not None
                    ):
                        # skip validation for error_upper and error_lower
                        if re.search("_error_(upper|lower)", path_doc) is None:
                            wrk[path_doc] = common_schema
                out[idsname] = wrk
                dump = yaml.dump(
                    out, indent=4, default_flow_style=False, sort_keys=False
                )
                print(dump)


# ----------------------------------------------------------------------


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="create validation schema wrt DD")
    parser.add_argument(
        "-i",
        "--idslist",
        dest="idslist",
        help="List of IDS names",
        required=False,
        nargs="*",
    )
    args = parser.parse_args()
    main()
