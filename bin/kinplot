                                        ion_vpol[ispecies][nrho+i] = ion_vpol[ispecies][nrho+i] + abs(edge_profiles.ggd[0].ion[jspecies].state[istate].velocity[gset].poloidal[i])*edge_profiles.ggd[0].ion[jspecies].state[istate].density[gset].values[i]/ion_density[ispecies][nrho+i]
