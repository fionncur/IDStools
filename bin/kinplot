# ----------------------------------------------------------------------

if (nspecies > 0):

    # Plasma composition
    species = []
    for ispecies in range(nspecies):
        if n[ispecies] == 1:
            species.append(table_mendeleiev[z[ispecies]][a[ispecies]].element)
        else:
            if core_present:
                species.append(core_profiles.profiles_1d[0].ion[ispecies].label)
            else:
                if not r_out_graph:
                    species.append(edge_profiles.profiles_1d[0].ion[ispecies].label)
                else:
                    species.append(edge_profiles.ggd[0].ion[ispecies].label)

if (nspecies > 0) and plot_compo:

    if debug and edge_present and core_present:
        print('Species_mapping :', file=sys.stdout)
        for ispecies in range(nspecies):
             if species_map[ispecies] != -99:
                 print(f'Core species {ispecies} is {species[ispecies]} and maps to edge species {species_map[ispecies]}', file=sys.stdout)
             else:
                 print(f'Core species {ispecies} is {species[ispecies]} and does not map to edge species', file=sys.stdout)

    # Species concentrations
    ntot = 0
    imax = -99
    species_density = [0] * nspecies
    max_density = -999.
    nspec_over_ntot = [0] * nspecies
    nspec_over_ne = [0] * nspecies
    nspec_over_nmaj = [0] * nspecies
    if core_present:
        for ispecies in range(nspecies):
            species_density[ispecies] = sum(volume[0:nrho-1]*core_profiles.profiles_1d[0].ion[ispecies].density[0:nrho-1])
            ntot = ntot + species_density[ispecies]
            if species_density[ispecies] > max_density:
                max_density = species_density[ispecies]
                imax = ispecies

        ne = sum(volume[0:nrho-1]*core_profiles.profiles_1d[0].electrons.density[0:nrho-1])

        nspec_over_ntot = species_density/ntot
        nspec_over_ne   = species_density/ne
        if imax != -99:
            nspec_over_nmaj = species_density/species_density[imax]
        else:
            nspec_over_nmaj = 0

    # When a species appears twice: combine
    for ispecies in range(nspecies):
        for jspecies in range(nspecies):
            if (species[jspecies] == species[ispecies]) & (jspecies != ispecies):
                nspec_over_ntot[ispecies] = nspec_over_ntot[ispecies] + nspec_over_ntot[jspecies]
                nspec_over_ntot[jspecies] = 0
                nspec_over_ne[ispecies] = nspec_over_ne[ispecies] + nspec_over_ne[jspecies]
                nspec_over_ne[jspecies] = 0
                nspec_over_nmaj[ispecies] = nspec_over_nmaj[ispecies] + nspec_over_nmaj[jspecies]
                nspec_over_nmaj[jspecies] = 0

    # Nice display of plasma composition with species concentrations
    disp_species         = '   species:      '
    disp_a               = '   a:            '
    disp_z               = '   z:            '
    disp_nspec_over_ntot = '   n_over_ntot:  '
    disp_nspec_over_ne   = '   n_over_ne:    '
    disp_nspec_over_nmaj = '   n_over_n_maj: '
    for ispecies in range(nspecies):
        if nspec_over_ne[ispecies] > 0.:
            tabsize = 8
            disp_species = disp_species + species[ispecies] + ' ' * (tabsize-len(species[ispecies]))
            disp_a = disp_a + format('%.1f' % a[ispecies]) + ' ' * (tabsize-len(format('%.1f' % a[ispecies])))
            disp_z = disp_z + format('%.1f' % z[ispecies]) + ' ' * (tabsize-len(format('%.1f' % z[ispecies])))
            disp_nspec_over_ntot = disp_nspec_over_ntot + format('%.3f' % nspec_over_ntot[ispecies]) \
                                   + ' ' * (tabsize-len(format('%.3f' % nspec_over_ntot[ispecies])))
            disp_nspec_over_ne   = disp_nspec_over_ne   + format('%.3f' % nspec_over_ne[ispecies])   \
                                   + ' ' * (tabsize-len(format('%.3f' % nspec_over_ne[ispecies])))
            disp_nspec_over_nmaj = disp_nspec_over_nmaj + format('%.3f' % nspec_over_nmaj[ispecies]) \
                                   + ' ' * (tabsize-len(format('%.3f' % nspec_over_nmaj[ispecies])))

    if core_present == 1:
        print('   ------------', file=sys.stdout)
        print(disp_species, file=sys.stdout)
        print(disp_a, file=sys.stdout)
        print(disp_z, file=sys.stdout)
        print(disp_nspec_over_ntot, file=sys.stdout)
        print(disp_nspec_over_ne, file=sys.stdout)
        print(disp_nspec_over_nmaj, file=sys.stdout)
        print('   ------------', file=sys.stdout)

else:
    nspec_over_ne = [0]*nspecies

# ----------------------------------------------------------------------

# Criteria for significant impurity (in X[imp]/ne concentration)
impurity_limit = 0.001

# Create the dictionary defining the list of profiles that can be displayed
profiles = {}
if core_present:
    profiles['rhonorm'] = [0] * nrho
    profiles['te'] = [0] * nrho
    if ti_flag != 0:
        profiles['ti'] = [0] * nrho
    profiles['ne'] = [0] * nrho
    profiles['zeff'] = [0] * nrho
    for i in range(nrho):
        profiles['rhonorm'][i] = rho_tor_norm[i]
        profiles['te'][i] = electron_temperature[i]
        if ti_flag != 0:
            profiles['ti'][i] = ion_temperature[i]
        profiles['ne'][i] = electron_density[i]
        profiles['zeff'][i] = zeff[i]
if edge_present:
    profiles['rhonorm_e'] = [0] * erho
    profiles['te_e'] = [0] * erho
    if ti_e_flag != 0:
        profiles['ti_e'] = [0] * erho
    profiles['ne_e'] = [0] * erho
    profiles['zeff_e'] = [0] * erho
    for i in range(erho):
        profiles['rhonorm_e'][i] = rho_tor_norm[nrho+i]
        profiles['te_e'][i] = electron_temperature[nrho+i]
        if ti_e_flag != 0:
            profiles['ti_e'][i] = ion_temperature[nrho+i]
        profiles['ne_e'][i] = electron_density[nrho+i]
        profiles['zeff_e'][i] = zeff[nrho+i]

profiles['n_species'] = {}
for ispecies in range(nspecies):
    profiles['n_species'][species[ispecies]]={}
if core_present:
    profiles['ni'] = [0] * nrho
    for ispecies in range(nspecies):
        if plot_compo == 1:
            if nspec_over_ne[ispecies] > impurity_limit:
                profiles['n_species'][species[ispecies]]['density'] = [0] * nrho
                if vpol_flag != 0:
                    profiles['n_species'][species[ispecies]]['vpol'] = [0] * nrho
                if vtor_flag != 0:
                    profiles['n_species'][species[ispecies]]['vtor'] = [0] * nrho
                for i in range(nrho):
                    profiles['n_species'][species[ispecies]]['density'][i] = ion_density[ispecies][i]
                    if vpol_flag != 0:
                        profiles['n_species'][species[ispecies]]['vpol'][i] = ion_vpol[ispecies][i]
                    if vtor_flag != 0:
                        profiles['n_species'][species[ispecies]]['vtor'][i] = ion_vtor[ispecies][i]
    for i in range(nrho):
        profiles['ni'][i] = profiles['ni'][i] + ion_density[ispecies][i]
if edge_present:
    profiles['ni_e'] = [0] * erho
    for ispecies in range(nspecies):
        if species_map[ispecies] != -99:
            profiles['n_species'][species[ispecies]]['density_e'] = [0] * erho
            if vpol_e_flag != 0:
                profiles['n_species'][species[ispecies]]['vpol_e'] = [0] * erho
            if vtor_e_flag != 0:
                profiles['n_species'][species[ispecies]]['vtor_e'] = [0] * erho
            for i in range(erho):
                profiles['n_species'][species[ispecies]]['density_e'][i] = ion_density[ispecies][nrho+i]
                if vpol_e_flag != 0:
                    profiles['n_species'][species[ispecies]]['vpol_e'][i] = ion_vpol[ispecies][nrho+i]
                if vtor_e_flag != 0:
                    profiles['n_species'][species[ispecies]]['vtor_e'][i] = ion_vtor[ispecies][nrho+i]
        if species_map[ispecies] != -99:
            for i in range(erho):
                profiles['ni_e'][i] = profiles['ni_e'][i] + ion_density[ispecies][nrho+i]

# Min and max of velocity profiles
max_vtor = -9e99
min_vtor =  9e99
max_vpol = -9e99
min_vpol =  9e99
for ispecies in range(nspecies):
    if plot_compo and (nspec_over_ne[ispecies] > impurity_limit or not core_present):
        if vtor_flag != 0:
            if 'vtor' in profiles['n_species'][species[ispecies]].keys():
                if max_vtor < max(profiles['n_species'][species[ispecies]]['vtor'][0:nrho-1]):
                    max_vtor = max(profiles['n_species'][species[ispecies]]['vtor'][0:nrho-1])
                if min_vtor > min(profiles['n_species'][species[ispecies]]['vtor'][0:nrho-1]):
                    min_vtor = min(profiles['n_species'][species[ispecies]]['vtor'][0:nrho-1])
        if edge_present and species_map[ispecies] != -99 and vtor_e_flag != 0:
            if 'vtor_e' in profiles['n_species'][species[ispecies]].keys():
                if max_vtor < max(profiles['n_species'][species[ispecies]]['vtor_e'][0:erho-1]):
                    max_vtor = max(profiles['n_species'][species[ispecies]]['vtor_e'][0:erho-1])
                if min_vtor > min(profiles['n_species'][species[ispecies]]['vtor_e'][0:erho-1]):
                    min_vtor =  min(profiles['n_species'][species[ispecies]]['vtor_e'][0:erho-1])
        if vpol_flag != 0:
            if 'vpol' in profiles['n_species'][species[ispecies]].keys():
                if max_vpol < max(profiles['n_species'][species[ispecies]]['vpol'][0:nrho-1]):
                    max_vpol = max(profiles['n_species'][species[ispecies]]['vpol'][0:nrho-1])
                if min_vpol > min(profiles['n_species'][species[ispecies]]['vpol'][0:nrho-1]):
                    min_vpol = min(profiles['n_species'][species[ispecies]]['vpol'][0:nrho-1])
        if edge_present and species_map[ispecies] != -99 and vpol_e_flag != 0:
            if 'vpol_e' in profiles['n_species'][species[ispecies]].keys():
                if max_vpol < max(profiles['n_species'][species[ispecies]]['vpol_e'][0:erho-1]):
                    max_vpol = max(profiles['n_species'][species[ispecies]]['vpol_e'][0:erho-1])
                if min_vpol > min(profiles['n_species'][species[ispecies]]['vpol_e'][0:erho-1]):
                    min_vpol = min(profiles['n_species'][species[ispecies]]['vpol_e'][0:erho-1])

if debug:
    if vtor_flag != 0 or vtor_e_flag != 0:
        print('max_vtor : '+str(max_vtor), file=sys.stdout)
        print('min_vtor : '+str(min_vtor), file=sys.stdout)
    if vpol_flag != 0 or vpol_e_flag != 0:
        print('max_vtor : '+str(max_vpol), file=sys.stdout)
        print('min_vpol : '+str(min_vpol), file=sys.stdout)

# Create the dictionary defining the list of waveforms (central values) that can be displayed
def createWaveForm(ndim):
    return {'central': [0]*ndim,'edge': [0]*ndim,'rho95': [0]*ndim}


if core_present:
    waveform = {}
    waveform['time'] = timevec
    for ikey in ['te','ti','ne','zeff']:
        waveform[ikey] = createWaveForm(0)

    waveform['te']['central'] = input.partial_get('core_profiles','profiles_1d(:)/electrons/temperature(0)')*1e-3
    if ti_flag == 1:
        waveform['ti']['central'] = input.partial_get('core_profiles','profiles_1d(:)/t_i_average(0)')*1e-3
    else:
        try:
            waveform['ti']['central'] = input.partial_get('core_profiles','profiles_1d(:)/ion(0)/temperature(0)')*1e-3
        except:
            waveform['ti']['central'] = [NaN]*ntime

    waveform['ne']  ['central'] = input.partial_get('core_profiles','profiles_1d(:)/electrons/density(0)')
    waveform['zeff']['central'] = input.partial_get('core_profiles','profiles_1d(:)/zeff(0)')

    waveform['n_species'] = {}
    waveform['ni'] = createWaveForm(ntime)
    for ispecies in range(nspecies):
        if plot_compo and (nspec_over_ne[ispecies] > impurity_limit):
            waveform['n_species'][species[ispecies]]={'density' : createWaveForm(0), 'vpol' : createWaveForm(0),'vtor' : createWaveForm(0)}

            try:
                waveform['n_species'][species[ispecies]]['density']['central'] = \
                    input.partial_get('core_profiles',f'profiles_1d(:)/ion({ispecies})/density(0)')
                if vpol_flag == 1:
                    waveform['n_species'][species[ispecies]]['vpol']['central'] = \
                        input.partial_get('core_profiles',f'profiles_1d(:)/ion({ispecies})/velocity/poloidal(0)')
                elif vpol_flag == 2:
                    waveform['n_species'][species[ispecies]]['vpol']['central'] = \
                        input.partial_get('core_profiles',f'profiles_1d(:)/ion({ispecies})/velocity_pol(0)')
                if vtor_flag == 1:
                    waveform['n_species'][species[ispecies]]['vtor']['central'] = \
                        input.partial_get('core_profiles',f'profiles_1d(:)/ion({ispecies})/velocity/toroidal(0)')
                elif vtor_flag == 2:
                    waveform['n_species'][species[ispecies]]['vtor']['central'] = \
                        input.partial_get('core_profiles',f'profiles_1d(:)/ion({ispecies})/velocity_tor(0)')
            except:
                waveform['n_species'][species[ispecies]]['density']['central'] = [NaN]*ntime
                waveform['n_species'][species[ispecies]]['vpol']   ['central'] = [NaN]*ntime
                waveform['n_species'][species[ispecies]]['vtor']   ['central'] = [NaN]*ntime

            for itime in range(ntime):
                waveform['ni']['central'][itime] = waveform['ni']['central'][itime] + waveform['n_species'][species[ispecies]]['density']['central'][itime]

