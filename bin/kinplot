ax = plt.gca()
xmin, xmax = ax.get_xlim()
ymin, ymax = ax.get_ylim()
plt.text(xmax-0.2*(xmax-xmin),ymin-0.4*(ymax-ymin),f'{hostdir} - Shot {args.shot} / Run {args.run}',fontsize=6,color='black')

#plt.subplots_adjust(left=None, bottom=None, right=None, top=None, wspace=1.5, hspace=0.5)

fig = plt.gcf()
fig.set_size_inches(12,7)
fig.tight_layout()

try:
    fname = f'Kinetic_shot_{args.shot}_run_{args.run}_time_{args.time}.png'
    fig.savefig(fname, dpi=100)
    print(f'----> Figure saved to {fname}', file=sys.stderr)
except:
    print('The figure could not be saved (check local permissions).', file=sys.stderr)

plt.show()


