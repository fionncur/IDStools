#!/usr/bin/env python
from __future__ import print_function

import os, sys, glob, yaml, argparse, re, imas, pdb
from operator import itemgetter
from stat import *
from numpy import *
import database_tools.init_mendeleiev as mend
from idstools.cli import *

# ----------------------------------------------------------------------

def find_nearest(a, a0):
    'Element in nd array `a` closest to the scalar value `a0`'
    idx = abs(a - a0).argmin()
    return a.flat[idx],idx

# ----------------------------------------------------------------------

# Management of input arguments
parser = argparse.ArgumentParser(description=\
                                 '---- Display the plasma kinetic profiles from the core_profiles IDSs',
                                 parents=[imas_parser])
parser.add_argument('-s','--shot',help='Shot number',required=True,type=int)
parser.add_argument('-r','--run',help='Run number',required=True,type=int)
parser.add_argument('-t','--time',help='Time',required=False,type=float,default=-99.0)
parser.add_argument('-e','--edge',help ='Add edge profiles if available',action='store_true')
parser.add_argument('-V','--verbose',help='Verbose output',action='store_true')

args = parser.parse_args()
debug = args.verbose

# For execution from python shell
#args = {'run': 6, 'database': None, 'user_or_path': None, 'time': None, 'shot': 4321, 'edge': False}

# Open the database and read the necessary IDSs
input=imas.DBEntry(get_backend_id(args.backend), args.database, args.shot, args.run, user_name=args.user, data_version=args.version)
err,n=input.open()
if err != 0:
    print(f'Shot {args.shot}, run {args.run} for user {args.user} and database {args.database} does not exist', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

if args.user == 'public':
    publichome = os.getenv("IMAS_HOME")
    if (publichome == None):
        print("Environment variable IMAS_HOME is not defined. Quitting.", file=sys.stderr)
        sys.exit(1)
    DB_ABS_PATH = f'{publichome}/shared/imasdb/{args.database}/{args.version}/{args.run//10000}'
else:
    DB_ABS_PATH = f'{os.path.expanduser("~{}".format(args.user))}/public/imasdb/{args.database}/{args.version}/{args.run//10000}'

core_present = True
try:
    core_profiles = imas.core_profiles() # To initialise the empty IDS structure
    core_profiles.time = input.partial_get('core_profiles','time')
    if core_profiles.time is None:
        print('No core_profiles IDS in the data-entry.', file=sys.stdout)
        core_present = False
except:
    print('The core_profiles IDS is absent from the input data-entry.', file=sys.stdout)
    core_present = False

edge_present = False
if args.edge:
    try:
        edge_profiles = imas.edge_profiles() # Bring in edge_profiles IDS if available
        edge_profiles.time = input.partial_get('edge_profiles','time')
        if len(edge_profiles.time) > 0:
            if core_present:
                print('Found adjoining edge_profiles. Will attempt to add to plots.', file=sys.stdout)
            else:
                print('Found edge_profiles IDS in data-entry. Will only plot edge data.', file=sys.stdout)
            edge_present = True
    except:
        print('No associated edge_profiles data.', file=sys.stderr)

if not core_present and not edge_present:
    print('No data found to plot. --> Abort.', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

eq_present = False
try:
    equilibrium = imas.equilibrium() # Bring in equilibrium IDS if available
    equilibrium.time = input.partial_get('equilibrium','time')
    if len(equilibrium.time) > 0:
        eq_present = True
except:
    print('No associated equilibrium data.', file=sys.stderr)

hostdir = os.environ["HOSTNAME"]+":"+DB_ABS_PATH
hostdir = hostdir[:-2]

# ----------------------------------------------------------------------

# Search for adequate time slice for display
if core_present:
    ntime = len(core_profiles.time)
    timevec = core_profiles.time
else:
    ntime = len(edge_profiles.time)
    timevec = edge_profiles.time
time = args.time

if ntime > 1:
    if time >= 0:
        [tc,it] = find_nearest(timevec,time)
    else:
        it = int(ntime/2)
        tc = timevec[it]
    print('   Time  = '+'%.2f' % tc+' s in range ['+'%.2f' % timevec[0]+','+'%.2f' % timevec[ntime-1]+'] s.', file=sys.stdout)
    print('   Index = ',str(it), file=sys.stdout)
    print('   Averaged resolution = ', (timevec[ntime-1]-timevec[0])/(ntime-1),' s.', file=sys.stdout)
else:
    if len(timevec) > 0:
        tc = timevec[0]
    else:
        tc = 0
    it = 0

time = tc

# Read 1D-profiles for this time slice
if core_present:
    core_profiles.profiles_1d.resize(1)
    core_profiles.profiles_1d[0] = input.partial_get('core_profiles',f'profiles_1d({it})')

# Read equilibrium data for this time slice if present
if eq_present:
    qtime = len(equilibrium.time)
    timeeq = equilibrium.time
    if qtime > 1:
        if time >= 0:
            [tq,qt] = find_nearest(timeeq,time)
        else:
            qt = int(qtime/2)
            tq = timeeq[qt]
        print('   Time (equ) = '+'%.2f' % tq+' s in range ['+'%.2f' % timeeq[0]+','+'%.2f' % timeeq[qtime-1]+'] s.', file=sys.stdout)
        print('   Index = ',str(qt), file=sys.stdout)
        print('   Averaged equilibrium time resolution = ', (timeeq[qtime-1]-timeeq[0])/(qtime-1),' s.', file=sys.stdout)
    else:
        if len(timeeq) > 0:
            tq = timeeq[0]
        else:
            tq = 0
        qt = 0

# Add 1D-profiles edge data if present
r_out_graph = False
if edge_present:
    etime = len(edge_profiles.time)
    timeedg = edge_profiles.time
    if etime > 1:
        if time >= 0:
            [te,et] = find_nearest(timeedg,time)
        else:
            et = int(etime/2)
            te = timeedg[et]
        print('   Time (edge) = '+'%.2f' % te+' s in range ['+'%.2f' % timeedg[0]+','+'%.2f' % timeedg[etime-1]+'] s', file=sys.stdout)
        print('   Index = ',str(et), file=sys.stdout)
        print('   Averaged edge time resolution = ', (timeedg[etime-1]-timeedg[0])/(etime-1),' s', file=sys.stdout)
    else:
        if len(timeedg) > 0:
            te = timeedg[0]
        else:
            te = 0
        et = 0

    # Read edge_profile data for this time slice
    try:
        edge_profiles.profiles_1d.resize(1)
        edge_profiles.profiles_1d[0] = input.partial_get('edge_profiles',f'profiles_1d({et})')
        teme = te
    except:
        print('No profiles_1d information found in edge_profiles IDS.', file=sys.stdout)
        if eq_present and len(equilibrium.time) > 0:
            equilibrium.time_slice.resize(1)
            equilibrium.time_slice[0] = input.partial_get('equilibrium',f'time_slice({qt})')
            tqme = tq
            if len(equilibrium.time_slice[0].profiles_1d.r_outboard) > 0 or not core_present:
                edge_profiles.grid_ggd.resize(1)
                try:
                    edge_profiles.grid_ggd[0] = input.partial_get('edge_profiles',f'grid_ggd({et})')
                except:
                    edge_present = False
                    print('No grid_ggd information found in edge_profiles IDS.', file=sys.stderr)
                edge_profiles.ggd.resize(1)
                try:
                    edge_profiles.ggd[0] = input.partial_get('edge_profiles',f'ggd({et})')
                except:
                    edge_present = False
                    print('No ggd information found in edge_profiles IDS.', file=sys.stderr)
                if edge_present:
                    r_out_graph = True
                    print('Attempting to use R_outboard coordinate instead.', file=sys.stdout)
            else:
                if core_present:
                    edge_present = False
        else:
            if core_present:
                edge_present = False
            else:
                edge_profiles.grid_ggd.resize(1)
                try:
                    edge_profiles.grid_ggd[0] = input.partial_get('edge_profiles',f'grid_ggd({et})')
                except:
                    edge_present = False
                    print('No grid_ggd information found in edge_profiles IDS.', file=sys.stderr)
                edge_profiles.ggd.resize(1)
                try:
                    edge_profiles.ggd[0] = input.partial_get('edge_profiles',f'ggd({et})')
                except:
                    edge_present = False
                    print('No ggd information found in edge_profiles IDS.', file=sys.stderr)
                if edge_present:
                    r_out_graph = True
                    print('Attempting to use R coordinate instead.', file=sys.stdout)

gset = -99
if r_out_graph:
    nsubsets = len(edge_profiles.grid_ggd[0].grid_subset)
    for iset in range(nsubsets):
        if edge_profiles.grid_ggd[0].grid_subset[iset].identifier.index == 11:
            gset = iset
    if gset == -99:
        print('Did not find outer_midplane GGD grid subset.', file=sys.stderr)
        print('Abandoning edge plots !', file=sys.stderr)
        edge_present = False
        r_out_graph = False
    else:
        if debug:
            print('Outer midplane GGD grid subset is number '+str(gset+1)+' of '+str(nsubsets), file=sys.stdout)
    try:
        if edge_profiles.midplane.index != 1 and r_out_graph and core_present:
            print('Edge and core profile midplane coordinates are not aligned!', file=sys.stdout)
    except:
        print('Edge_profiles midplane location not specified! Coordinates may be misaligned.', file=sys.stdout)

# Mendeleiev table
table_mendeleiev = mend.create_table_mendeleiev()

# ----------------------------------------------------------------------

# A priori the plasma composition can be read
plot_compo = True

# Obtain array sizes
nrho = 0
mrho = 0
if not r_out_graph and core_present:
    try:
        if len(core_profiles.profiles_1d[0].grid.rho_tor_norm) > 0:
            nrho = len(core_profiles.profiles_1d[0].grid.rho_tor_norm)
        elif len(core_profiles.profiles_1d[0].grid.rho_tor) > 0:
            nrho = len(core_profiles.profiles_1d[0].grid.rho_tor)
    except:
        print('core_profiles.profiles_1d[:].grid.rho_tor_norm and rho_tor could not be read.', file=sys.stderr)
        print('----> Aborted.', file=sys.stderr)
        exit()
    if nrho == 0:
        print('core_profiles.profiles_1d[:].grid.rho_tor_norm and rho_tor are empty.', file=sys.stderr)
        print('----> Aborted.', file=sys.stderr)
        exit()
else:
    if core_present:
        if len(equilibrium.time_slice[0].profiles_1d.rho_tor_norm) ==  len(core_profiles.profiles_1d[0].grid.rho_tor_norm):
            nrho = len(equilibrium.time_slice[0].profiles_1d.rho_tor_norm)
        else:
            for i in range(len(equilibrium.time_slice[0].profiles_1d.rho_tor_norm)):
                if equilibrium.time_slice[0].profiles_1d.rho_tor_norm[i] < 0:
                    mrho = mrho + 1
            nrho = len(equilibrium.time_slice[0].profiles_1d.rho_tor_norm) - mrho

erho = 0
if edge_present:
    if not r_out_graph:
        try:
            if len(core_profiles.profiles_1d[0].grid.rho_tor_norm) > 0:
                erho = len(edge_profiles.profiles_1d[0].grid.rho_tor_norm)
            elif len(core_profiles.profiles_1d[0].grid.rho_tor) > 0:
                erho = len(edge_profiles.profiles_1d[0].grid.rho_tor)
        except:
            print('edge_profiles.profiles_1d[:].grid.rho_tor_norm and rho_tor could not be read.', file=sys.stderr)
        if erho == 0:
            print('edge_profiles.profiles_1d[:].grid.rho_tor_norm and rho_tor are empty.', file=sys.stderr)
    else:
        erho = len(edge_profiles.grid_ggd[0].grid_subset[gset].element)

if debug:
    print('Array sizes: rho_tor_norm = '+str(nrho)+' and edge_profiles = '+str(erho), file=sys.stdout)

# Rho or R_outboard profile
xbeg = 99.
xend = 0
rho_tor_norm = [0] * (nrho + erho)
if not r_out_graph and core_present:
    if len(core_profiles.profiles_1d[0].grid.rho_tor_norm) > 0:
        for i in range(nrho):
            rho_tor_norm[i] = core_profiles.profiles_1d[0].grid.rho_tor_norm[i]
    elif len(core_profiles.profiles_1d[0].grid.rho_tor) > 0:
        for i in range(nrho):
            rho_tor_norm[i] = core_profiles.profiles_1d[0].grid.rho_tor[i]/core_profiles.profiles_1d[0].grid.rho_tor[nrho-1]
    xbeg = 0
    xend = 1
elif core_present:
    for i in range(nrho):
        rho_tor_norm[i] = equilibrium.time_slice[0].profiles_1d.r_outboard[mrho+i]
    xbeg = min(xbeg,rho_tor_norm[nrho-1],rho_tor_norm[0])
    xend = max(xend,rho_tor_norm[nrho-1],rho_tor_norm[0])

if edge_present:
    if not r_out_graph:
        if len(core_profiles.profiles_1d[0].grid.rho_tor_norm) > 0:
            for i in range(erho):
                rho_tor_norm[nrho+i] = edge_profiles.profiles_1d[0].rho_tor_norm[i]
        elif len(core_profiles.profiles_1d[0].grid.rho_tor) > 0:
            for i in range(erho):
                rho_tor_norm[nrho+i] = edge_profiles.profiles_1d[0].grid.rho_tor[i]/core_profiles.profiles_1d[0].grid.rho_tor[nrho-1]
        xbeg = min(xbeg,rho_tor_norm[nrho+erho-1],rho_tor_norm[0])
        xend = max(xend,rho_tor_norm[nrho+erho-1],rho_tor_norm[nrho])
    else:
        if edge_profiles.grid_ggd[0].grid_subset[gset].dimension == -999999999 and debug:
            print('Dimensionality of Outer Midplane GGD subset is not defined !', file=sys.stdout)
            print('Assuming the grid subset is made of edges (dimensionality 2).', file=sys.stdout)
        if edge_profiles.grid_ggd[0].grid_subset[gset].dimension == 1:
            for i in range(erho):
                ielem = edge_profiles.grid_ggd[0].grid_subset[gset].element[i].object[0].index
                i1 = edge_profiles.grid_ggd[0].space[0].objects_per_dimension[0].object[ielem-1].nodes[0]
                rho_tor_norm[nrho+i] = edge_profiles.grid_ggd[0].space[0].objects_per_dimension[0].object[i1-1].geometry[0]
                xbeg = min(xbeg,rho_tor_norm[0])
                xend = max(xend,rho_tor_norm[nrho+i])
        elif (edge_profiles.grid_ggd[0].grid_subset[gset].dimension == 2 or \
              edge_profiles.grid_ggd[0].grid_subset[gset].dimension == -999999999) and edge_present:
            for i in range(erho):
                ielem = edge_profiles.grid_ggd[0].grid_subset[gset].element[i].object[0].index
                i1 = edge_profiles.grid_ggd[0].space[0].objects_per_dimension[1].object[ielem-1].nodes[0]
                i2 = edge_profiles.grid_ggd[0].space[0].objects_per_dimension[1].object[ielem-1].nodes[1]
                rho_tor_norm[nrho+i] = ( edge_profiles.grid_ggd[0].space[0].objects_per_dimension[0].object[i1-1].geometry[0] + edge_profiles.grid_ggd[0].space[0].objects_per_dimension[0].object[i2-1].geometry[0] ) / 2
                xbeg = min(xbeg,rho_tor_norm[0])
                xend = max(xend,rho_tor_norm[nrho+i])
        else:
            print('Unexpected dimensionality of Outer Midplane GGD subset : '+str(edge_profiles.grid_ggd[0].grid_subset[gset].dimension), file=sys.stderr)
            print('Abandoning edge plots !', file=sys.stderr)
            edge_present = False

# Species A number (not mandatory)
nspecies = 0
if core_present:
    try:
        nspecies = len(core_profiles.profiles_1d[0].ion)
    except:
        print('core_profiles.profiles_1d[0].ion could not be read.', file=sys.stderr)
        exit()

especies = nspecies
if edge_present:
    if not r_out_graph:
        especies = len(edge_profiles.profiles_1d[0].ion)
    else:
        especies = len(edge_profiles.ggd[0].ion)
if nspecies != especies and core_present and edge_present:
    print('Warning: list of species in core and edge profiles data do not match!', file=sys.stdout)
if not core_present:
    nspecies = especies

a = [0] * nspecies
if core_present:
    try:
        for ispecies in range(nspecies):
            a[ispecies] = int(core_profiles.profiles_1d[0].ion[ispecies].element[0].a)
    except:
        print('core_profiles.profiles_1d[:].ion[0].element[0].a could not be read.', file=sys.stderr)
        plot_compo = False
else:
    if not r_out_graph:
        try:
            for ispecies in range(especies):
                a[ispecies] = int(edge_profiles.profiles_1d[0].ion[ispecies].element[0].a)
        except:
            print('edge_profiles.profiles_1d[:].ion[0].element[0].a could not be read.', file=sys.stderr)
            plot_compo = False
    else:
        try:
            for ispecies in range(especies):
                a[ispecies] = int(edge_profiles.ggd[0].ion[ispecies].element[0].a)
        except:
            print('edge_profiles.ggd[:].ion[0].element[0].a could not be read.', file=sys.stderr)
            plot_compo = False

# Species Z number (not mandatory)
z = [0] * nspecies
if core_present:
    try:
        for ispecies in range(nspecies):
            z[ispecies] = int(core_profiles.profiles_1d[0].ion[ispecies].element[0].z_n)
    except:
        print('core_profiles.profiles_1d[:].ion[0].element[0].z_n could not be read.', file=sys.stderr)
        plot_compo = False
else:
    if not r_out_graph:
        try:
            for ispecies in range(especies):
                z[ispecies] = int(edge_profiles.profiles_1d[0].ion[ispecies].element[0].z_n)
        except:
            print('edge_profiles.profiles_1d[:].ion[0].element[0].z_n could not be read.', file=sys.stderr)
            plot_compo = False
    else:
        try:
            for ispecies in range(especies):
                z[ispecies] = int(edge_profiles.ggd[0].ion[ispecies].element[0].z_n)
        except:
            print('edge_profiles.ggd[:].ion[0].element[0].z_n could not be read.', file=sys.stderr)
            plot_compo = False

# Number of atoms per species (not mandatory)
n = [1] * nspecies
if core_present:
    try:
        for ispecies in range(nspecies):
            n[ispecies] = core_profiles.profiles_1d[0].ion[ispecies].element[0].atoms_n
    except:
        print('core_profiles.profiles_1d[:].ion[0].element[0].atoms_n could not be read.', file=sys.stderr)
        print('Value of 1 assumed.', file=sys.stderr)
else:
    if not r_out_graph:
        try:
            for ispecies in range(especies):
                n[ispecies] = edge_profiles.profiles_1d[0].ion[ispecies].element[0].atoms_n
        except:
            print('edge_profiles.profiles_1d[:].ion[0].element[0].atoms_n could not be read.', file=sys.stderr)
            print('Value of 1 assumed.', file=sys.stderr)
    else:
        try:
            for ispecies in range(especies):
                n[ispecies] = edge_profiles.ggd[0].ion[ispecies].element[0].atoms_n
        except:
            print('edge_profiles.ggd[:].ion[0].element[0].atoms_n could not be read.', file=sys.stderr)
            print('Value of 1 assumed.', file=sys.stderr)

if edge_present:
    species_map = [-99] * nspecies
    for ispecies in range(nspecies):
        for jspecies in range(especies):
            if r_out_graph == 0:
                if a[ispecies] == int(edge_profiles.profiles_1d[0].ion[jspecies].element[0].a) and z[ispecies] == int(edge_profiles.profiles_1d[0].ion[jspecies].element[0].z_n) and n[ispecies] == edge_profiles_1d[0].ion[jspecies].element[0].atoms_n:
                   species_map[ispecies] = jspecies
            else:
                if a[ispecies] == int(edge_profiles.ggd[0].ion[jspecies].element[0].a) and z[ispecies] == int(edge_profiles.ggd[0].ion[jspecies].element[0].z_n) and n[ispecies] == edge_profiles.ggd[0].ion[jspecies].element[0].atoms_n:
                    species_map[ispecies] = jspecies
        if species_map[ispecies] == -99 and core_present == 1:
            print('Core_profiles species '+core_profiles.profiles_1d[0].ion[ispecies].label+' has no partner in edge_profiles!', file=sys.stderr)

# Volume profile (not mandatory)
volume = [0] * (nrho + erho)
if core_present:
    if len(core_profiles.profiles_1d[0].grid.volume) == nrho:
        for i in range(nrho):
            volume[i] = core_profiles.profiles_1d[0].grid.volume[i]
    else:
        try:
            equilibrium = input.equilibrium
            equilibrium.time_slice[0].profiles_1d.volume = input.partial_get('equilibrium',f'time_slice({it})/profiles_1d/volume')
            for i in range(nrho):
                volume[i] = equilibrium.time_slice[0].profiles_1d.volume[i]
            if len(volume) == len(core_profiles.profiles_1d[0].electrons.density):
                print('   core_profiles.profiles_1d[:].grid.volume could not be read.', file=sys.stderr)
                print('   ----> equilibrium.time_slice[:].profiles_1d.volume used instead.', file=sys.stderr)
                print('   (possible because the resolution is the same, but maybe not correct)', file=sys.stderr)
        except:
            print('core_profiles.profiles_1d[:].grid.volume could not be read.', file=sys.stderr)
            plot_compo = False
if (edge_present and not r_out_graph):
    for i in range(erho):
        volume[nrho+i] = edge_profiles.profiles_1d[0].grid.volume[i]

# Zeff profile (not mandatory)
zeff = [0] * (nrho + erho)
if core_present:
    if len(core_profiles.profiles_1d[0].zeff) != nrho:
        print('core_profiles.profiles_1d[:].zeff could not be read.', file=sys.stderr)
        print(f'Size mismatch: rho_tor_norm = {nrho}, zeff = {len(core_profiles.profiles_1d[0].zeff)}', file=sys.stderr)
        core_profiles.profiles_1d[0].zeff = asarray([NaN]*nrho)
    for i in range(nrho):
        zeff[i] = core_profiles.profiles_1d[0].zeff[i]
if edge_present:
    if not r_out_graph:
        if len(edge_profiles.profiles_1d[0].zeff) < 1:
            print('edge_profiles.profiles_1d[:].zeff could not be read.', file=sys.stderr)
            edge_profiles.profiles_1d[0].zeff = asarray([NaN]*erho)
        for i in range(erho):
            zeff[nrho+i] = edge_profiles.profiles_1d[0].zeff[i]
    else:
        if len(edge_profiles.ggd[0].zeff[gset].values) < 1:
            print('edge_profiles.ggd[:].zeff could not be read.', file=sys.stderr)
            edge_profiles.ggd[0].zeff[gset].values = asarray([NaN]*erho)
        for i in range(erho):
            zeff[nrho+i] = edge_profiles.ggd[0].zeff[gset].values[i]

# Ne profile (not mandatory)
electron_density = [0] * (nrho + erho)
if core_present:
    if len(core_profiles.profiles_1d[0].electrons.density) != nrho:
        print('core_profiles.profiles_1d[:].electrons.density could not be read.', file=sys.stderr)
        print(f'Size mismatch: rho_tor_norm = {nrho}, electrons.density = {len(core_profiles.profiles_1d[0].electrons.density)}', file=sys.stderr)
        core_profiles.profiles_1d[0].electrons.density = asarray([NaN]*nrho)
    for i in range(nrho):
        electron_density[i] = core_profiles.profiles_1d[0].electrons.density[i]
if edge_present:
    if not r_out_graph:
        if len(edge_profiles.profiles_1d[0].electrons.density) < 1:
            print('edge_profiles.profiles_1d[:].electrons.density could not be read.', file=sys.stderr)
            edge_profiles.profiles_1d[0].electrons.density = asarray([NaN]*erho)
        for i in range(erho):
            electron_density[nrho+i] = edge_profiles.profiles_1d[0].electrons.density[i]
    else:
        if len(edge_profiles.ggd[0].electrons.density[gset].values) < 1:
            print('edge_profiles.ggd[:].electrons.density could not be read.', file=sys.stderr)
            edge_profiles.ggd[0].electrons.density[gset].values = asarray([NaN]*erho)
        for i in range(erho):
            electron_density[nrho+i] = edge_profiles.ggd[0].electrons.density[gset].values[i]

# Te profile (not mandatory)
electron_temperature = [0] * (nrho + erho)
if core_present:
    if len(core_profiles.profiles_1d[0].electrons.temperature) != nrho:
        print('core_profiles.profiles_1d[:].electrons.temperature could not be read.', file=sys.stderr)
        print(f'Size mismatch: rho_tor_norm = {nrho}, electrons.temperature = {len(core_profiles.profiles_1d[0].electrons.temperature)}', file=sys.stderr)
        core_profiles.profiles_1d[0].electrons.temperature = asarray([NaN]*nrho)
    for i in range(nrho):
        electron_temperature[i] = core_profiles.profiles_1d[0].electrons.temperature[i]*1.e-3
if edge_present:
    if not r_out_graph:
        if len(edge_profiles.profiles_1d[0].electrons.temperature) < 1:
            print('edge_profiles.profiles_1d[:].electrons.temperature could not be read.', file=sys.stderr)
            edge_profiles.profiles_1d[0].electrons.temperature = asarray([NaN]*erho)
        for i in range(erho):
            electron_temperature[nrho+i] = edge_profiles.profiles_1d[0].electrons.temperature[i]*1.e-3
    else:
        if len(edge_profiles.ggd[0].electrons.temperature[gset].values) < 1:
            print('edge_profiles.ggd[:].electrons.temperature could not be read.', file=sys.stderr)
            edge_profiles.ggd[0].electrons.temperature[gset].values = asarray([NaN]*erho)
        for i in range(erho):
            electron_temperature[nrho+i] = edge_profiles.ggd[0].electrons.temperature[gset].values[i]*1.e-3

# Ti profile (not mandatory)
ti_flag = 0
if core_present:
    if len(core_profiles.profiles_1d[0].t_i_average) != nrho:
        print('core_profiles.profiles_1d[:].t_i_average could not be read.', file=sys.stderr)
        print(f'Size mismatch: rho_tor_norm = {nrho}, t_i_average = {len(core_profiles.profiles_1d[0].t_i_average)}', file=sys.stderr)
        core_profiles.profiles_1d[0].t_i_average = asarray([NaN]*nrho)
    else:
        ti_flag = 1
ti_e_flag = 0
if edge_present:
    if not r_out_graph:
        if len(edge_profiles.profiles_1d[0].t_i_average) < 1:
            print('edge_profiles.profiles_1d[:].t_i_average could not be read.', file=sys.stderr)
            edge_profiles.profiles_1d[0].t_i_average = asarray([NaN]*erho)
        else:
            ti_e_flag = 1
    else:
        if len(edge_profiles.ggd[0].t_i_average[gset].values) < 1:
            print('edge_profiles.ggd[:].t_i_average could not be read.', file=sys.stderr)
            edge_profiles.ggd[0].t_i_average[gset].values = asarray([NaN]*erho)
        else:
            ti_e_flag = 1

if ti_flag == 0:
    for ispecies in range(nspecies):
        if core_present:
            if len(core_profiles.profiles_1d[0].ion[ispecies].temperature) != nrho:
                print(f'core_profiles.profiles_1d[:].ion[{ispecies}].temperature could not be read.', file=sys.stderr)
                print(f'Size mismatch: rho_tor_norm = {nrho}, ion[{ispecies}].temperature = {len(core_profiles.profiles_1d[0].ion[ispecies].temperature)}', file=sys.stderr)
                core_profiles.profiles_1d[0].ion[ispecies].temperature = asarray([NaN]*nrho)
            else:
                ti_flag = 2
        if edge_present and ti_e_flag == 0:
            jspecies = species_map[ispecies]
            if jspecies != -99:
                if not r_out_graph:
                    if len(edge_profiles.profiles_1d[0].ion[jspecies].temperature) < 1:
                        if ti_e_flag != 1 or debug:
                            print(f'edge_profiles.profiles_1d[:].ion[{jspecies}].temperature could not be read.', file=sys.stderr)
                        if ti_e_flag != 1:
                            edge_profiles.profiles_1d[0].ion[jspecies].temperature = asarray([NaN]*erho)
                    else:
                        ti_e_flag = 2
                else:
                    if len(edge_profiles.ggd[0].ion[jspecies].temperature) < 1:
                        if ti_e_flag != 1 or debug:
                            print('edge_profiles.ggd[:].ion[:].temperature could not be read.', file=sys.stderr)
                        if ti_e_flag != 1:
                            edge_profiles.ggd[0].ion[jspecies].temperature[gset].values = asarray([NaN]*erho)
                    else:
                        ti_e_flag = 2

if debug:
    print('Ti_flag : '+str(ti_flag)+', Ti_e_flag : '+str(ti_e_flag), file=sys.stdout)

ion_temperature = [0] * (nrho + erho)
if ti_flag == 1:
    for i in range(nrho):
        ion_temperature[i] = core_profiles.profiles_1d[0].t_i_average[i]*1.e-3
elif ti_flag == 2:
    for i in range(nrho):
        ion_temperature[i] = core_profiles.profiles_1d[0].ion[0].temperature[i]*1.e-3
if edge_present:
    if ti_e_flag == 1:
        if not r_out_graph:
            for i in range(erho):
                ion_temperature[nrho+i] = edge_profiles.profiles_1d[0].t_i_average[i]*1.e-3
        else:
            for i in range(erho):
                ion_temperature[nrho+i] = edge_profiles.ggd[0].t_i_average[gset].values[i]*1.e-3
    elif ti_e_flag == 2:
        if not r_out_graph:
            for i in range(erho):
                ion_temperature[nrho+i] = edge_profiles.profiles_1d[0].ion[0].temperature[i]*1.e-3
        else:
            for i in range(erho):
                ion_temperature[nrho+i] = edge_profiles.ggd[0].ion[0].temperature[gset].values[i]*1.e-3

# Ni profile (not mandatory)
ion_density = {}
for ispecies in range(nspecies):
    ion_density[ispecies] = [0] * (nrho + erho)
    if core_present:
        if len(core_profiles.profiles_1d[0].ion[ispecies].density) != nrho:
            print(f'core_profiles.profiles_1d[:].ion[{ispecies}].density could not be read.', file=sys.stderr)
            print(f'Size mismatch: rho_tor_norm = {nrho}, ion[{ispecies}].density = {len(core_profiles.profiles_1d[0].ion[ispecies].density)}', file=sys.stderr)
            core_profiles.profiles_1d[0].ion[ispecies].density = asarray([NaN]*nrho)
        for i in range(nrho):
            ion_density[ispecies][i] = core_profiles.profiles_1d[0].ion[ispecies].density[i]
    if edge_present:
        jspecies = species_map[ispecies]
        if jspecies != -99:
            if not r_out_graph:
                if edge_profiles.profiles_1d[0].ion[jspecies].multiple_states_flag == 0:
                    if len(edge_profiles.profiles_1d[0].ion[jspecies].density) < 1:
                        print(f'edge_profiles.profiles_1d[:].ion[{jspecies}].density could not be read.', file=sys.stderr)
                        edge_profiles.profiles_1d[0].ion[jspecies].density = asarray([NaN]*erho)
                    for i in range(erho):
                        ion_density[ispecies][nrho+i] = edge_profiles.profiles_1d[0].ion[jspecies].density[i]
                else:
                    for istate in range(len(edge_profiles.profiles_1d[0].ion[jspecies].state)):
                        if len(edge_profiles.profiles_1d[0].ion[jspecies].state[istate].density) < 1:
                            print(f'edge_profiles.profiles_1d[:].ion[{jspecies}].state[{istate}].density could not be read.', file=sys.stderr)
                            edge_profiles.profiles_1d[0].ion[jspecies].state[istate].density = asarray([0]*erho)
                        for i in range(erho):
                            ion_density[ispecies][nrho+i] = ion_density[ispecies][nrho+i] + edge_profiles.profiles_1d[0].ion[jspecies].state[istate].density[i]
            else:
                if edge_profiles.ggd[0].ion[jspecies].multiple_states_flag == 0:
                    if len(edge_profiles.ggd[0].ion[jspecies].density[gset].values) < 1:
                        print(f'edge_profiles.ggd[:].ion[{jspecies}.density could not be read.', file=sys.stderr)
                        edge_profiles.ggd[0].ion[jspecies].density[gset].values = asarray([NaN]*erho)
                    for i in range(erho):
                        ion_density[ispecies][nrho+i] = edge_profiles.ggd[0].ion[jspecies].density[gset].values[i]
                else:
                    for istate in range(len(edge_profiles.ggd[0].ion[jspecies].state)):
                        if len(edge_profiles.ggd[0].ion[jspecies].state[istate].density) < 1:
                            print(f'edge_profiles.ggd[:].ion[{jspecies}].state[{istate}].density could not be read.', file=sys.stderr)
                            edge_profiles.ggd[0].ion[jspecies].state[istate].density = asarray([0]*erho)
                        for i in range(erho):
                            ion_density[ispecies][nrho+i] = ion_density[ispecies][nrho+i] + edge_profiles.ggd[0].ion[jspecies].state[istate].density[gset].values[i]

# Vtor profile (not mandatory)
vtor_flag = 0
vtor_e_flag = 0
ion_vtor = {}
for ispecies in range(nspecies):
    ion_vtor[ispecies] = [0] * (nrho + erho)
    if core_present:
        if len(core_profiles.profiles_1d[0].ion[ispecies].velocity.toroidal) != nrho:
            print(f'core_profiles.profiles_1d[:].ion[{ispecies}].velocity.toroidal could not be read.', file=sys.stderr)
            print(f'Size mismatch: rho_tor_norm = {nrho}, ion[{ispecies}].velocity.toroidal = {len(core_profiles.profiles_1d[0].ion[ispecies].velocity.toroidal)}', file=sys.stderr)
            core_profiles.profiles_1d[0].ion[ispecies].velocity.toroidal = asarray([NaN]*nrho)
        else:
            vtor_flag = 1
            for i in range(nrho):
                ion_vtor[ispecies][i] = abs(core_profiles.profiles_1d[0].ion[ispecies].velocity.toroidal[i])
        if len(core_profiles.profiles_1d[0].ion[ispecies].velocity_tor) != nrho:
            print(f'core_profiles.profiles_1d[:].ion[{ispecies}].velocity_tor could not be read.', file=sys.stderr)
            print(f'Size mismatch: rho_tor_norm = {nrho}, ion[{ispecies}].velocity_tor = {len(core_profiles.profiles_1d[0].ion[ispecies].velocity_tor)}', file=sys.stderr)
            core_profiles.profiles_1d[0].ion[ispecies].velocity_tor = asarray([NaN]*nrho)
        else:
            if vtor_flag == 0:
                vtor_flag = 2
                for i in range(nrho):
                    ion_vtor[ispecies][i] = abs(core_profiles.profiles_1d[0].ion[ispecies].velocity_tor[i])
    if edge_present:
        jspecies = species_map[ispecies]
        if jspecies != -99:
            if not r_out_graph:
                if edge_profiles.profiles_1d[0].ion[jspecies].multiple_states_flag == 0:
                    try:
                        if len(edge_profiles.profiles_1d[0].ion[jspecies].velocity.toroidal) == erho:
                            for i in range(erho):
                                ion_vtor[ispecies][nrho+i] = abs(edge_profiles.profiles_1d[0].ion[jspecies].velocity.toroidal[i])
                            vtor_e_flag = 1
                    except:
                        print(f'edge_profiles.profiles_1d[:].ion[{jspecies}].velocity.toroidal could not be read.', file=sys.stderr)
                    if vtor_e_flag != 1:
                        try:
                            if len(edge_profiles.profiles_1d[0].ion[jspecies].velocity_tor) == erho:
                                for i in range(erho):
                                    ion_vtor[ispecies][nrho+i] = abs(edge_profiles.profiles_1d[0].ion[jspecies].velocity_tor[i])
                                vtor_e_flag = 2
                        except:
                            print(f'edge_profiles.profiles_1d[:].ion[{jspecies}].velocity_tor could not be read.', file=sys.stderr)
                else:
                    for istate in range(len(edge_profiles.profiles_1d[0].ion[jspecies].state)):
                        try:
                            if len(edge_profiles.profiles_1d[0].ion[jspecies].state[istate].velocity.toroidal) == erho:
                                for i in range(erho):
                                    if ion_density[ispecies][nrho+i] > 0.:
                                        ion_vtor[ispecies][nrho+i] = ion_vtor[ispecies][nrho+i] + abs(edge_profiles.profiles_1d[0].ion[jspecies].state[istate].velocity.toroidal[i])*edge_profiles.profiles_1d[0].ion[jspecies].state[istate].density[i]/ion_density[ispecies][nrho+i]
                                vtor_e_flag = 1
                        except:
                            print(f'edge_profiles.profiles_1d[:].ion[{jspecies}].state[{istate}].velocity.toroidal could not be read.', file=sys.stderr)
                        if vtor_e_flag != 1:
                            try:
                                if len(edge_profiles.profiles_1d[0].ion[jspecies].state[istate].velocity_tor) == erho:
                                    for i in range(erho):
                                        if ion_density[ispecies][nrho+i] > 0.:
                                            ion_vtor[ispecies][nrho+i] = ion_vtor[ispecies][nrho+i] + abs(edge_profiles.profiles_1d[0].ion[jspecies].state[istate].velocity_tor[i])*edge_profiles.profiles_1d[0].ion[jspecies].state[istate].density[i]/ion_density[ispecies][nrho+i]
                                    vtor_e_flag = 2
                            except:
                                print(f'edge_profiles.profiles_1d[:].ion[{jspecies}].state[{istate}].velocity_tor could not be read.', file=sys.stderr)

            else:
                if edge_profiles.ggd[0].ion[jspecies].multiple_states_flag == 0:
                    try:
                        if len(edge_profiles.ggd[0].ion[jspecies].velocity[gset].toroidal) == erho:
                            for i in range(erho):
                                ion_vtor[ispecies][nrho+i] = abs(edge_profiles.ggd[0].ion[jspecies].velocity[gset].toroidal[i])
                            vtor_e_flag = 1
                    except:
                        print(f'edge_profiles.ggd[:].ion[{jspecies}].velocity.toroidal could not be read.', file=sys.stderr)
                else:
                    for istate in range(len(edge_profiles.ggd[0].ion[jspecies].state)):
                        try:
                            if len(edge_profiles.ggd[0].ion[jspecies].state[istate].velocity[gset].toroidal) == erho:
                                for i in range(erho):
                                    if ion_density[ispecies][nrho+i] > 0:
                                        ion_vtor[ispecies][nrho+i] = ion_vtor[ispecies][nrho+i] + abs(edge_profiles.ggd[0].ion[jspecies].state[istate].velocity[gset].toroidal[i])*edge_profiles.ggd[0].ion[jspecies].state[istate].density[gset].values[i]/ion_density[ispecies][nrho+i]
                                vtor_e_flag = 1
                        except:
                            print(f'edge_profiles.ggd[:].ion[{jspecies}].state[{istate}].velocity.toroidal could not be read.', file=sys.stderr)

if debug:
    print(f'Vtor_flag : {vtor_flag}, Vtor_e_flag : {vtor_e_flag}', file=sys.stdout)

# Vpol profile (not mandatory)
vpol_flag = 0
vpol_e_flag = 0
ion_vpol = {}
for ispecies in range(nspecies):
