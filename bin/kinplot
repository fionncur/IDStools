                                        ion_vpol[ispecies][nrho+i] = ion_vpol[ispecies][nrho+i] + abs(edge_profiles.profiles_1d[0].ion[jspecies].state[istate].velocity.poloidal[i])*edge_profiles.profiles_1d[0].ion[jspecies].state[istate].density[i]/ion_density[ispecies][nrho+i]
                                vpol_e_flag = 1
                        except:
                            print(f'edge_profiles.profiles_1d[:].ion[{jspecies}].state[{istate}].velocity.poloidal could not be read.', file=sys.stderr)
            else:
                if edge_profiles.ggd[0].ion[jspecies].multiple_states_flag == 0:
