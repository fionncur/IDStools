#!/usr/bin/env python
from __future__ import print_function

import os, sys, glob, yaml, argparse, re, imas
from operator import itemgetter
from stat import *
import init_mendeleiev as mend

# ----------------------------------------------------------------------

def find_nearest(a, a0):
    'Element in nd array `a` closest to the scalar value `a0`'
    idx = numpy.abs(a - a0).argmin()
    return a.flat[idx],idx

# ----------------------------------------------------------------------

# Management of input arguments
parser = argparse.ArgumentParser(description=\
    '---- Display the plasma kinetic profiles from the core_profiles IDSs')
parser.add_argument('-u','--user_or_path',help='User or absolute path name of the DB where the data-entry is located', required=False)
parser.add_argument('-d','--database',help='Database name of the targeted data-entry', required=False)
parser.add_argument('-s','--shot',help='Shot number', required=True,type=int)
parser.add_argument('-r','--run',help='Run number',required=True,type=int)
parser.add_argument('-t','--time',help='Time', required=False,type=float)
args = vars(parser.parse_args())

# For execution from python shell
#args = {'run': 6, 'database': None, 'user_or_path': None, 'time': None, 'shot': 4321}

shot = args['shot']
run  = args['run']

# User or absolute path name
if args['user_or_path'] != None:
    user_or_path = args['user_or_path']
else:
    #user_or_path = os.getenv('USER')
    user_or_path = 'public'

# Database name
if args['database'] != None:
    database = args['database']
else:
    database = 'iterdb'

# Time
if args['time'] != None:
    time = args['time']
else:
    time = -99.

# Open the database and read the necessary IDSs
try:
    version = os.getenv('IMAS_VERSION')[0]
    input = imas.ids(shot,run)
    input.open_env(str(user_or_path),str(database),version)
except:
    print('Shot ' + str(shot) + ', run ' + str(run) + ' does not exist', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

if user_or_path == 'public':
    DB_FOLDER = '/work/imas/shared/'+str(database)+'/3/0'
else:
    DB_FOLDER = os.path.expanduser("~{}".format(user_or_path))+"/public/imasdb/"+str(database)+"/3/0"

try:
    input.core_profiles.get()
    core_profiles = input.core_profiles
except:
    print('The core_profiles IDS is absent from the input data-entry', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

hostdir = os.environ["HOSTNAME"]+":"+DB_FOLDER
hostdir = hostdir[:-2]

# ----------------------------------------------------------------------

from math import *
from numpy import *
import matplotlib
if 'DISPLAY' not in os.environ:
    matplotlib.use('agg')
else:
    matplotlib.use('TKagg')

from matplotlib import *
import matplotlib.pyplot as plt
import matplotlib.ticker as mtick

# Search for adequate time slice for display
ntime = len(core_profiles.time)
timevec = core_profiles.time
if ntime > 1:
    if time >= 0:
        [tc,it] = find_nearest(timevec,time)
    else:
        it = int(ntime/2)
        tc = timevec[it]
    time = tc
    print('   Time  = '+'%.2f' % tc+' s in range ['+'%.2f' % timevec[0]+','+'%.2f' % timevec[ntime-1]+'] s')
    print('   Index = ',str(it))
    print('   Averaged resolution = ', (timevec[ntime-1]-timevec[0])/(ntime-1),' s')
else:
    if len(timevec) > 0:
        tc = timevec[0]
    else:
        tc = 0
    it = 0

time = tc

# Mendeleiev table
table_mendeleiev = mend.create_table_mendeleiev()

# ----------------------------------------------------------------------

# A priori the plasma composition can be read
plot_compo = 1

# Rho profile (mandatory)
nrho=0
try:
    rho_tor_norm = 0
    if len(core_profiles.profiles_1d[it].grid.rho_tor_norm) > 0:
        nrho = len(core_profiles.profiles_1d[it].grid.rho_tor_norm)
        rho_tor_norm = core_profiles.profiles_1d[it].grid.rho_tor_norm
    elif len(core_profiles.profiles_1d[it].grid.rho_tor) > 0:
        nrho = len(core_profiles.profiles_1d[it].grid.rho_tor)
        rho_tor_norm = core_profiles.profiles_1d[it].grid.rho_tor/core_profiles.profiles_1d[it].grid.rho_tor[nrho-1]
except:
    print('core_profiles.profiles_1d[:].grid.rho_tor_norm and rho_tor could not be read', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()
if nrho==0:
    print('core_profiles.profiles_1d[:].grid.rho_tor_norm and rho_tor are empty', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

# Species A number (not mandatory)
try:
    nspecies = len(core_profiles.profiles_1d[it].ion)
    a = [0] * nspecies
    for ispecies in range(nspecies):
        a[ispecies] = int(core_profiles.profiles_1d[it].ion[ispecies].element[0].a)
except:
    print('core_profiles.profiles_1d[:].ion[0].element[0].a could not be read', file=sys.stderr)
    plot_compo = 0

# Species Z number (not mandatory)
try:
    nspecies = len(core_profiles.profiles_1d[it].ion)
    z = [0] * nspecies
    for ispecies in range(nspecies):
        z[ispecies] = int(core_profiles.profiles_1d[it].ion[ispecies].element[0].z_n)
except:
    print('core_profiles.profiles_1d[:].ion[0].element[0].z_n could not be read', file=sys.stderr)
    plot_compo = 0

# Volume profile (not mandatory)
try:
    volume = core_profiles.profiles_1d[it].grid.volume
    if len(volume) == 0:
        try:
            equilibrium = cli.get('equilibrium')
        except:
            exit()
        volume = equilibrium.time_slice[it].profiles_1d.volume
        if len(volume) == len(core_profiles.profiles_1d[it].electrons.density):
            print('   core_profiles.profiles_1d[:].grid.volume could not be read', file=sys.stderr)
            print('   ----> equilibrium.time_slice[:].profiles_1d.volume used instead', file=sys.stderr)
            print('   (possible because the resolution is the same, but maybe not correct)', file=sys.stderr)
        else:
            exit()
except:
    print('core_profiles.profiles_1d[:].grid.volume could not be read', file=sys.stderr)
    plot_compo = 0

# Zeff profile (not mandatory)
if len(core_profiles.profiles_1d[it].zeff) < 1:
    print('core_profiles.profiles_1d[:].zeff could not be read', file=sys.stderr)
    for itime in range(ntime):
        core_profiles.profiles_1d[itime].zeff = asarray([nan]*nrho)

# Ne profile (not mandatory)
if len(core_profiles.profiles_1d[it].electrons.density) < 1:
    print('core_profiles.profiles_1d[:].electrons.density could not be read', file=sys.stderr)
    for itime in range(ntime):
        core_profiles.profiles_1d[itime].electrons.density = asarray([nan]*nrho)

# Te profile (not mandatory)
if len(core_profiles.profiles_1d[it].electrons.temperature) < 1:
    print('core_profiles.profiles_1d[:].electrons.temperature could not be read', file=sys.stderr)
    for itime in range(ntime):
        core_profiles.profiles_1d[itime].electrons.temperature = asarray([nan]*nrho)

# Ti profile (not mandatory)
ti_flag = 0
if len(core_profiles.profiles_1d[it].t_i_average) < 1:
    print('core_profiles.profiles_1d[:].t_i_average could not be read', file=sys.stderr)
    for itime in range(ntime):
        core_profiles.profiles_1d[itime].t_i_average = asarray([nan]*nrho)
else:
    ti_flag = 1

for ispecies in range(nspecies):
    if len(core_profiles.profiles_1d[it].ion[ispecies].temperature) < 1:
        print('core_profiles.profiles_1d[:].ion['+str(ispecies)+'].temperature could not be read', file=sys.stderr)
        for itime in range(ntime):
            core_profiles.profiles_1d[itime].ion[ispecies].temperature = asarray([nan]*nrho)
    else:
        if ti_flag == 0:
            ti_flag = 2

# Ni profile (not mandatory)
for ispecies in range(nspecies):
    if len(core_profiles.profiles_1d[it].ion[ispecies].density) < 1:
        print('core_profiles.profiles_1d[:].ion['+str(ispecies)+'].density could not be read', file=sys.stderr)
        for itime in range(ntime):
            core_profiles.profiles_1d[itime].ion[ispecies].density = asarray([nan]*nrho)

# Vtor profile (not mandatory)
vtor_flag = 0
for ispecies in range(nspecies):
    if len(core_profiles.profiles_1d[it].ion[ispecies].velocity.toroidal) < 1:
        print('core_profiles.profiles_1d[:].ion['+str(ispecies)+'].velocity.toroidal could not be read', file=sys.stderr)
        for itime in range(ntime):
            core_profiles.profiles_1d[itime].ion[ispecies].velocity.toroidal = asarray([nan]*nrho)
    else:
        vtor_flag = 1
    if len(core_profiles.profiles_1d[it].ion[ispecies].velocity_tor) < 1:
        print('core_profiles.profiles_1d[:].ion['+str(ispecies)+'].velocity_tor could not be read', file=sys.stderr)
        for itime in range(ntime):
            core_profiles.profiles_1d[itime].ion[ispecies].velocity_tor = asarray([nan]*nrho)
    else:
        if vtor_flag == 0:
            vtor_flag = 2

# Vpol profile (not mandatory)
vpol_flag = 0
for ispecies in range(nspecies):
    if len(core_profiles.profiles_1d[it].ion[ispecies].velocity.poloidal) < 1:
        print('core_profiles.profiles_1d[:].ion['+str(ispecies)+'].velocity.poloidal could not be read', file=sys.stderr)
        for itime in range(ntime):
            core_profiles.profiles_1d[itime].ion[ispecies].velocity.poloidal = asarray([nan]*nrho)
    else:
        vpol_flag = 1
    if len(core_profiles.profiles_1d[it].ion[ispecies].velocity_pol) < 1:
        print('core_profiles.profiles_1d[:].ion['+str(ispecies)+'].velocity_pol could not be read', file=sys.stderr)
        for itime in range(ntime):
            core_profiles.profiles_1d[itime].ion[ispecies].velocity_pol = asarray([nan]*nrho)
    else:
        if vpol_flag == 0:
            vpol_flag = 2

# ----------------------------------------------------------------------

if (nspecies > 0) & (plot_compo==1):

    # Plasma composition
    species = []
    for ispecies in range(nspecies):
        species.append(table_mendeleiev[z[ispecies]][a[ispecies]].element)

    # Species concentrations
    ntot = 0
    species_density = [0] * nspecies
    max_density = -999.
    for ispecies in range(nspecies):
        species_density[ispecies] = sum(volume*core_profiles.profiles_1d[it].ion[ispecies].density)
        ntot = ntot + species_density[ispecies]
        if species_density[ispecies] > max_density:
            max_density = species_density[ispecies]
            imax = ispecies

    ne = sum(volume*core_profiles.profiles_1d[it].electrons.density)

    nspec_over_ntot = species_density/ntot
    nspec_over_ne   = species_density/ne
    nspec_over_nmaj = species_density/species_density[imax]

    # When a species appears twice: combine
    for ispecies in range(nspecies):
        for jspecies in range(nspecies):
            if (species[jspecies] == species[ispecies]) & (jspecies != ispecies):
                nspec_over_ntot[ispecies] = nspec_over_ntot[ispecies] + nspec_over_ntot[jspecies]
                nspec_over_ntot[jspecies] = 0
                nspec_over_ne[ispecies] = nspec_over_ne[ispecies] + nspec_over_ne[jspecies]
                nspec_over_ne[jspecies] = 0
                nspec_over_nmaj[ispecies] = nspec_over_nmaj[ispecies] + nspec_over_nmaj[jspecies]
                nspec_over_nmaj[jspecies] = 0

    # Nice display of plasma composition with species concentrations
    disp_species         = '   species:      '
    disp_a               = '   a:            '
    disp_z               = '   z:            '
    disp_nspec_over_ntot = '   n_over_ntot:  '
    disp_nspec_over_ne   = '   n_over_ne:    '
    disp_nspec_over_nmaj = '   n_over_n_maj: '
    for ispecies in range(nspecies):
        if nspec_over_ne[ispecies] > 0.:
            tabsize = 8
            disp_species = disp_species + species[ispecies] + ' ' * (tabsize-len(species[ispecies]))
            disp_a = disp_a + format('%.1f' % a[ispecies]) + ' ' * (tabsize-len(format('%.1f' % a[ispecies])))
            disp_z = disp_z + format('%.1f' % z[ispecies]) + ' ' * (tabsize-len(format('%.1f' % z[ispecies])))
            disp_nspec_over_ntot = disp_nspec_over_ntot + format('%.2f' % nspec_over_ntot[ispecies]) \
                                   + ' ' * (tabsize-len(format('%.2f' % nspec_over_ntot[ispecies])))
            disp_nspec_over_ne   = disp_nspec_over_ne   + format('%.2f' % nspec_over_ne[ispecies])   \
                                   + ' ' * (tabsize-len(format('%.2f' % nspec_over_ne[ispecies])))
            disp_nspec_over_nmaj = disp_nspec_over_nmaj + format('%.2f' % nspec_over_nmaj[ispecies]) \
                                   + ' ' * (tabsize-len(format('%.2f' % nspec_over_nmaj[ispecies])))

    print('   ------------')
    print(disp_species)
    print(disp_a)
    print(disp_z)
    print(disp_nspec_over_ntot)
    print(disp_nspec_over_ne)
    print(disp_nspec_over_nmaj)
    print('   ------------')

else:
    nspec_over_ne = [0]*nspecies

# ----------------------------------------------------------------------

# Criteria for significant impurity (in X[imp]/ne concentration)
impurity_limit = 0.001

# Create the dictionary defining the list of profiles that can be displayed
profiles = {}
profiles['rhonorm'] = rho_tor_norm
profiles['te'] = core_profiles.profiles_1d[it].electrons.temperature*1.e-3
if ti_flag == 1:
    profiles['ti'] = core_profiles.profiles_1d[it].t_i_average*1.e-3
else:
    profiles['ti'] = core_profiles.profiles_1d[it].ion[0].temperature*1.e-3

profiles['ne'] = core_profiles.profiles_1d[it].electrons.density
profiles['ni'] = [0] * nrho
profiles['zeff'] = core_profiles.profiles_1d[it].zeff
profiles['n_species'] = {}
for ispecies in range(nspecies):
    if plot_compo == 1:
        if nspec_over_ne[ispecies] > impurity_limit:
            profiles['n_species'][species[ispecies]]={}
            profiles['n_species'][species[ispecies]]['density'] = \
                    core_profiles.profiles_1d[it].ion[ispecies].density
            if vpol_flag == 1:
                profiles['n_species'][species[ispecies]]['vpol']    = \
                    abs(core_profiles.profiles_1d[it].ion[ispecies].velocity.poloidal)
            else:
                profiles['n_species'][species[ispecies]]['vpol']    = \
                    abs(core_profiles.profiles_1d[it].ion[ispecies].velocity_pol)
            if vtor_flag == 1:
                profiles['n_species'][species[ispecies]]['vtor']    = \
                    abs(core_profiles.profiles_1d[it].ion[ispecies].velocity.toroidal)
            else:
                profiles['n_species'][species[ispecies]]['vtor']    = \
                    abs(core_profiles.profiles_1d[it].ion[ispecies].velocity_tor)
    profiles['ni'] = profiles['ni'] + core_profiles.profiles_1d[it].ion[ispecies].density

# Min and max of velocity profiles
max_vtor = -9e99
min_vtor = 9e99
max_vpol = -9e99
min_vpol = 9e99
for ispecies in range(nspecies):
    if (plot_compo == 1) & (nspec_over_ne[ispecies] > impurity_limit):
        if max_vtor < max(profiles['n_species'][species[ispecies]]['vtor'][0:nrho-1]):
            max_vtor = max(profiles['n_species'][species[ispecies]]['vtor'][0:nrho-1])
        if min_vtor > min(profiles['n_species'][species[ispecies]]['vtor'][0:nrho-1]):
            min_vtor = min(profiles['n_species'][species[ispecies]]['vtor'][0:nrho-1])
        if max_vpol < max(profiles['n_species'][species[ispecies]]['vpol'][0:nrho-1]):
            max_vpol = max(profiles['n_species'][species[ispecies]]['vpol'][0:nrho-1])
        if min_vpol > min(profiles['n_species'][species[ispecies]]['vpol'][0:nrho-1]):
            min_vpol = min(profiles['n_species'][species[ispecies]]['vpol'][0:nrho-1])

# Create the dictionary defining the list of waveforms (central values) that can be displayed
def createWaveForm(ndim):
    return {'central': [0]*ndim,'edge': [0]*ndim,'rho95': [0]*ndim}

waveform = {}
waveform['time'] = timevec
for ikey in ['te','ti','ne','zeff']:
    waveform[ikey] = createWaveForm(0)

for itime in range(ntime):
    waveform['te']['central'].append(core_profiles.profiles_1d[itime].electrons.temperature[0]*1e-3)
    if ti_flag == 1:
        waveform['ti']['central'].append(core_profiles.profiles_1d[itime].t_i_average[0]*1e-3)
    else:
        waveform['ti']['central'].append(core_profiles.profiles_1d[itime].ion[0].temperature[0]*1e-3)

    waveform['ne']['central'].append(core_profiles.profiles_1d[itime].electrons.density[0])
    waveform['zeff']['central'].append(core_profiles.profiles_1d[itime].zeff[0])

waveform['n_species'] = {}
waveform['ni'] = createWaveForm(ntime)
for ispecies in range(nspecies):
    if (plot_compo == 1) & (nspec_over_ne[ispecies] > impurity_limit):
        waveform['n_species'][species[ispecies]]={'density' : createWaveForm(0), 'vpol' : createWaveForm(0),'vtor' : createWaveForm(0)}
    for itime in range(ntime):
        if (plot_compo == 1) & (nspec_over_ne[ispecies] > impurity_limit):
            waveform['n_species'][species[ispecies]]['density']['central']\
                    .append(core_profiles.profiles_1d[itime].ion[ispecies].density[0])
            if vpol_flag == 1:
                waveform['n_species'][species[ispecies]]['vpol']['central']\
                    .append(core_profiles.profiles_1d[itime].ion[ispecies].velocity.poloidal[0])
            else:
                waveform['n_species'][species[ispecies]]['vpol']['central']\
                    .append(core_profiles.profiles_1d[itime].ion[ispecies].velocity_pol[0])
            if vtor_flag == 1:
                waveform['n_species'][species[ispecies]]['vtor']['central']\
                    .append(core_profiles.profiles_1d[itime].ion[ispecies].velocity.toroidal[0])
            else:
                waveform['n_species'][species[ispecies]]['vtor']['central']\
                    .append(core_profiles.profiles_1d[itime].ion[ispecies].velocity_tor[0])
        waveform['ni']['central'][itime] = waveform['ni']['central'][itime] + core_profiles.profiles_1d[itime].ion[ispecies].density[0]

# ----------------------------------------------------------------------

# Tick size and X and Y axes
ticksize = 12
fontsize = 12

# Font definition
font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}

# Frame configuration
nline = 3
ncol  = 8
legx_pos = 1.35
legy_pos = 1.05

# Plot signature
def Signature(hostdir,shot,run,plt):
    ax = plt.gca()
    xmin, xmax = ax.get_xlim()
    ymin, ymax = ax.get_ylim()
    #plt.text(xmax+0.01*abs(xmax),ymax,hostdir[:-2]+' - Shot '+str(shot)+' / '+' Run '+str(run),fontsize=6,rotation=90)
    plt.text(xmax+0.01*abs(xmax-xmin)+0.01,ymax-0.03*abs(ymax-ymin),'Shot '+str(shot)+' / '+' Run '+str(run),fontsize=5,rotation=90)
    return

# Legend customization
def CustomLegend_wf(legend):
    frame = legend.get_frame()
    frame.set_facecolor('0.95')
    for label in legend.get_texts():
        label.set_fontsize(10)
    for label in legend.get_lines():
        label.set_linewidth(1.5)  # the legend line width
    return

def CustomLegend_pr(legend):
    frame = legend.get_frame()
    frame.set_facecolor('0.95')
    for label in legend.get_texts():
        label.set_fontsize(7)
    for label in legend.get_lines():
        label.set_linewidth(1.5)  # the legend line width
    return

# Plot customization
def nice(plt,x_label_string,y_label_string,fontsize):
    font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}
    plt.xticks(fontsize = ticksize)
    plt.yticks(fontsize = ticksize)
    plt.xlabel(x_label_string, fontdict=font, labelpad = 1)
    plt.ylabel(y_label_string, fontdict=font, labelpad = 0)
    plt.grid()
    if len(x_label_string) < 1:
        plt.tick_params(axis='x',which='both',bottom='off',top='off',labelbottom='off')

def time_display(plot,time):
    ymin = plot.gca().get_ylim()[0]
    ymax = plot.gca().get_ylim()[1]
    plot.plot([time,time],[ymin,ymax],color='gray',linestyle='--',linewidth=2,label=r'$t_{slice}$')
    plt.gca().set_ylim(ymin,ymax)

# ----------------------------------------------------------------------

# Display the figure
plt.figure()

single_style='o'
multi_style='-'
plotstyle = multi_style if len(waveform['time']) > 1 else single_style
# Central temperature waveforms
ax1 = plt.subplot2grid((nline,ncol), (0,0), colspan=3)
plt.plot(waveform['time'],waveform['te']['central'],plotstyle,color='r',label=r'$T_e(0)$')
plt.plot(waveform['time'],waveform['ti']['central'],plotstyle,color='b',label=r'$T_i(0)$')
if timevec[ntime-1] > timevec[0]:
    plt.xlim(timevec[0],timevec[ntime-1])

time_display(plt,time)
nice(plt,'$Time\/[\mathrm{s}]$','$T\/[\mathrm{keV}]$',fontsize)
legend = plt.legend(bbox_to_anchor=(legx_pos-0.03,legy_pos))
CustomLegend_wf(legend)
Signature(hostdir,shot,run,plt)
plt.title('Profiles displayed for t = '+'%.1f' % time+' s', fontdict=font)

# Central density waveforms
ax2 = plt.subplot2grid((nline,ncol), (1,0), colspan=3)
plt.plot(waveform['time'],waveform['ne']['central'],plotstyle,color='r',label=r'$n_e(0)$')
plt.plot(waveform['time'],waveform['ni']['central'],plotstyle,color='b',label=r'$n_i(0)$')
for ispecies in range(nspecies):
    if (plot_compo == 1) & (nspec_over_ne[ispecies] > impurity_limit):
        plt.plot(waveform['time'],waveform['n_species'][species[ispecies]]['density']['central'] \
                 ,plotstyle, label=r'$n_{'+species[ispecies]+'}(0)$')

time_display(plt,time)
nice(plt,'$Time\/[\mathrm{s}]$','$n\/[\mathrm{m^{-3}}]$',fontsize)
if timevec[ntime-1] > timevec[0]:
    plt.xlim(timevec[0],timevec[ntime-1])
legend = plt.legend(bbox_to_anchor=(legx_pos,legy_pos))
CustomLegend_wf(legend)
Signature(hostdir,shot,run,plt)

# Central Zeff waveform
ax3 = plt.subplot2grid((nline,ncol), (2,0), colspan=3)
plt.plot(waveform['time'],waveform['zeff']['central'],plotstyle,color='b',label=r'$Z_{eff}(0)$')
time_display(plt,time)
nice(plt,r'$Time\/[\mathrm{s}]$','$Z_{eff}$',fontsize)
if timevec[ntime-1] > timevec[0]:
    plt.xlim(timevec[0],timevec[ntime-1])
legend = plt.legend(bbox_to_anchor=(legx_pos,legy_pos))
CustomLegend_wf(legend)
Signature(hostdir,shot,run,plt)

# Temperature profiles
ax4 = plt.subplot2grid((nline,ncol), (0,4), colspan=2)
plt.plot(profiles['rhonorm'],profiles['te'],color='r',label=r'$T_e$')
plt.plot(profiles['rhonorm'],profiles['ti'],color='b',label=r'$T_i$')
nice(plt,r'$\rho/\rho_0$','$T\/[\mathrm{keV}]$',fontsize)
plt.xlim(0,1)
plt.title('t = '+'%.1f' % time+' s', fontdict=font)
Signature(hostdir,shot,run,plt)

# Density profiles
ax5 = plt.subplot2grid((nline,ncol), (0,6),colspan=2)
plt.plot(profiles['rhonorm'],profiles['ne'],color='r',label=r'$n_e$')
plt.plot(profiles['rhonorm'],profiles['ni'],color='b',label=r'$n_i$')
for ispecies in range(nspecies):
    if (plot_compo == 1) & (nspec_over_ne[ispecies] > impurity_limit):
        plt.plot(profiles['rhonorm'],profiles['n_species'][species[ispecies]]['density'] \
                 ) #,label=r'$n_'+species[ispecies]+'$')

nice(plt,r'$\rho/\rho_0$','$n\/[\mathrm{m^{-3}}]$',fontsize)
plt.xlim(0,1)
plt.title('t = '+'%.1f' % time+' s', fontdict=font)
Signature(hostdir,shot,run,plt)

# Zeff profile
ax6 = plt.subplot2grid((nline,ncol), (1,4),colspan=2)
plt.plot(profiles['rhonorm'],profiles['zeff'],color='b',label=r'$Z_{eff}$')
nice(plt,r'$\rho/\rho_0$','$Z_{eff}$',fontsize)
plt.xlim(0,1)
plt.title('t = '+'%.1f' % time+' s', fontdict=font)
Signature(hostdir,shot,run,plt)

# Vtor profiles
ax7 = plt.subplot2grid((nline,ncol), (1,6),colspan=2)
for ispecies in range(nspecies):
    if (plot_compo == 1) & (nspec_over_ne[ispecies] > impurity_limit):
        plt.plot(profiles['rhonorm'],profiles['n_species'][species[ispecies]]['vtor'])

nice(plt,r'$\rho/\rho_0$',r'$|v_{tor}|\/[\mathrm{m.s^{-1}}]$',fontsize)
plt.xlim(0,1)
if max_vtor > min_vtor:
    plt.ylim(min_vtor,max_vtor*1.1)

plt.gca().yaxis.set_major_formatter(mtick.FormatStrFormatter('%.0d'))
plt.title('t = '+'%.1f' % time+' s', fontdict=font)
Signature(hostdir,shot,run,plt)

