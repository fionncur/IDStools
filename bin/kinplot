                        if len(edge_profiles.ggd[0].ion[jspecies].velocity[gset].poloidal) == erho:
                            for i in range(erho):
                                ion_vpol[ispecies][nrho+i] = abs(edge_profiles.ggd[0].ion[jspecies].velocity[gset].poloidal[i])
                            vpol_e_flag = 1
                    except:
