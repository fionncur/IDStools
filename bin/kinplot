#!/usr/bin/env python
from __future__ import print_function

import os, sys, glob, yaml, argparse, re, imas, pdb
from operator import itemgetter
from stat import *
from numpy import *
import init_mendeleiev as mend

# ----------------------------------------------------------------------

def find_nearest(a, a0):
    'Element in nd array `a` closest to the scalar value `a0`'
    idx = abs(a - a0).argmin()
    return a.flat[idx],idx

# ----------------------------------------------------------------------

# Management of input arguments
parser = argparse.ArgumentParser(description=\
    '---- Display the plasma kinetic profiles from the core_profiles IDSs')
parser.add_argument('-u','--user_or_path',help='User or absolute path name of the DB where the data-entry is located', required=False)
parser.add_argument('-d','--database',help='Database name of the targeted data-entry', required=False)
parser.add_argument('-s','--shot',help='Shot number', required=True,type=int)
parser.add_argument('-r','--run',help='Run number',required=True,type=int)
parser.add_argument('-t','--time',help='Time', required=False,type=float)
args = vars(parser.parse_args())

# For execution from python shell
#args = {'run': 6, 'database': None, 'user_or_path': None, 'time': None, 'shot': 4321}

shot = args['shot']
run  = args['run']

# User or absolute path name
if args['user_or_path'] != None:
    user_or_path = args['user_or_path']
else:
    user_or_path = 'public'

# Database name
if args['database'] != None:
    database = args['database']
else:
    database = 'iterdb'

# Time
if args['time'] != None:
    time = args['time']
else:
    time = -99.

# Open the database and read the necessary IDSs
version = os.getenv('IMAS_VERSION')[0]
input=imas.ids(shot,run)
[err,n]=input.open_env(user_or_path,database,version,silent=True)
if err != 0:
    print('Shot ' + str(shot) + ', run ' + str(run) +' for user_or_path = '+user_or_path+' and database = '+database+' does not exist', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

if user_or_path == 'public':
    DB_ABS_PATH = '/work/imas/shared/'+str(database)+'/3/0'
else:
    DB_ABS_PATH = os.path.expanduser("~{}".format(user_or_path))+"/public/imasdb/"+str(database)+"/3/0"

try:
    #input.core_profiles.get()
    core_profiles = input.core_profiles # To initialise the empty IDS structure
    core_profiles.time = input.core_profiles.partialGet('time')
    if core_profiles.time is None:
        print('No core_profiles IDS in the data-entry --> Abort.', file=sys.stderr)
        exit()
except:
    print('The core_profiles IDS is absent from the input data-entry', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()

edge_present = 0
try:
    edge_profiles = input.edge_profiles # Bring in edge_profiles if available
    edge_profiles.time = input.edge_profiles.partialGet('time')
    if edge_profiles.time != None:
        print('Found adjoining edge_profiles. Will attempt to add to plots', file=sys.stdout)
        edge_present = 1
except:
    print('No associated edge_profiles data', file=sys.stdout)

hostdir = os.environ["HOSTNAME"]+":"+DB_ABS_PATH
hostdir = hostdir[:-2]

# ----------------------------------------------------------------------

# Search for adequate time slice for display
ntime = len(core_profiles.time)
timevec = core_profiles.time
if ntime > 1:
    if time >= 0:
        [tc,it] = find_nearest(timevec,time)
    else:
        it = int(ntime/2)
        tc = timevec[it]
    print('   Time  = '+'%.2f' % tc+' s in range ['+'%.2f' % timevec[0]+','+'%.2f' % timevec[ntime-1]+'] s', file=sys.stderr)
    print('   Index = ',str(it), file=sys.stderr)
    print('   Averaged resolution = ', (timevec[ntime-1]-timevec[0])/(ntime-1),' s', file=sys.stderr)
else:
    if len(timevec) > 0:
        tc = timevec[0]
    else:
        tc = 0
    it = 0

# Read 1D-profiles for this time slice
core_profiles.profiles_1d.resize(1)
core_profiles.profiles_1d[0] = input.core_profiles.partialGet('profiles_1d('+str(it)+')')

time = tc

# Add 1D-profiles edge data if present
if edge_present == 1:
    etime = len(edge_profiles.time)
    timeedg = edge_profiles.time
    if etime > 1:
        if time >= 0:
            [te,et] = find_nearest(timeedg,time)
        else:
            et = int(etime/2)
            te = timeedg[et]
        print('   Time (edge) = '+'%.2f' % te+' s in range ['+'%.2f' % timeedg[0]+','+'%.2f' % timeedg[etime-1]+'] s', file=sys.stderr)
        print('   Index = ',str(et), file=sys.stderr)
        print('   Averaged edge time resolution = ', (timeedg[etime-1]-timeedg[0])/(etime-1),' s', file=sys.stderr)
    else:
        if len(timeedg) > 0:
            te = timeedg[0]
        else:
            te = 0
        et = 0

# Read 1D-profiles for this time slice
    if len(edge_profiles.profiles_1d) > 0:
        edge_profiles.profiles_1d.resize(1)
        edge_profiles.profiles_1d[0] = input.edge_profiles.partialGet('profiles_1d('+str(et)+')')

        teme = te
    else:
        print('No profiles_1d information found in edge_profiles', file=sys.stderr)
        edge_present = 0

# Mendeleiev table
table_mendeleiev = mend.create_table_mendeleiev()

# ----------------------------------------------------------------------

# A priori the plasma composition can be read
plot_compo = 1

# Rho profile (mandatory)
nrho=0
try:
    rho_tor_norm = 0
    if len(core_profiles.profiles_1d[0].grid.rho_tor_norm) > 0:
        nrho = len(core_profiles.profiles_1d[0].grid.rho_tor_norm)
        rho_tor_norm = core_profiles.profiles_1d[0].grid.rho_tor_norm
    elif len(core_profiles.profiles_1d[0].grid.rho_tor) > 0:
        nrho = len(core_profiles.profiles_1d[0].grid.rho_tor)
        rho_tor_norm = core_profiles.profiles_1d[0].grid.rho_tor/core_profiles.profiles_1d[0].grid.rho_tor[nrho-1]
except:
    print('core_profiles.profiles_1d[:].grid.rho_tor_norm and rho_tor could not be read', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()
if nrho == 0:
    print('core_profiles.profiles_1d[:].grid.rho_tor_norm and rho_tor are empty', file=sys.stderr)
    print('----> Aborted.', file=sys.stderr)
    exit()
xend = 1

erho=0
if edge_present == 1:
    try:
        if len(edge_profiles.profiles_1d[0].grid.rho_tor_norm) > 0:
            erho = len(edge_profiles.profiles_1d[0].grid.rho_tor_norm)
            rho_tor_norm[nrho:nrho+erho-1] = edge_profiles.profiles_1d[0].rho_tor_norm
        elif len(edge_profiles.profiles_1d[0]/grid.rho_tor) > 0:
            erho = len(edge_profiles.profiles_1d[0].grid.rho_tor)
            rho_tor_norm[nrho:nrho+erho-1] = edge_profiles.profiles_1d[0].grid.rho_tor/core_profiles.profiles_1d[0].grid.rho_tor[nrho-1]
        xend = max(xend,rho_tor_norm[nrho+erho-1])
    except:
        print('edge_profiles.profiles_1d[:].grid.rho_tor_norm and rho_tor could not be read', file=sys.stderr)
    if erho == 0:
        print('edge_profiles.profiles_1d[:].grid.rho_tor_norm and rho_tor are empty', file=sys.stdout)

# Species A number (not mandatory)
try:
    nspecies = len(core_profiles.profiles_1d[0].ion)
    a = [0] * nspecies
    for ispecies in range(nspecies):
        a[ispecies] = int(core_profiles.profiles_1d[0].ion[ispecies].element[0].a)
except:
    print('core_profiles.profiles_1d[:].ion[0].element[0].a could not be read', file=sys.stderr)
    plot_compo = 0

# Species Z number (not mandatory)
try:
    nspecies = len(core_profiles.profiles_1d[0].ion)
    z = [0] * nspecies
    for ispecies in range(nspecies):
        z[ispecies] = int(core_profiles.profiles_1d[0].ion[ispecies].element[0].z_n)
except:
    print('core_profiles.profiles_1d[:].ion[0].element[0].z_n could not be read', file=sys.stderr)
    plot_compo = 0

# Volume profile (not mandatory)
try:
    volume = core_profiles.profiles_1d[0].grid.volume
    if len(volume) == 0:
        try:
            equilibrium = input.equilibrium
            equilibrium.time_slice[0].profiles_1d.volume = input.equilibrium.partialGet('time_slice('+str(it)+')/profiles_1d/volume')
        except:
            exit()
        volume = equilibrium.time_slice[0].profiles_1d.volume
        if len(volume) == len(core_profiles.profiles_1d[0].electrons.density):
            print('   core_profiles.profiles_1d[:].grid.volume could not be read', file=sys.stderr)
            print('   ----> equilibrium.time_slice[:].profiles_1d.volume used instead', file=sys.stderr)
            print('   (possible because the resolution is the same, but maybe not correct)', file=sys.stderr)
        else:
            exit()
    if edge_present == 1:
        volume[nrho:nrho+erho-1] = edge_profiles.profiles_1d[0].grid.volume
except:
    print('core_profiles.profiles_1d[:].grid.volume could not be read', file=sys.stderr)
    plot_compo = 0

# Zeff profile (not mandatory)
zeff = [0]
if len(core_profiles.profiles_1d[0].zeff) < 1:
    print('core_profiles.profiles_1d[:].zeff could not be read', file=sys.stderr)
    for itime in range(ntime):
        core_profiles.profiles_1d[itime].zeff = asarray([nan]*nrho)
zeff[0:nrho-1] = core_profiles.profiles_1d[0].zeff
if edge_present == 1:
    if len(edge_profiles.profiles_1d[0].zeff) < 1:
        print('edge_profiles.profiles_1d[:].zeff could not be read', file=sys.stderr)
    for itime in range(etime):
        edge_profiles.profiles_1d[itime].zeff = asarray([nan]*erho)
    zeff[nrho:nrho+erho-1] = edge_profiles.profiles_1d[0].zeff

# Ne profile (not mandatory)
electron_density = [0]
if len(core_profiles.profiles_1d[0].electrons.density) < 1:
    print('core_profiles.profiles_1d[:].electrons.density could not be read', file=sys.stderr)
    for itime in range(ntime):
        core_profiles.profiles_1d[itime].electrons.density = asarray([nan]*nrho)
electron_density[0:nrho-1] = core_profiles.profiles_1d[0].electrons.density
if edge_present == 1:
    if len(edge_profiles.profiles_1d[0].electrons.density) < 1:
        print('edge_profiles.profiles_1d[:].electrons.density could not be read', file=sys.stderr)
        for itime in range(etime):
            edge_profiles.profiles_1d[itime].electrons.density = asarray([nan]*erho)
    electron_density[nrho:nrho+erho-1] = edge_profiles.profiles_1d[0].electrons.density

# Te profile (not mandatory)
electron_temperature = [0]
if len(core_profiles.profiles_1d[0].electrons.temperature) < 1:
    print('core_profiles.profiles_1d[:].electrons.temperature could not be read', file=sys.stderr)
    for itime in range(ntime):
        core_profiles.profiles_1d[itime].electrons.temperature = asarray([nan]*nrho)
electron_temperature[0:nrho-1] = core_profiles.profiles_1d[0].electrons.temperature*1.e-3
if edge_present == 1:
    if len(edge_profiles.profiles_1d[0].electrons.temperature) < 1:
        print('edge_profiles.profiles_1d[:].electrons.temperature could not be read', file=sys.stderr)
        for itime in range(etime):
            edge_profiles.profiles_1d[itime].electrons.temperature = asarray([nan]*erho)
    electron_temperature[nrho:nrho+erho-1] = edge_profiles.profiles_1d[0].electrons.temperature*1.e-3

# Ti profile (not mandatory)
ti_flag = 0
if len(core_profiles.profiles_1d[0].t_i_average) < 1:
    print('core_profiles.profiles_1d[:].t_i_average could not be read', file=sys.stderr)
    for itime in range(ntime):
        core_profiles.profiles_1d[itime].t_i_average = asarray([nan]*nrho)
else:
    ti_flag = 1
if edge_present == 1:
    if len(edge_profiles.profiles_1d[0].t_i_average) < 1:
        print('edge_profiles.profiles_1d[:].t_i_average could not be read', file=sys.stderr)
        for itime in range(etime):
            edge_profiles.profiles_1d[itime].t_i_average = asarray([nan]*erho)

for ispecies in range(nspecies):
    if len(core_profiles.profiles_1d[0].ion[ispecies].temperature) < 1:
        print('core_profiles.profiles_1d[:].ion['+str(ispecies)+'].temperature could not be read', file=sys.stderr)
        for itime in range(ntime):
            core_profiles.profiles_1d[itime].ion[ispecies].temperature = asarray([nan]*nrho)
    else:
        if ti_flag == 0:
            ti_flag = 2
    if edge_present == 1:
        if len(edge_profiles.profiles_1d[0].ion[ispecies].temperature) < 1:
            print('edge_profiles.profiles_1d[:].ion['+str(ispecies)+'].temperature could not be read', file=sys.stderr)
            for itime in range(etime):
                edge_profiles.profiles_1d[itime].ion[ispecies].temperature = asarray([nan]*erho)

ion_temperature = [0]
if ti_flag == 1:
    ion_temperature[0:nrho-1] = core_profiles.profiles_1d[0].t_i_average*1.e-3
    if edge_present == 1:
        ion_temperature[nrho:nrho+erho-1] = edge_profiles.profiles_1d[0].t_i_average*1.e-3
else:
    ion_temperature[0:nrho-1] = core_profiles.profiles_1d[0].ion[0].temperature*1.e-3
    if edge_present == 1:
        ion_temperature[nrho:nrho+erho-1] = edge_profiles.profiles_1d[0].ion[0].temperature*1.e-3

# Ni profile (not mandatory)
ion_density = {}
for ispecies in range(nspecies):
    ion_density[ispecies] = [0]
    if len(core_profiles.profiles_1d[0].ion[ispecies].density) < 1:
        print('core_profiles.profiles_1d[:].ion['+str(ispecies)+'].density could not be read', file=sys.stderr)
        for itime in range(ntime):
            core_profiles.profiles_1d[itime].ion[ispecies].density = asarray([nan]*nrho)
    ion_density[ispecies][0:nrho-1] = core_profiles.profiles_1d[0].ion[ispecies].density
    if edge_present == 1:
        if len(edge_profiles.profiles_1d[0].ion[ispecies].density) < 1:
            print('edge_profiles.profiles_1d[:].ion['+str(ispecies)+'].density could not be read', file=sys.stderr)
            for itime in range(etime):
                edge_profiles.profiles_1d[itime].ion[ispecies].density = asarray([nan]*erho)
        ion_density[ispecies][nrho:nrho+erho-1] = edge_profiles.profiles_1d[0].ion[ispecies].density

# Vtor profile (not mandatory)
vtor_flag = 0
ion_vtor = {}
for ispecies in range(nspecies):
    ion_vtor[ispecies] = [0]
    if len(core_profiles.profiles_1d[0].ion[ispecies].velocity.toroidal) < 1:
        print('core_profiles.profiles_1d[:].ion['+str(ispecies)+'].velocity.toroidal could not be read', file=sys.stderr)
        for itime in range(ntime):
            core_profiles.profiles_1d[itime].ion[ispecies].velocity.toroidal = asarray([nan]*nrho)
    else:
        vtor_flag = 1
        ion_vtor[ispecies][0:nrho-1] = abs(core_profiles.profiles_1d[0].ion[ispecies].velocity.toroidal)
    if len(core_profiles.profiles_1d[0].ion[ispecies].velocity_tor) < 1:
        print('core_profiles.profiles_1d[:].ion['+str(ispecies)+'].velocity_tor could not be read', file=sys.stderr)
        for itime in range(ntime):
            core_profiles.profiles_1d[itime].ion[ispecies].velocity_tor = asarray([nan]*nrho)
    else:
        if vtor_flag == 0:
            vtor_flag = 2
            ion_vtor[ispecies][0:nrho-1] = abs(core_profiles.profiles_1d[0].ion[ispecies].velocity_tor)
    if edge_present == 1:
        if vtor_flag == 1:
            if len(edge_profiles.profiles_1d[0].ion[ispecies].velocity.toroidal) < 1:
                print('edge_profiles.profiles_1d[:].ion['+str(ispecies)+'].velocity.toroidal could not be read', file=sys.stderr)
                for itime in range(etime):
                    edge_profiles.profiles_1d[itime].ion[ispecies].velocity.toroidal = asarray([nan]*erho)
            ion_vtor[ispecies][nrho:nrho+erho-1] = abs(edge_profiles.profiles_1d[0].ion[ispecies].velocity.toroidal)
        elif vtor_flag == 2:
            if len(edge_profiles.profiles_1d[0].ion[ispecies].velocity_tor) < 1:
                print('edge_profiles.profiles_1d[:].ion['+str(ispecies)+'].velocity_tor could not be read', file=sys.stderr)
                for itime in range(etime):
                    edge_profiles.profiles_1d[itime].ion[ispecies].velocity_tor = asarray([nan]*erho)
            ion_vtor[nrho:nrho+erho-1] = abs(edge_profiles.profiles_1d[0].ion[ispecies].velocity_tor)

# Vpol profile (not mandatory)
vpol_flag = 0
ion_vpol = {}
for ispecies in range(nspecies):
    ion_vpol[ispecies] = [0]
    if len(core_profiles.profiles_1d[0].ion[ispecies].velocity.poloidal) < 1:
        print('core_profiles.profiles_1d[:].ion['+str(ispecies)+'].velocity.poloidal could not be read', file=sys.stderr)
        for itime in range(ntime):
            core_profiles.profiles_1d[itime].ion[ispecies].velocity.poloidal = asarray([nan]*nrho)
    else:
        vpol_flag = 1
        ion_vpol[ispecies][0:nrho-1] = abs(core_profiles.profiles_1d[0].ion[ispecies].velocity.poloidal)
    if len(core_profiles.profiles_1d[0].ion[ispecies].velocity_pol) < 1:
        print('core_profiles.profiles_1d[:].ion['+str(ispecies)+'].velocity_pol could not be read', file=sys.stderr)
        for itime in range(ntime):
            core_profiles.profiles_1d[itime].ion[ispecies].velocity_pol = asarray([nan]*nrho)
    else:
        if vpol_flag == 0:
            vpol_flag = 2
            ion_vpol[ispecies][0:nrho-1] = abs(core_profiles.profiles_1d[0].ion[ispecies].velocity_pol)
    if edge_present == 1:
        if vpol_flag == 1:
            if len(edge_profiles.profiles_1d[0].ion[ispecies].velocity.poloidal) < 1:
                print('edge_profiles.profiles_1d[:].ion['+str(ispecies)+'].velocity.poloidal could not be read', file=sys.stderr)
                for itime in range(etime):
                    edge_profiles.profiles_1d[itime].ion[ispecies].velocity.poloidal = asarray([nan]*erho)
            ion_vpol[ispecies][nrho:nrho+erho-1] = abs(edge_profiles.profiles_1d[0].ion[ispecies].velocity.poloidal)
        elif vpol_flag == 2:
            if len(edge_profiles.profiles_1d[0].ion[ispecies].velocity_pol) < 1:
                print('edge_profiles.profiles_1d[:].ion['+str(ispecies)+'].velocity_pol could not be read', file=sys.stderr)
                for itime in range(etime):
                    edge_profiles.profiles_1d[itime].ion[ispecies].velocity_pol = asarray([nan]*erho)
            ion_vpol[nrho:nrho+erho-1] = abs(edge_profiles.profiles_1d[0].ion[ispecies].velocity_pol)

# ----------------------------------------------------------------------

if (nspecies > 0) & (plot_compo==1):

    # Plasma composition
    species = []
    for ispecies in range(nspecies):
        species.append(table_mendeleiev[z[ispecies]][a[ispecies]].element)

    # Species concentrations
    ntot = 0
    species_density = [0] * nspecies
    max_density = -999.
    for ispecies in range(nspecies):
        species_density[ispecies] = sum(volume*core_profiles.profiles_1d[0].ion[ispecies].density)
        ntot = ntot + species_density[ispecies]
        if species_density[ispecies] > max_density:
            max_density = species_density[ispecies]
            imax = ispecies

    ne = sum(volume*core_profiles.profiles_1d[0].electrons.density)

    nspec_over_ntot = species_density/ntot
    nspec_over_ne   = species_density/ne
    nspec_over_nmaj = species_density/species_density[imax]

    # When a species appears twice: combine
    for ispecies in range(nspecies):
        for jspecies in range(nspecies):
            if (species[jspecies] == species[ispecies]) & (jspecies != ispecies):
                nspec_over_ntot[ispecies] = nspec_over_ntot[ispecies] + nspec_over_ntot[jspecies]
                nspec_over_ntot[jspecies] = 0
                nspec_over_ne[ispecies] = nspec_over_ne[ispecies] + nspec_over_ne[jspecies]
                nspec_over_ne[jspecies] = 0
                nspec_over_nmaj[ispecies] = nspec_over_nmaj[ispecies] + nspec_over_nmaj[jspecies]
                nspec_over_nmaj[jspecies] = 0

    # Nice display of plasma composition with species concentrations
    disp_species         = '   species:      '
    disp_a               = '   a:            '
    disp_z               = '   z:            '
    disp_nspec_over_ntot = '   n_over_ntot:  '
    disp_nspec_over_ne   = '   n_over_ne:    '
    disp_nspec_over_nmaj = '   n_over_n_maj: '
    for ispecies in range(nspecies):
        if nspec_over_ne[ispecies] > 0.:
            tabsize = 8
            disp_species = disp_species + species[ispecies] + ' ' * (tabsize-len(species[ispecies]))
            disp_a = disp_a + format('%.1f' % a[ispecies]) + ' ' * (tabsize-len(format('%.1f' % a[ispecies])))
            disp_z = disp_z + format('%.1f' % z[ispecies]) + ' ' * (tabsize-len(format('%.1f' % z[ispecies])))
            disp_nspec_over_ntot = disp_nspec_over_ntot + format('%.2f' % nspec_over_ntot[ispecies]) \
                                   + ' ' * (tabsize-len(format('%.2f' % nspec_over_ntot[ispecies])))
            disp_nspec_over_ne   = disp_nspec_over_ne   + format('%.2f' % nspec_over_ne[ispecies])   \
                                   + ' ' * (tabsize-len(format('%.2f' % nspec_over_ne[ispecies])))
            disp_nspec_over_nmaj = disp_nspec_over_nmaj + format('%.2f' % nspec_over_nmaj[ispecies]) \
                                   + ' ' * (tabsize-len(format('%.2f' % nspec_over_nmaj[ispecies])))

    print('   ------------', file=sys.stderr)
    print(disp_species, file=sys.stderr)
    print(disp_a, file=sys.stderr)
    print(disp_z, file=sys.stderr)
    print(disp_nspec_over_ntot, file=sys.stderr)
    print(disp_nspec_over_ne, file=sys.stderr)
    print(disp_nspec_over_nmaj, file=sys.stderr)
    print('   ------------', file=sys.stderr)

else:
    nspec_over_ne = [0]*nspecies

# ----------------------------------------------------------------------

# Criteria for significant impurity (in X[imp]/ne concentration)
impurity_limit = 0.001

# Create the dictionary defining the list of profiles that can be displayed
profiles = {}
profiles['rhonorm'] = rho_tor_norm
profiles['te'] = electron_temperature
profiles['ti'] = ion_temperature
profiles['ne'] = electron_density

profiles['ni'] = [0] * (nrho+erho)
profiles['zeff'] = zeff
profiles['n_species'] = {}
for ispecies in range(nspecies):
    if plot_compo == 1:
        if nspec_over_ne[ispecies] > impurity_limit:
            profiles['n_species'][species[ispecies]]={}
            profiles['n_species'][species[ispecies]]['density'] = ion_density[ispecies]
            if vpol_flag != 0:
                profiles['n_species'][species[ispecies]]['vpol'] = ion_vpol[ispecies]
            if vtor_flag != 0:
                profiles['n_species'][species[ispecies]]['vtor'] = ion_vtor[ispecies]
    for i in range(nrho+erho):
        profiles['ni'][i] = profiles['ni'][i] + ion_density[ispecies][i]

# Min and max of velocity profiles
max_vtor = -9e99
min_vtor = 9e99
max_vpol = -9e99
min_vpol = 9e99
for ispecies in range(nspecies):
    if (plot_compo == 1) & (nspec_over_ne[ispecies] > impurity_limit):
        if 'vtor'  in profiles['n_species'][species[ispecies]].keys():
          if max_vtor < max(profiles['n_species'][species[ispecies]]['vtor'][0:nrho-1]):
              max_vtor = max(profiles['n_species'][species[ispecies]]['vtor'][0:nrho-1])
          if min_vtor > min(profiles['n_species'][species[ispecies]]['vtor'][0:nrho-1]):
              min_vtor = min(profiles['n_species'][species[ispecies]]['vtor'][0:nrho-1])
        if 'vpol'  in profiles['n_species'][species[ispecies]].keys():
          if max_vpol < max(profiles['n_species'][species[ispecies]]['vpol'][0:nrho-1]):
              max_vpol = max(profiles['n_species'][species[ispecies]]['vpol'][0:nrho-1])
          if min_vpol > min(profiles['n_species'][species[ispecies]]['vpol'][0:nrho-1]):
              min_vpol = min(profiles['n_species'][species[ispecies]]['vpol'][0:nrho-1])

# Create the dictionary defining the list of waveforms (central values) that can be displayed
def createWaveForm(ndim):
    return {'central': [0]*ndim,'edge': [0]*ndim,'rho95': [0]*ndim}

waveform = {}
waveform['time'] = timevec
for ikey in ['te','ti','ne','zeff']:
    waveform[ikey] = createWaveForm(0)

imas_2928 = 0

waveform['te']['central'] = input.core_profiles.partialGet('profiles_1d(:)/electrons/temperature(0)')*1e-3
if ti_flag == 1:
    waveform['ti']['central'] = input.core_profiles.partialGet('profiles_1d(:)/t_i_average(0)')*1e-3
else:
    # Wait for resolution of IMAS-2928
    if imas_2928 == 1:
        waveform['ti']['central'] = input.core_profiles.partialGet('profiles_1d(:)/ion(0)/temperature(0)')*1e-3
    else:
        waveform['ti']['central'] = [NaN]*ntime

waveform['ne']  ['central'] = input.core_profiles.partialGet('profiles_1d(:)/electrons/density(0)')
waveform['zeff']['central'] = input.core_profiles.partialGet('profiles_1d(:)/zeff(0)')

waveform['n_species'] = {}
waveform['ni'] = createWaveForm(ntime)
for ispecies in range(nspecies):
    if (plot_compo == 1) & (nspec_over_ne[ispecies] > impurity_limit):
        waveform['n_species'][species[ispecies]]={'density' : createWaveForm(0), 'vpol' : createWaveForm(0),'vtor' : createWaveForm(0)}

    # Wait for resolution of IMAS-2928
    if imas_2928 == 1:
        if (plot_compo == 1) & (nspec_over_ne[ispecies] > impurity_limit):
            waveform['n_species'][species[ispecies]]['density']['central'] = \
                input.core_profiles.partialGet('profiles_1d(:)/ion('+str(ispecies)+')/density(0)')
            if vpol_flag == 1:
                waveform['n_species'][species[ispecies]]['vpol']['central'] = \
                input.core_profiles.partialGet('profiles_1d(:)/ion('+str(ispecies)+')/velocity/poloidal(0)')
            elif vpol_flag == 2:
                waveform['n_species'][species[ispecies]]['vpol']['central'] = \
                input.core_profiles.partialGet('profiles_1d(:)/ion('+str(ispecies)+')/velocity_pol(0)')
            if vtor_flag == 1:
                waveform['n_species'][species[ispecies]]['vtor']['central'] = \
                input.core_profiles.partialGet('profiles_1d(:)/ion('+str(ispecies)+')/velocity/toroidal(0)')
            elif vtor_flag == 2:
                waveform['n_species'][species[ispecies]]['vtor']['central'] = \
                input.core_profiles.partialGet('profiles_1d(:)/ion('+str(ispecies)+')/velocity_tor(0)')
    else:
        if (plot_compo == 1) & (nspec_over_ne[ispecies] > impurity_limit):
            waveform['n_species'][species[ispecies]]['density']['central'] = [NaN]*ntime
            waveform['n_species'][species[ispecies]]['vpol']   ['central'] = [NaN]*ntime
            waveform['n_species'][species[ispecies]]['vtor']   ['central'] = [NaN]*ntime

    if (plot_compo == 1) & (nspec_over_ne[ispecies] > impurity_limit):
        for itime in range(ntime):
            waveform['ni']['central'][itime] = waveform['ni']['central'][itime] + waveform['n_species'][species[ispecies]]['density']['central'][itime]

