easyblock = "PythonBundle"

name = "IDStools"
local_commit = "__COMMITHASH__"
version = "__VERSION__"

homepage = (
    "https://sharepoint.iter.org/departments/POP/CM/IMDesign/"
    "Code%20Documentation/idstools-doc/devdocs/index.html"
)
description = """IDSTools Version (__RAWVERSION__) is a collection of apps for modifying and getting valuable 
information from Interface Data Structures (IDSs). It includes a library of routines for retrieving relevant 
data from IDSes. It also offers readily available various forms of visualizations. These tools were created 
in conjunction with scientists and software developers from the fusion community. The goal of having a common 
set of functions in the IDSTools is to reduce the work of reinventing the wheel by utilizing accessible functions

Git Repo : https://git.iter.org/projects/IMAS/repos/idstools
"""

toolchain = {"name": "foss", "version": "2020b"}

dependencies = [
    ("Python", "3.8.6"),
    ("SciPy-bundle", "2020.11"),
]

use_pip = True
exts_download_dep_fail = True
# sanity_pip_check = True
# use_pip_requirement = False

exts_list = [
    (
        "Cerberus",
        "1.3.4",
        {
            "source_urls": [
                "https://pypi.python.org/packages/source/%(nameletterlower)s/%(namelower)s"
            ],
            "checksums": [
                "d1b21b3954b2498d9a79edf16b3170a3ac1021df88d197dc2ce5928ba519237c"
            ],
        },
    ),
    (
        "fortranformat",
        "1.2.2",
        {
            "checksums": [
                "a8c41ab39bb40444e6ca17f38755d64df51799b064206833c137a28bbdca1b2b"
            ],
        },
    ),
    (
        name,
        version,
        {
            "source_urls": [
                "https://git.iter.org/rest/api/latest/projects/IMAS/repos/%(namelower)s/archive?at="
                + local_commit
                + "&filename=%(namelower)s-%(version)s.zip"
            ],
            "sources": [SOURCE_ZIP],
        },
    ),
]

sanity_check_paths = {
    "files": [],
    "dirs": ["/work/imas/"],
}

sanity_check_commands = ["python3 -c 'import idstools.compute.common'"]

moduleclass = "data"
