#!/usr/bin/env python3
# -*- coding: utf-8 -*-
import argparse
import sys

import imaspy
import numpy
import rich
from imaspy.ids_primitive import IDSPrimitive
from imaspy.ids_struct_array import IDSStructArray
from imaspy.ids_structure import IDSStructure
from rich.columns import Columns
from rich.pretty import Pretty
from rich.tree import Tree
from rich_argparse import RichHelpFormatter

from idstools.database import DBMaster
from idstools.utils.clihelper import dbentry_parser
from idstools.utils.idslogger import setup_logger

logger = setup_logger("module")


def print_tree(structure, hide_empty_nodes,compact,  full_array):
    if full_array:
        with numpy.printoptions(threshold=sys.maxsize, linewidth=1024, precision=4):
            rich.print(_make_tree(structure, hide_empty_nodes, compact))
    else:
        with numpy.printoptions(threshold=5, linewidth=1024, precision=4):
            rich.print(_make_tree(structure, hide_empty_nodes, compact))
            
def _make_tree(structure, hide_empty_nodes, compact, *,  tree=None):
    """Build the ``rich.tree.Tree`` for display in :py:meth:`print_tree`.

    Args:
        structure: IDS structure to add to the tree
        hide_empty_nodes: Show or hide nodes without value.

    Keyword Args:
        tree: If provided, child items will be added to this Tree object. Otherwise a
            new Tree is constructed.
    """
    
    if tree is None:
        if isinstance(structure, numpy.ndarray):
            tree = Tree(f"[magenta]{type(structure)}")
            if structure.size==0:
                value = "[bright_black]"
                txt = f"[grey62]numpy.ndarray|{structure.shape}|{structure.dtype}[/]"
            else:
                value=Pretty(structure)
                txt = f"[bright_yellow]numpy.ndarray|{structure.shape}|{structure.dtype}[/]:"

            group = Columns([txt, value])
            if compact:
                txt = f"[bright_yellow]numpy.ndarray|{structure.shape}|{structure.dtype}[/]"
                group = Columns([txt])
            tree.add(group)
            return tree
        elif isinstance(structure, imaspy.ids_primitive.IDSNumericArray):
            tree = Tree(f"[magenta]{type(structure)}")
            if structure.size==0:
                value = "[bright_black]"
                txt = f"[grey62]numpy.ndarray|{structure.shape}|{structure.dtype}[/]"
            else:
                value=Pretty(structure)
                txt = f"[bright_yellow]numpy.ndarray|{structure.shape}|{structure.dtype}[/]:"

            group = Columns([txt, value])
            if compact:
                txt = f"[bright_yellow]numpy.ndarray|{structure.shape}|{structure.dtype}[/]"
                group = Columns([txt])
            tree.add(group)
            return tree
        else:
            tree = Tree(f"[magenta]{structure.metadata.name}")
            
    iterator = structure
    if hide_empty_nodes and isinstance(structure, IDSStructure):
        iterator = structure.iter_nonempty_(accept_lazy=True)

    for counter,child in enumerate(iterator):
        if isinstance(child, (numpy.ndarray)):
            if child.size==0:
                value = "[bright_black]"
                txt = f"[grey62]numpy.ndarray|{child.shape}|{child.dtype}|{counter}][/]"
            else:
                value=Pretty(child)
                txt = f"[bright_yellow]numpy.ndarray|{child.shape}|{child.dtype}|{counter}][/]:"

            group = Columns([txt, value])
            if compact:
                txt = f"[bright_yellow]numpy.ndarray|{child.shape}|{child.dtype}|{counter}][/]"
                group = Columns([txt])
            tree.add(group)
        elif isinstance(child, IDSPrimitive):
            if not child.has_value:
                value = "[bright_black]"
                txt = f"[grey62]{child.metadata.name}[/]"
            else:
                value=Pretty(child.value)
                txt = f"[bright_yellow]{child.metadata.name}[/]:"

            group = Columns([txt, value])
            if compact:
                txt = f"[bright_yellow]{child.metadata.name}[/]"
                group = Columns([txt])
            tree.add(group)
        else:
            # print(type(child))
            if isinstance(child, IDSStructure):
                txt = f"[magenta]{child._path}[/]"
                ntree = tree.add(txt)
                _make_tree(child, hide_empty_nodes, compact, tree=ntree)
            elif isinstance(child, IDSStructArray):
                ntree = tree
                if not child.has_value:
                    tree.add(f"[magenta]{child._path}[][/]")
                _make_tree(child, hide_empty_nodes, compact, tree=ntree)

    return tree

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="""Prints content of an IDS onto the terminal\n
        provide with fragment
        e.g. -u idsprint --uri "imas:mdsplus?user=public;pulse=122525;run=1;database=ITER;version=3#equilibrium"
        or #equilibrium/time_slice[0]/profiles_2d[0].r[1]
        [previously known as idsdump and idsdumppath]""",
        formatter_class=RichHelpFormatter,
        parents=[dbentry_parser],
    )
    parser.add_argument(
        "-e",
        "--show-empty",
        action="store_true",
        dest="show_empty",
        help="Show empty fields of ids",
    )
    parser.add_argument(
        "-f",
        "--full",
        action="store_true",
        help="Print all array elements (can be slow for large data)",
    )
    parser.add_argument(
        "-c",
        "--compact",
        action="store_true",
        help="Print only names which has data",
    )
    parser.add_argument(
        "-i",
        "--inspect",
        action="store_true",
        help="Print child nodes information and metadata",
    )
    args = parser.parse_args()
    splitted_ids_info = args.uri.split("#")

    uri = splitted_ids_info[0]
    ids_name = ""
    ids_path = None
    occurrence = 0
    if len(splitted_ids_info) == 2:
        ids_fragment = splitted_ids_info[1]
        if ":" in ids_fragment:
            splitted_ids_fragment = ids_fragment.split(":")
            ids_name = splitted_ids_fragment[0]
            if len(splitted_ids_fragment) == 2:
                ids_path_fragment = splitted_ids_fragment[1]
                splitted_ids_path_fragment = ids_path_fragment.split("/", 1)
                occurrence = int(splitted_ids_path_fragment[0])
                if len(splitted_ids_path_fragment) == 2:
                    ids_path = splitted_ids_path_fragment[1]
        else:
            splitted_ids_fragment = ids_fragment.split("/", 1)
            ids_name = splitted_ids_fragment[0]
            if len(splitted_ids_fragment) == 2:
                ids_path = splitted_ids_fragment[1]
    if ids_name == "":
        logger.error("Please provide ids name at the end of uri with hash")
        exit(1)
    args.uri = uri
    connection = DBMaster.get_connection(args)
    if connection is None:
        logger.error("Please provide valid URI")
        exit(1)
    ids = connection.get(ids_name, occurrence)    

    if ids_path is None:
        if args.inspect:
            imaspy.util.inspect(ids, hide_empty_nodes=not args.show_empty)
        else:
            print_tree(ids, hide_empty_nodes=not args.show_empty,compact=args.compact, full_array=args.full)
    else:
        ids_path=ids_path.replace("(", "[").replace(")", "]").replace("/", ".")
        node = eval("ids." + ids_path)
        if args.inspect:
            imaspy.util.inspect(node, hide_empty_nodes=not args.show_empty)    
        else:
            print_tree(node, hide_empty_nodes=not args.show_empty,compact=args.compact, full_array=args.full)
    connection.close()
