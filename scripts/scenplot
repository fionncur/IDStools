    #core_profiles.profiles_1d[0].j_non_inductive   = input.core_profiles.partialGet('profiles_1d('+str(it)+')/j_non_inductive')
    #core_profiles.profiles_1d[0].j_ohmic           = input.core_profiles.partialGet('profiles_1d('+str(it)+')/j_ohmic')
    #core_profiles.profiles_1d[0].j_total           = input.core_profiles.partialGet('profiles_1d('+str(it)+')/j_total')
    #core_profiles.profiles_1d[0].q                 = input.core_profiles.partialGet('profiles_1d('+str(it)+')/q')
    #core_profiles.profiles_1d[0].magnetic_shear    = input.core_profiles.partialGet('profiles_1d('+str(it)+')/magnetic_shear')

    equilibrium.time_slice.resize(1)
    equilibrium.time_slice[0].profiles_2d.resize(1)

    # Here individual partialGet seems more optimal than a global one on profiles_2d (not very clear)
    #equilibrium.time_slice[0].profiles_2d[0].r   = input.partial_get('equilibrium','time_slice('+str(it)+')/profiles_2d(0)/r')
    #equilibrium.time_slice[0].profiles_2d[0].z   = input.partial_get('equilibrium','time_slice('+str(it)+')/profiles_2d(0)/z')
    #equilibrium.time_slice[0].profiles_2d[0].psi = input.partial_get('equilibrium','time_slice('+str(it)+')/profiles_2d(0)/psi')
    equilibrium.time_slice[0].profiles_2d   = connection.partial_get('equilibrium','time_slice('+str(it)+')/profiles_2d')
    if len(equilibrium.time_slice[0].profiles_2d) == 0:
        plot_equi = 0
    else:
        if len(equilibrium.time_slice[0].profiles_2d[0].grid.dim1)>0:
            plot_equi = 1
        else:
            plot_equi = 0

    time = tc

    # psi(R,Z) (not mandatory)
    if plot_equi == 1:
        if equilibrium.time_slice[0].profiles_2d[0].psi is None or len(equilibrium.time_slice[0].profiles_2d[0].psi)==0:
            print('equilibrium.time_slice[:].profiles_2d[0].psi could not be read', file=sys.stderr)
            plot_equi = 0
        if equilibrium.time_slice[0].profiles_2d[0].r is None or len(equilibrium.time_slice[0].profiles_2d[0].r)==0:
            print('equilibrium.time_slice[:].profiles_2d[0].r could not be read', file=sys.stderr)
            plot_equi = 0
        if equilibrium.time_slice[0].profiles_2d[0].z is None or len(equilibrium.time_slice[0].profiles_2d[0].z)==0:
            print('equilibrium.time_slice[:].profiles_2d[0].z could not be read', file=sys.stderr)
            plot_equi = 0

    # Rho profile (mandatory)
    computeObj = CoreProfilesCompute(core_profiles)
    profiles = computeObj.getProfiles(0)
    if profiles is None:
        exit(0)
    
