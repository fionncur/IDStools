# H&CD waveforms
# ax1 = plt.subplot2grid((nline,ncol), (0,0), colspan=2)
def viewHCDWaveforms(ax):
    if max(waveform['p_hcd']) > 0:
        ax.plot(waveform['time'],waveform['p_hcd']*1.e-6,plotstyle,label=r'$P_{HCD}$')

    if max(waveform['p_ec']) > 0:
        ax.plot(waveform['time'],waveform['p_ec']*1.e-6,plotstyle,label=r'$P_{EC}$')

    if max(waveform['p_ic']) > 0:
        ax.plot(waveform['time'],waveform['p_ic']*1.e-6,plotstyle,label=r'$P_{IC}$')

    if max(waveform['p_nbi']) > 0:
        ax.plot(waveform['time'],waveform['p_nbi']*1.e-6,plotstyle,label=r'$P_{NBI}$')

    if max(waveform['p_lh']) > 0:
        ax.plot(waveform['time'],waveform['p_lh']*1.e-6,plotstyle,label=r'$P_{LH}$')

    # Fusion waveforms
    if max(waveform['p_fusion']) > 0:
        ax.plot(waveform['time'],waveform['p_fusion']*1.e-6,plotstyle,label=r'$P_{FUS}$')

    if max(waveform['p_neutron']) > 0:
        ax.plot(waveform['time'],waveform['p_neutron']*1.e-6,plotstyle,label=r'$P_{NEUT}$')

    if max(waveform['p_ohmic']) > 0:
        ax.plot(waveform['time'],waveform['p_ohmic']*1.e-6,plotstyle,label=r'$P_{OHM}$')

    if max(waveform['p_steady']) > 0:
        ax.plot(waveform['time'],waveform['p_steady']*1.e-6,plotstyle,label=r'$P_{STEADY}$')

    ax.set_xlim(summary.time[0],summary.time[-1])

    xmin, xmax = ax.get_xlim()
    ymin, ymax = ax.get_ylim() 
    if not args.noProfiles: 
        ax.plot([time,time],[ymin,ymax],color='gray',linestyle='--',linewidth=2,label=r'$t_{slice}$')
        
    if HModePresent == True: 
        ax.fill([th_min,th_max,th_max,th_min],[ymin,ymin,ymax,ymax],\
            'lightyellow',  edgecolor='k',linewidth=0.08,label=r'$H_{mode}$')
    
    ax.set_ylim(ymin,ymax)
    ticksize = 12
    fontsize = 12
    font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}
    ax.tick_params(
            which="both",
            labelsize=ticksize,
        )
    ax.set_xlabel('', fontdict=font, labelpad = 5)
    ax.set_ylabel('$P\/[\mathrm{MW}]$', fontdict=font, labelpad = 0)
    ax.grid(True)
    
    ax.tick_params(axis='x',which='both',bottom=False,top=False,labelbottom=False)
    
    ax.text(xmax+0.01*abs(xmax-xmin)+0.01,ymax-0.97*abs(ymax-ymin),'Shot '+str(args.shot)+' / '+' Run '+str(args.run),fontsize=5,rotation=90)
    
    legend = ax.legend(loc='center left', bbox_to_anchor=(1, 0.5))
    frame = legend.get_frame()
    frame.set_facecolor("0.95")
    for label in legend.get_texts():
        label.set_fontsize(7)
    for label in legend.get_lines():
        label.set_linewidth(1.5)

    if not args.noProfiles:
        ax.set_title('Profiles displayed for t = '+'%.1f' % time+' s', fontdict=font)

def viewIpB0Waveforms(ax):
    # Ip, B0 waveforms
    # ax2 = plt.subplot2grid((nline,ncol), (1,0), sharex=ax1, colspan=2)
    ax.plot(waveform['time'],abs(waveform['ip'])*1.e-6,plotstyle,label=r'$|I_p|$')
    #plt.plot(waveform['time'],waveform['current_non_inductive']*1.e-6,label=r'$J_{NI}$')
    #plt.plot(waveform['time'],waveform['current_bootstrap']*1.e-6,label=r'$J_{BOOT}$')
    #plt.plot(waveform['time'],waveform['current_ohm']*1.e-6,label=r'$J_{OHM}$')
    ax.plot(waveform['time'],abs(waveform['b0']),plotstyle,label=r'$|B_0|$')
    
    xmin, xmax = ax.get_xlim()
    ymin, ymax = ax.get_ylim() 
    
    ax.set_xlim(summary.time[0],summary.time[-1])
    if not args.noProfiles: 
        ax.plot([time,time],[ymin,ymax],color='gray',linestyle='--',linewidth=2,label=r'$t_{slice}$')
    if HModePresent == 1: 
        ax.fill([th_min,th_max,th_max,th_min],[ymin,ymin,ymax,ymax],\
            'lightyellow',  edgecolor='k',linewidth=0.08,label=r'$H_{mode}$')

    ax.set_ylim(ymin,ymax)
    ticksize = 12
    fontsize = 12
    font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}
    ax.tick_params(
            which="both",
            labelsize=ticksize,
        )
    ax.set_xlabel('', fontdict=font, labelpad = 5)
    ax.set_ylabel(r'$I_p\/[\mathrm{MA}], B_0\/[\mathrm{T}]$', fontdict=font, labelpad = 0)
    ax.grid(True)
    
    legend = ax.legend(loc='center left', bbox_to_anchor=(1, 0.5))
    frame = legend.get_frame()
    frame.set_facecolor("0.95")
    for label in legend.get_texts():
        label.set_fontsize(7)
    for label in legend.get_lines():
        label.set_linewidth(1.5)
    
    ax.text(xmax+0.01*abs(xmax-xmin)+0.01,ymax-0.97*abs(ymax-ymin),'Shot '+str(args.shot)+' / '+' Run '+str(args.run),fontsize=5,rotation=90)
    # Signature(hostdir,args.shot,args.run,plt)

def viewEnergyContentWaveforms(ax):
    ax.plot(waveform['time'],waveform['energy_total']*1.e-6,plotstyle,label=r'$W_{TOT}$')
    ax.plot(waveform['time'],waveform['energy_diamagnetic']*1.e-6,plotstyle,label=r'$W_{DIA}$')
    ax.plot(waveform['time'],waveform['energy_thermal']*1.e-6,plotstyle,label=r'$W_{TH}$')
    ax.plot(waveform['time'],waveform['energy_mhd']*1.e-6,plotstyle,label=r'$W_{MHD}$')
    
    xmin, xmax = ax.get_xlim()
    ymin, ymax = ax.get_ylim() 
    
    ax.set_xlim(summary.time[0],summary.time[-1])
    if not args.noProfiles: 
        ax.plot([time,time],[ymin,ymax],color='gray',linestyle='--',linewidth=2,label=r'$t_{slice}$')
    if HModePresent == 1: 
        ax.fill([th_min,th_max,th_max,th_min],[ymin,ymin,ymax,ymax],\
            'lightyellow',  edgecolor='k',linewidth=0.08,label=r'$H_{mode}$')

    ax.set_ylim(ymin,ymax)
    ticksize = 12
    fontsize = 12
    font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}
    ax.tick_params(
            which="both",
            labelsize=ticksize,
        )
    ax.set_xlabel('', fontdict=font, labelpad = 5)
    
    ax.set_ylabel(r'$W\/[\mathrm{MJ}]}$', fontdict=font, labelpad = 0)
    ax.grid(True)
    
    legend = ax.legend(loc='center left', bbox_to_anchor=(1, 0.5))
