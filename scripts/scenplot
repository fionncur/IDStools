try:
    summary = connection.get('summary') 
except:
    logger.critical('The summary IDS is absent from the input data-entry', file=sys.stderr)
    logger.critical('----> Aborted.', file=sys.stderr)
    exit()


stime = len(summary.time)

if stime < 1:
    logger.critical('The summary IDS is absent from the input data-entry', file=sys.stderr)
    logger.critical('----> Aborted.', file=sys.stderr)
    sys.exit(1)

summaryComputeObj = SummaryCompute(summary)
waveform = summaryComputeObj.getSummary()



if np.size(waveform['h_mode'][2:]) > 2:
    def indices(a, func):
        return [i for (i, val) in enumerate(a) if func(val)]
    h_mode_indices  = indices(waveform['h_mode'][2:], lambda h_mode_flag: h_mode_flag>0)
    if len(h_mode_indices) > 0:
        HModePresent = True
        th_min = summary.time[h_mode_indices[0]]
        th_max = summary.time[h_mode_indices[-1]]
    else:
        HModePresent = False
else:
    HModePresent = False
