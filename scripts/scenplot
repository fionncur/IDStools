if not args.noProfiles:
    try:
        #input.core_profiles.get()
        core_profiles = imas.core_profiles() # To initialise the empty IDS structure
        core_profiles.time = connection.partial_get('core_profiles','time')
        core_profiles.global_quantities = connection.partial_get('core_profiles','global_quantities')
        if core_profiles.time is None:
            logger.critical('No core_profiles IDS in the data-entry --> Abort.', file=sys.stderr)
            exit()
    except:
        logger.critical('The core_profiles IDS is absent from the input data-entry', file=sys.stderr)
        logger.critical('----> Aborted.', file=sys.stderr)
        exit()

    try:
        #input.equilibrium.get()
        equilibrium = imas.equilibrium() # To initialise the empty IDS structure
    except:
        logger.critical('The equilibrium IDS is absent from the input data-entry', file=sys.stderr)
        logger.critical('----> Aborted.', file=sys.stderr)
        exit()

    # Search for adequate time slice for display
    timevec = core_profiles.time
    ntime = len(core_profiles.time)
    it, tc = getNearestTime(timevec, args.time)

    # ntime = len(core_profiles.time)
    # timevec = core_profiles.time
