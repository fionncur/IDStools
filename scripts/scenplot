    #     print('   Index = ',str(it), file=sys.stderr)
    #     print('   Averaged resolution = ', (timevec[ntime-1]-timevec[0])/(ntime-1),' s', file=sys.stderr)
    # else:
    #     if len(timevec) > 0:
    #         tc = timevec[0]
    #     else:
    #         tc = 0
    #     it = 0

    # Read 1D-profiles for this time slice
    core_profiles.profiles_1d.resize(1)
    core_profiles.profiles_1d[0] = connection.partial_get('core_profiles','profiles_1d('+str(it)+')')

    # Below is less optimal than global partialGet on profiles_1d (keep it here for reference)
    #core_profiles.profiles_1d[0].grid.rho_tor_norm = input.core_profiles.partialGet('profiles_1d('+str(it)+')/grid/rho_tor_norm')
    #core_profiles.profiles_1d[0].grid.rho_tor      = input.core_profiles.partialGet('profiles_1d('+str(it)+')/grid/rho_tor')
