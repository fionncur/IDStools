def viewEquilibrium(ax):
    # Equilibrium
    # ax5 = plt.subplot2grid((nline,ncol), (0,3), rowspan=2)
    ticksize = 12
    fontsize = 12
    font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}
        
    ax.xaxis.tick_top()
    ax.xaxis.set_label_position('top')
    if plot_equi == 1:
        r2d   = equilibrium.time_slice[0].profiles_2d[0].r
        z2d   = equilibrium.time_slice[0].profiles_2d[0].z
        psi2d = equilibrium.time_slice[0].profiles_2d[0].psi
        ax.contour(r2d,z2d,psi2d,50) #,label=r'$\Psi_{pol}$')
        ax.set_xlim(r2d.min(),r2d.max())
        ax.set_aspect('equal', adjustable='box')
        ax.set_xlabel('R (m)', fontdict=font)
        ax.set_ylabel('Z (m)', fontdict=font)
        
        ax.tick_params(
                which="both",
                labelsize=ticksize,
            )
        ax.set_xlabel('$R\/\mathrm{[m]}$', fontdict=font, labelpad = 5)
        ax.tick_params(axis='both',which='major',labelsize=ticksize)
        ax.set_ylabel(r'$Z\/\mathrm{[m]}$', fontdict=font, labelpad = 0)
        ax.tick_params(axis='x',which='both',bottom=False,top=False,labelbottom=False)
        ax.grid(True)

        xmin, xmax = ax.get_xlim()
        ymin, ymax = ax.get_ylim() 
        ax.text(xmax+0.01*abs(xmax-xmin)+0.01,ymax-0.97*abs(ymax-ymin),'Shot '+str(args.shot)+' / '+' Run '+str(args.run),fontsize=5,rotation=90)
        #plt.title('Time = '+'%.1f' % time+' s', fontdict=font)
        #plt.title('2D equilibrium', fontdict=font)
    else:
        ax.text(0.2, 0.5, '2D equilibrium', fontsize=10)
        ax.text(0.2, 0.45, 'not available', fontsize=10)



# if not args.noProfiles:
def viewQProfileAndMagneticShearProfile(ax):
    # q-profile and magnetic shear profile
    ax.plot(profiles['rhonorm'],profiles['q'],label=r'$q$')
    ax.plot(profiles['rhonorm'],profiles['magnetic_shear'],label=r'$s=\frac{1}{q}\frac{dq}{d\rho}$')
    xmin, xmax = ax.get_xlim()
    ymin, ymax = ax.get_ylim() 
    
    #nice(plt,r'$\rho/\rho_0$','q, shear',fontsize)
    ticksize = 12
    fontsize = 12
    font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}
    ax.tick_params(
            which="both",
            labelsize=ticksize,
        )
    ax.set_ylabel(r'$q,\/s$', fontdict=font, labelpad = 0)
    ax.grid(True)
    
    ax.set_xlim(0,1)
    legend = ax.legend(loc='center left', bbox_to_anchor=(1, 0.5))
    frame = legend.get_frame()
    frame.set_facecolor("0.95")
    for label in legend.get_texts():
        label.set_fontsize(7)
    for label in legend.get_lines():
        label.set_linewidth(1.5)
        
    ax.text(xmax+0.01*abs(xmax-xmin)+0.01,ymax-0.97*abs(ymax-ymin),'Shot '+str(args.shot)+' / '+' Run '+str(args.run),fontsize=5,rotation=90)
    

    # Current density profiles
def viewCurrentDesnityProfiles(ax):
    ax.plot(profiles['rhonorm'],profiles['j_total']*1.e-3,label=r'$j_{TOT}$')
    ax.plot(profiles['rhonorm'],profiles['j_non_inductive']*1.e-3,label=r'$j_{NI}$')
    ax.plot(profiles['rhonorm'],profiles['j_bootstrap']*1.e-3,label=r'$j_{BOOT}$')
    ax.plot(profiles['rhonorm'],profiles['j_ohmic']*1.e-3,label=r'$j_{OHM}$')
    
    xmin, xmax = ax.get_xlim()
    ymin, ymax = ax.get_ylim() 
    
    ticksize = 12
    fontsize = 12
    font = {'family': 'serif','color':  'darkred','weight': 'normal','size': fontsize}
    ax.tick_params(
            which="both",
            labelsize=ticksize,
        )
    ax.set_xlabel(r'$\rho/\rho_0$', fontdict=font, labelpad = 5)
    ax.set_ylabel(r'$j\/[\mathrm{kA/m^2}]$', fontdict=font, labelpad = 0)
    ax.grid(True)
    
    ax.set_xlim(0,1)
    legend = ax.legend(loc='center left', bbox_to_anchor=(1, 0.5))
    frame = legend.get_frame()
    frame.set_facecolor("0.95")
    for label in legend.get_texts():
        label.set_fontsize(7)
    for label in legend.get_lines():
        label.set_linewidth(1.5)
        
    ax.text(xmax+0.01*abs(xmax-xmin)+0.01,ymax-0.97*abs(ymax-ymin),'Shot '+str(args.shot)+' / '+' Run '+str(args.run),fontsize=5,rotation=90)
    
    # legend = plt.legend(loc='upper right',bbox_to_anchor=(1.57,1.05),handlelength=1)
    # CustomLegend_wf(legend,legfsize)
    # Signature(hostdir,args.shot,args.run,plt)
    # ax = plt.gca()
    # xmin, xmax = ax.get_xlim()
    # ymin, ymax = ax.get_ylim()
    # plt.text(xmax,ymin-0.5*(ymax-ymin),hostdir+' - Shot '+str(args.shot)+' / '+' Run '+str(args.run),fontsize=6,color='black',ha='right')


        
