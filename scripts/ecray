#         get_backend_id(args.backend),
#         data["wall"]["db"],
#         data["wall"]["shot"],
#         data["wall"]["run"],
#         data["wall"]["user"],
#     )
#     wall_md.open()
#     wall = wall_md.partial_get(
#         ids_name="wall",
#         data_path="description_ggd(0)/grid_ggd(0)/space(0)/objects_per_dimension(0)/object(:)",
#     )
#     wall_md.close()
#     npoints = len(wall)
#     xw = np.zeros(npoints)
#     yw = np.zeros(npoints)
#     zw = np.zeros(npoints)
#     rw = np.zeros(npoints)
#     for point in range(npoints):
#         xw[point] = wall[point].geometry[0]
#         yw[point] = wall[point].geometry[1]
#         zw[point] = wall[point].geometry[2]
#         rw[point] = np.sqrt(xw[point] ** 2 + yw[point] ** 2)
