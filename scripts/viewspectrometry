#!/usr/bin/env python3
# -*- coding: utf-8 -*-

# migrated from svplot

import argparse
import logging
import os
import sys

import imas

from idstools.compute.common import getNearestTime
from idstools.compute.spectrometer_visible import SpectrometerVisibleCompute
from idstools.utils.clihelper import getBackendID, imasParser
from idstools.utils.idslogger import setupLogger
from idstools.view.common import Canvas
from idstools.view.spectrometer_visible import SpectrometerVisibleView

logger = setupLogger("module", stdout_level=logging.INFO)

parser = argparse.ArgumentParser(
    description="---- Display spectrum from spectrometer_visible", parents=[imasParser]
)
parser.add_argument("-s", "--shot", help="Shot number", required=True, type=int)
parser.add_argument("-r", "--run", help="Run number", required=True, type=int)
parser.add_argument(
    "-t", "--time", help="Time", required=False, type=float, default=-99.0
)
parser.add_argument(
    "--save",
    help="Save figure at default location",
    action="store_true",
)
args = parser.parse_args()

connection = imas.DBEntry(
    getBackendID(args.backend),
    args.database,
    args.shot,
    args.run,
    user_name=args.user,
    data_version=args.version,
)
status, _ = connection.open()
if status != 0:
    logger.critical(
        f"Shot {args.shot}, run {args.run} for user {args.user} and database {args.database} is not reachable ----> abort."
    )
    sys.exit(status)

idsSpectrometerVisible = connection.get("spectrometer_visible")
connection.close()

timeArray = idsSpectrometerVisible.time
timeIndex, timeValue = getNearestTime(timeArray, args.time)

svCompute = SpectrometerVisibleCompute(idsSpectrometerVisible)
spectrometersCount = svCompute.getValidSpectrometers()

svView = SpectrometerVisibleView(idsSpectrometerVisible)

title = f"Spectrum (Radiance) from spectrometer_visible {args.shot}/{args.run}/{timeValue:.2f}"
canvasRadiance = Canvas(1, 3)
canvasRadiance.fig.suptitle(title, size=12)

AxesListRadiance = []
for index, _ in enumerate(spectrometersCount):
    AxesListRadiance.append(
        canvasRadiance.add_axes(title="", xlabel="", row=0, col=index, colspan=1)
    )


radianceFileName = svView.viewRadiance(AxesListRadiance)

if args.save:
    canvasRadiance.save(radianceFileName)
else:
    wm = canvasRadiance.get_current_fig_manager()
    wm.resize(1920, 1080)
    canvasRadiance.show(block=False)

title = f"Spectrum (Intensity) from spectrometer_visible {args.shot}/{args.run}/{timeValue:.2f}"
canvasIntensity = Canvas(1, 3)
canvasIntensity.fig.suptitle(title, size=12)

AxesListIntensity = []
for index, _ in enumerate(spectrometersCount):
    AxesListIntensity.append(
        canvasIntensity.add_axes(title="", xlabel="", row=0, col=index, colspan=1)
    )

intensityFileName = svView.viewIntensity(AxesListIntensity)

if args.save:
    os.path.join("", f"{intensityFileName}_radiance.png")
    canvasIntensity.save(intensityFileName)
else:
    wm = canvasIntensity.get_current_fig_manager()
    wm.resize(1920, 1080)
    canvasIntensity.show()


