#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import argparse
import logging
import copy
import os
from rich_argparse import RichHelpFormatter
from idstools.database import DBMaster
from idstools.machinedescription import MachineDescription
from idstools.set_logger import set_logger
from idstools.utils.clihelper import (
    dbentryParser,
    getDatabasePath,
    getDetailsfromURI,
)
from idstools.utils.idslogger import setupLogger
from idstools.view.common import Canvas
from idstools.view.pf_active import PFActiveView
from idstools.view.wall import WallView

# ----------------------------------------------------------------------


logger = setupLogger("module", stdout_level=logging.INFO)


def plotMachineDescription(idsData, showLabels=False):
    """
    The `plotMachineDescription` method is responsible for plotting the machine description based on the provided pulse list.
    """

    # Initialization
    canvas = Canvas(1, 1)
    ax = canvas.add_axes(title="", xlabel="R (m)", ylabel="Z (m)", row=0, col=0)

    ax.set_aspect("equal", adjustable="box")

    databasePath = ""
    # Plot Overlay
    for idsName, idsDataAndConfig in idsData.items():
        # if idsDataAndConfig["yamlConfig"] is None:
        #     logger.error(f"Could not retrieve machine description for {idsName}")
        #     databasePath += f"{idsName} = not found"
        #     continue
        if idsName == "pf_active":
            pfcoilsview = PFActiveView(idsDataAndConfig["idsData"])
            pfcoilsview.viewActivePfCoils(ax, showLabels=showLabels)
            databasePath += (
                "pf_active = "
                + getDatabasePath(idsDataAndConfig["connectionArgs"])
                + "\n"
            )

        elif idsName == "wall":
            wallview = WallView(idsDataAndConfig["idsData"])
            wallview.view_wall(ax, showLabels=showLabels)
            databasePath += (
                "wall = " + getDatabasePath(idsDataAndConfig["connectionArgs"]) + "\n"
            )
        else:
            databasePath += (
                f"{idsName} = "
                + getDatabasePath(idsDataAndConfig["connectionArgs"])
                + "No visualization yet\n"
            )
            logger.info(
                f"Visualization is not implemented yet for machine description {idsName}"
            )

    # wallview.view_DIR(ax)
    # wallview.view_TS(ax)
    # wallview.view_Cryostat(ax)

    ax.plot()

    canvas.setText(text=databasePath, y=0.95)

    canvas.fig.subplots_adjust(
        top=0.916, bottom=0.09, left=0.044, right=0.953, hspace=0.287, wspace=0.2
    )
    canvas.get_current_fig_manager().set_window_title(os.path.basename(__file__))
    canvas.fig.suptitle("Machine Description", size=12)
    if args.save:
        fname = os.path.basename(__file__) + "_machine_description.png"
        if args.directory:
            if not os.path.exists(args.directory):
                os.makedirs(args.directory)
            fname = os.path.join(args.directory, fname)
        canvas.save(fname)
    else:
        canvas.show()


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="---- View machine description",
        formatter_class=RichHelpFormatter,
        parents=[dbentryParser],
    )
    parser.add_argument(
        "-mdesc",
        "--machine-desc",
        nargs="*",
        default=[],
        help="""Provide machine descriptions that you need to plot 
    with uris for example
    "imas:mdsplus?user=costerd;shot=40866;run=1;database=aug;version=3#wall"
    or just names e.g wall pf_active
    """,
    )
    parser.add_argument(
        "--show-labels",
        help="Save figure at default location",
        action="store_true",
    )
    parser.add_argument(
        "--save",
        help="Save figure at default location",
        action="store_true",
    )
    parser.add_argument(
        "--directory",
        help="Directory to save the figure",
        default=None,
    )
    args = parser.parse_args()
    machineDescription = MachineDescription()
    idsData = {}
    for mdidsInfo in args.machine_desc:
        inputargs = copy.deepcopy(args)
        splittedmsIdsInfo = mdidsInfo.split("#")
        _idsName = ""
        _mdUri = None
        if len(splittedmsIdsInfo) == 2:
            _mdUri, _idsName = splittedmsIdsInfo
            mdargs = argparse.Namespace()
            param = getDetailsfromURI(_mdUri)
            mdargs.backend = param["backend"]
            mdargs.database = param["database"]
            mdargs.pulse = param["pulse"]
            mdargs.run = param["run"]
            mdargs.user = param["user"]
            mdargs.version = param["version"]
            mdargs.uri = _mdUri
            inputargs = mdargs
        if len(splittedmsIdsInfo) == 1:
            _idsName = splittedmsIdsInfo[0]
        connection = DBMaster.getConnection(inputargs)
        idsFound = False
        if connection is not None:
            _idsData = connection.get(_idsName)
            connection.close()
            data = {}
            if _idsData is not None:
                idsFound = True
                (
                    data["idsData"],
                    data["yamlConfig"],
                    data["connectionArgs"],
                ) = (
                    _idsData,
                    None,
                    inputargs,
                )
                idsData[_idsName] = data
        if not idsFound:
            logger.info(
                f"Data entry for {_idsName} is not given, retrieving from ITER machine description"
            )
            idsData[_idsName] = machineDescription.getMDDataByIds(_idsName)

    plotMachineDescription(idsData, args.show_labels)
