    for iset in range(nsubsets):
       if edge_transport.model[0].ggd[0].electrons.energy.flux[iset].grid_subset_index == 26:
          for iFace in range(len(edge_transport.model[0].ggd[0].electrons.energy.flux[iset].values)):
             faceindex = edge_transport.grid_ggd[0].grid_subset[iset].element[iFace].object[0].index
             area = edge_transport.grid_ggd[0].space[0].objects_per_dimension[1].object[faceindex-1].measure
             flux = edge_transport.model[0].ggd[0].electrons.energy.flux[iset].values[iFace]
             p_sol_e = p_sol_e + flux*area
             try:
                flux = edge_transport.model[0].ggd[0].total_ion_energy.flux[iset].values[iFace]
             except:
                flux = 0
                for ispecies in range(nspecies):
                   flux = flux + edge_transport.model[0].ggd[0].ion[ispecies].energy.flux[iset].values[iFace]
             p_sol_i = p_sol_i + flux*area
          p_sol = (p_sol_e + p_sol_i)*1.e-6

